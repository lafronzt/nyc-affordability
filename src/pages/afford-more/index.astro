---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import AppHeader from '../../components/AppHeader.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { CALC_AFFORD_MORE, otherCalculators, ALL_GUIDES, EXPLORE_LINKS, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';
import { ASSUMPTIONS as A } from '../../data/assumptions';

// Price that $100/month of building charges could otherwise carry at the
// default rate and down payment (DTI room spent on charges instead of P&I).
const k = A.mortgageRatePct.value / 1200;
const pmtFactor = k / (1 - Math.pow(1 + k, -A.loanTermYears.value * 12));
const pricePer100 = Math.round(100 / pmtFactor / (1 - A.coopDownPaymentPct.value / 100) / 1000) * 1000;

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: otherCalculators(CALC_AFFORD_MORE.href!) },
  { heading: 'Guides', links: ALL_GUIDES },
  { heading: 'Explore', links: EXPLORE_LINKS },
  STANDARD_ABOUT_COLUMN,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'How Do I Afford More? NYC Buying-Power Levers',
  url: 'https://www.nyc-affordability.com/afford-more/',
  description: 'See which change raises your NYC co-op or condo buying power the most (saving more, paying down debt, a bigger down payment, lower maintenance, or lower rates), and what it would take to reach a target price.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  areaServed: { '@type': 'City', name: 'New York City', sameAs: 'https://www.wikidata.org/wiki/Q60' },
};
---
<BaseLayout
  variant="app"
  ads
  pageTitle="How Do I Afford More? NYC Co-op & Condo Buying-Power Levers | NYC Affordability"
  metaDescription="Which change actually raises your NYC buying power: saving more, paying off debt, earning more, a bigger down payment, lower maintenance, or lower rates? Ranked, with the math behind each."
  canonicalPath="/afford-more/"
  ogTitle="How Do I Afford More in NYC?"
  ogDescription="Rank the changes that raise your NYC co-op or condo buying power, and see what it takes to reach a target price."
  ogImage="/images/general-og.png"
  ogImageAlt="NYC Affordability calculators for rent, co-op, and condo housing."
  twitterTitle="How Do I Afford More in NYC?"
  twitterDescription="Rank the changes that raise your NYC co-op or condo buying power, and see what it takes to reach a target price."
  jsonLd={jsonLd}
>
<AppHeader
  titleHtml="How Do I Afford <em>More</em>?"
  tagline="Find the change that actually raises your NYC buying power, and skip the ones that don't."
  showSaveToggle
/>

<main class="page">
  <section class="hero">
    <div class="eyebrow">Buying-power levers</div>
    <h2>Save more, earn more, or pay down debt? It depends which limit you're hitting.</h2>
    <p>A co-op or condo budget is capped by whichever runs out first: your income (the debt-to-income limit) or your cash (down payment, closing costs, and for co-ops, the board's post-closing reserves). Pull on the wrong one and nothing moves. This ranks every common lever by how much it raises your maximum price, using the same engine as the <a href="/coop/">co-op</a> and <a href="/condo/">condo</a> calculators.</p>
  </section>

  <div class="layout">
    <section class="section-card inputs" aria-labelledby="h-inputs">
      <div class="section-title" id="h-inputs">Your situation</div>
      <div class="editor-body">
        <fieldset class="type-toggle">
          <legend>Buying a</legend>
          <label><input type="radio" name="am-type" value="coop" checked> Co-op</label>
          <label><input type="radio" name="am-type" value="condo"> Condo</label>
        </fieldset>
        <div class="editor-grid">
          <div class="field">
            <label for="am-income">Annual gross income</label>
            <div class="input-wrap"><span>$</span><input type="number" id="am-income" min="0" step="1000" inputmode="numeric"></div>
          </div>
          <div class="field">
            <label for="am-debts">Other monthly debts</label>
            <div class="input-wrap"><span>$</span><input type="number" id="am-debts" min="0" step="50" inputmode="numeric"></div>
            <small>Student loans, car, card minimums</small>
          </div>
          <div class="field">
            <label for="am-cash">Cash savings</label>
            <div class="input-wrap"><span>$</span><input type="number" id="am-cash" min="0" step="1000" inputmode="numeric"></div>
            <small>Checking, savings, HYSA</small>
          </div>
          <div class="field">
            <label for="am-invest">Investments</label>
            <div class="input-wrap"><span>$</span><input type="number" id="am-invest" min="0" step="1000" inputmode="numeric"></div>
            <small>Brokerage; not retirement accounts</small>
          </div>
          <div class="field field-wide">
            <label for="am-target">Target price <span class="optional">(optional)</span></label>
            <div class="input-wrap"><span>$</span><input type="number" id="am-target" min="0" step="10000" inputmode="numeric" placeholder="e.g. 650000"></div>
            <small>See exactly what it would take to get there</small>
          </div>
        </div>

        <details class="assumptions" id="am-assumptions">
          <summary>Assumptions <span class="muted">(defaults from <a href="/methodology/sources/">our sources page</a>)</span></summary>
          <div class="editor-grid">
            <div class="field">
              <label for="am-rate">Mortgage rate</label>
              <div class="input-wrap"><input type="number" id="am-rate" min="0" max="20" step="0.05"><span>%</span></div>
            </div>
            <div class="field">
              <label for="am-dp">Down payment</label>
              <div class="input-wrap"><input type="number" id="am-dp" min="0" max="100" step="1"><span>%</span></div>
            </div>
            <div class="field">
              <label for="am-charges" id="am-charges-label">Monthly maintenance</label>
              <div class="input-wrap"><span>$</span><input type="number" id="am-charges" min="0" step="50"></div>
            </div>
            <div class="field">
              <label for="am-dti" id="am-dti-label">Board DTI limit</label>
              <div class="input-wrap"><input type="number" id="am-dti" min="1" max="100" step="1"><span>%</span></div>
            </div>
            <div class="field coop-only">
              <label for="am-reserves">Post-closing reserves</label>
              <div class="input-wrap"><input type="number" id="am-reserves" min="0" max="60" step="1"><span>mo</span></div>
            </div>
            <div class="field condo-only">
              <label for="am-tax">Monthly property tax</label>
              <div class="input-wrap"><span>$</span><input type="number" id="am-tax" min="0" step="50"></div>
            </div>
            <div class="field condo-only">
              <label for="am-ins">Monthly HO-6 insurance</label>
              <div class="input-wrap"><span>$</span><input type="number" id="am-ins" min="0" step="5"></div>
            </div>
            <div class="field">
              <label for="am-liq">Investments counted toward liquidity</label>
              <div class="input-wrap"><input type="number" id="am-liq" min="0" max="100" step="5"><span>%</span></div>
            </div>
          </div>
          <p class="editor-note">Closing-cost line items use the calculators' defaults. Switching between co-op and condo resets the down payment, building charges, and DTI limit to that type's defaults.</p>
        </details>
        <p class="editor-note">Everything is calculated in your browser. Nothing you enter is sent anywhere.</p>
      </div>
    </section>

    <div class="results" aria-live="polite">
      <section class="section-card summary" aria-labelledby="h-summary">
        <div class="section-title" id="h-summary">Where you stand</div>
        <div class="summary-body">
          <div class="big-label">Maximum <span id="am-type-word">co-op</span> price</div>
          <div class="big-value" id="am-max">&mdash;</div>
          <p class="headline" id="am-headline">&mdash;</p>
          <dl class="ceilings">
            <div><dt>Income allows</dt><dd id="am-dti-max">&mdash;</dd></div>
            <div><dt>Cash allows</dt><dd id="am-cash-max">&mdash;</dd></div>
            <div><dt>Monthly housing cost</dt><dd id="am-monthly">&mdash;</dd></div>
            <div><dt>Total cash needed</dt><dd id="am-total-cash">&mdash;</dd></div>
          </dl>
        </div>
      </section>

      <section class="section-card gap" id="am-gap-card" hidden aria-labelledby="h-gap">
        <div class="section-title" id="h-gap">To reach <span id="am-gap-target">&mdash;</span></div>
        <div class="summary-body" id="am-gap-body"></div>
      </section>
    </div>
  </div>

  <section class="section-card" aria-labelledby="h-levers">
    <div class="section-title" id="h-levers">Biggest levers, ranked</div>
    <div class="table-wrap">
      <table class="levers" aria-describedby="h-levers">
        <thead>
          <tr><th scope="col">#</th><th scope="col">If you&hellip;</th><th scope="col" class="num">New max price</th><th scope="col" class="num">Change</th><th scope="col">Why</th></tr>
        </thead>
        <tbody id="am-levers"></tbody>
      </table>
    </div>
    <details class="no-help" id="am-nohelp-wrap">
      <summary>Won't help right now (<span id="am-nohelp-count">0</span>)</summary>
      <ul id="am-nohelp"></ul>
    </details>
  </section>

  <div class="actions">
    <label class="share-personal"><input type="checkbox" id="am-share-personal"> Include my income, savings, and debts in the link</label>
    <button class="btn-share" id="am-share" type="button">Copy scenario link</button>
    <button class="btn-share" id="am-print" type="button">Print</button>
  </div>

  <section class="section-card" aria-labelledby="h-how">
    <div class="section-title" id="h-how">How this works</div>
    <div class="prose-body">
      <p><strong>Two ceilings, and you get the lower one.</strong> The income ceiling is the most you can borrow while keeping mortgage + building charges + other debts under the DTI limit ({A.coopMaxDtiPct.value}% is the usual co-op board standard; {A.condoMaxDtiPct.value}% for condo lenders). The cash ceiling is the most your savings can cover: down payment, closing costs, mansion tax at $1M+, mortgage recording tax for condos, and for co-ops, {A.coopReserveMonths.value} months of mortgage + maintenance left over after closing. Cash savings count in full; investments count at the percentage you set toward the board's liquidity test.</p>
      <p><strong>Each lever changes exactly one thing</strong> and reruns the same engine the <a href="/coop/">co-op</a> and <a href="/condo/">condo</a> calculators use, so you can reproduce any row there by making that one change. That's why some levers do nothing: if cash is your limit, a raise can't help until savings catch up, and vice versa.</p>
      <p><strong>Lower maintenance is worth more than it looks.</strong> Every $100/month of building charges eats DTI room that could have carried roughly ${pricePer100.toLocaleString('en-US')} of price at the default {A.mortgageRatePct.value}% rate, and for co-ops it also raises the reserves you need. A cheaper apartment with high maintenance can be harder to buy than a pricier one with low charges.</p>
      <p><strong>What this can't see:</strong> your credit score, lender overlays, a specific board's rules, or whether you can actually find a building with lower charges. See <a href="/methodology/">the methodology</a> for what's sourced and what's assumed, and the guides on <a href="/guides/coop-board-reserve-requirements/">co-op reserves</a>, <a href="/guides/income-needed-to-buy-nyc-apartment/">income needed to buy</a>, and <a href="/guides/how-mortgage-rates-affect-nyc-affordability/">how rates move buying power</a>.</p>
    </div>
  </section>
</main>

<AdSlot maxWidth="1300px" sidePadding="20px" />

<Footer
  variant="app"
  disclaimer="This tool is for informational purposes only and does not constitute financial, legal, or mortgage advice. Results use default assumptions and a simplified two-account model; lenders and co-op boards apply their own rules. Verify with a licensed mortgage professional and a real estate attorney."
  columns={footerColumns}
/>
</BaseLayout>

<script>
  import '../../scripts/afford-more';
</script>

<style>
.page { max-width: 1300px; margin: 20px auto; padding: 0 20px 60px; }
.hero {
  background: linear-gradient(135deg, #0a1628 0%, #0f2a54 100%);
  border: 1px solid #1e3a5f; border-radius: var(--r); color: #e2e8f0;
  box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 16px; padding: 26px 24px 22px;
}
.eyebrow { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--gold); margin-bottom: 8px; }
.hero h2 { font-size: clamp(22px, 3.2vw, 32px); line-height: 1.15; letter-spacing: -0.5px; color: #f0f9ff; margin-bottom: 10px; }
.hero p { color: #93b4d0; max-width: 820px; font-size: 14px; line-height: 1.65; }
.hero p a { color: #cfe0fb; }

.layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 16px; align-items: start; }
.section-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.05); margin-bottom: 16px;
}
.section-title {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--g500);
  padding: 12px 18px 11px; border-bottom: 1px solid var(--g100);
}
.editor-body { padding: 16px 18px 18px; }
.editor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-bottom: 12px; }
.field-wide { grid-column: 1 / -1; }
.field label { display: block; font-size: 12px; color: var(--g700); font-weight: 650; margin-bottom: 5px; }
.field small { display: block; font-size: 11px; color: var(--g500); margin-top: 4px; }
.optional { font-weight: 400; color: var(--g500); }
.input-wrap {
  display: flex; align-items: stretch; border: 1px solid var(--g300); border-radius: 5px; background: #fff;
  overflow: hidden; transition: border-color .15s, box-shadow .15s;
}
.input-wrap:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,.12); }
.input-wrap span {
  background: var(--g50); border-right: 1px solid var(--g200); padding: 0 8px; color: var(--g500);
  font-size: 13px; font-weight: 600; display: flex; align-items: center;
}
.input-wrap input + span { border-right: 0; border-left: 1px solid var(--g200); }
.input-wrap input { border: 0; outline: 0; padding: 9px 9px; min-width: 0; width: 100%; font: inherit; color: var(--g900); background: #fff; }
.type-toggle { border: 0; padding: 0; margin: 0 0 14px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.type-toggle legend { font-size: 12px; font-weight: 650; color: var(--g700); margin-right: 4px; float: left; padding-top: 2px; }
.type-toggle label { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 650; color: var(--g800); min-height: 32px; cursor: pointer; }
.assumptions { border-top: 1px solid var(--g100); padding-top: 12px; margin-bottom: 8px; }
.assumptions summary { cursor: pointer; font-size: 13px; font-weight: 700; color: var(--g800); margin-bottom: 12px; min-height: 28px; }
.assumptions .muted { font-weight: 400; color: var(--g500); }
.assumptions a { color: var(--blue); }
.editor-note { font-size: 12px; color: var(--g500); line-height: 1.6; margin-top: 6px; }
:global(body.type-coop) .condo-only, :global(body.type-condo) .coop-only { display: none; }

.summary-body { padding: 18px; }
.big-label { font-size: 12px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: .8px; }
.big-value { font-size: 40px; font-weight: 850; letter-spacing: -1.2px; color: var(--g900); font-variant-numeric: tabular-nums; margin: 4px 0 8px; }
.headline { font-size: 14.5px; color: var(--g700); line-height: 1.6; margin-bottom: 14px; }
.headline :global(strong) { color: var(--g900); }
.ceilings { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; margin: 0; }
.ceilings div { background: var(--g50); border: 1px solid var(--g100); border-radius: 6px; padding: 9px 11px; }
.ceilings dt { font-size: 11px; color: var(--g500); font-weight: 650; }
.ceilings dd { margin: 2px 0 0; font-size: 16px; font-weight: 800; color: var(--g900); font-variant-numeric: tabular-nums; }
.ceilings .binding { border-color: var(--gold); background: #fffbeb; }
.gap :global(p) { font-size: 14px; color: var(--g700); line-height: 1.6; margin-bottom: 8px; }
.gap :global(ul) { padding-left: 18px; margin: 0 0 8px; }
.gap :global(li) { font-size: 14px; color: var(--g700); line-height: 1.6; margin-bottom: 4px; }

.table-wrap { overflow-x: auto; }
.levers { width: 100%; border-collapse: collapse; font-size: 13.5px; }
.levers th { text-align: left; font-size: 10px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: .8px; padding: 11px 14px; border-bottom: 1px solid var(--g100); background: var(--g50); }
.levers :global(td) { padding: 12px 14px; border-bottom: 1px solid var(--g100); color: var(--g800); vertical-align: top; }
.levers :global(.num) { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
.levers :global(.rank) { font-weight: 800; color: var(--g500); width: 28px; }
.levers :global(.lever-label) { font-weight: 700; color: var(--g900); }
.levers :global(.lever-note) { display: block; font-size: 12px; color: var(--g500); margin-top: 3px; line-height: 1.5; }
.levers :global(.up) { color: #15803d; font-weight: 800; }
.levers :global(.down) { color: #b91c1c; font-weight: 800; }
.levers :global(.why) { font-size: 12.5px; color: var(--g600); line-height: 1.5; min-width: 220px; }
.no-help { padding: 12px 18px 14px; border-top: 1px solid var(--g100); }
.no-help summary { cursor: pointer; font-size: 13px; font-weight: 700; color: var(--g700); min-height: 28px; }
.no-help ul { margin: 8px 0 0; padding-left: 18px; }
.no-help :global(li) { font-size: 13px; color: var(--g600); line-height: 1.6; margin-bottom: 4px; }

.actions { display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
.share-personal { font-size: 12.5px; color: var(--g600); display: inline-flex; align-items: center; gap: 6px; min-height: 32px; }
.btn-share {
  border: 1px solid var(--blue-lt); background: #fff; color: var(--blue); border-radius: 6px;
  padding: 10px 20px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; min-height: 40px;
}
.btn-share:hover { background: var(--blue-xlt); }

.prose-body { padding: 16px 18px 18px; }
.prose-body p { font-size: 13.5px; color: var(--g600); line-height: 1.7; margin-bottom: 10px; }
.prose-body p:last-child { margin-bottom: 0; }
.prose-body a { color: var(--blue); text-decoration: none; }
.prose-body a:hover { text-decoration: underline; }

@media (max-width: 960px) {
  .layout { grid-template-columns: 1fr; }
}
@media (max-width: 560px) {
  .page { padding: 0 14px 44px; margin-top: 14px; }
  .hero { padding: 22px 18px 18px; }
  .editor-grid { grid-template-columns: 1fr; }
  .big-value { font-size: 32px; }
  .ceilings { grid-template-columns: 1fr; }
  .levers thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .levers, .levers tbody, .levers :global(tr), .levers :global(td) { display: block; width: 100%; }
  .levers :global(tr) { border-bottom: 1px solid var(--g100); padding: 10px 0; }
  .levers :global(td) { border: 0; padding: 3px 14px; text-align: left !important; }
  .levers :global(td.rank) { display: none; }
}
@media print {
  :global(header), :global(footer), :global(.page-tagline), .actions, .hero, :global(.navlinks), :global(.navbar-toggle) { display: none !important; }
  .page { margin: 0; padding: 0; max-width: none; }
  .layout { grid-template-columns: 1fr 1fr; }
  .section-card { box-shadow: none; break-inside: avoid; }
  details { display: block; }
  details > summary { list-style: none; }
}
</style>
