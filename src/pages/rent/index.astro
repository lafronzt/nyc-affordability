---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { CALC_RENT, otherCalculators, ALL_GUIDES, NYC_HPD_TENANT_RIGHTS_LINK, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';

const footerColumns: FooterColumn[] = [
  { heading: 'More Calculators', links: otherCalculators(CALC_RENT.href!) },
  { heading: 'Guides', links: ALL_GUIDES },
  {
    heading: 'NYC Renter Resources',
    links: [
      { label: 'StreetEasy', href: 'https://streeteasy.com' },
      NYC_HPD_TENANT_RIGHTS_LINK,
      { label: 'FARE Act FAQ', href: 'https://www.nyc.gov/site/dca/about/FAQ-Broker-Fees.page' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'HSTPA Security Deposit Law', href: 'https://www.nysenate.gov/legislation/laws/RPP/227-G' },
      { label: 'For informational purposes only' },
    ],
  },
  STANDARD_ABOUT_COLUMN,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NYC Apartment Rent Affordability Calculator',
  url: 'https://www.nyc-affordability.com/rent/',
  description: 'Find your maximum affordable NYC apartment rent with a rental housing affordability calculator that covers income screening, FARE Act broker fee rules, and move-in cash requirements.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  areaServed: { '@type': 'City', name: 'New York City', sameAs: 'https://www.wikidata.org/wiki/Q60' },
};
---
<BaseLayout
  variant="app"
  ads
  pageTitle="NYC Rent Affordability Calculator | Calculate Your Max Affordable Rent"
  metaDescription="Free NYC housing affordability calculator for apartment rentals. Estimate how much rent you can afford from income, assets, the 40× rule, and move-in cash."
  canonicalPath="/rent/"
  ogTitle="NYC Rent Affordability Finder | Calculate Your Max Affordable Rent"
  ogDescription="Free NYC housing affordability calculator for apartment rentals. Find your max affordable monthly rent from your financial profile — covering income screening and move-in cash."
  ogImage="/images/rent-og.png"
  ogImageAlt="Can you afford NYC rent? NYC Rent Affordability Calculator from NYC Affordability."
  twitterTitle="NYC Rent Affordability Finder"
  twitterDescription="Free NYC housing affordability calculator for apartment rentals. Reverse-engineer your max affordable monthly rent from income, assets, and move-in assumptions."
  jsonLd={jsonLd}
>
<AppHeader titleHtml="NYC <em>Rent</em> Affordability Finder" tagline="Instantly calculate your maximum affordable monthly rent from income, assets, and NYC move-in costs." />

<main class="app-layout">

  <!-- ===== INPUTS PANEL ===== -->
  <div class="inputs-panel">

    <!-- Card 1: Account Balances -->
    <div class="card">
      <div class="card-title" id="card-title-1" aria-expanded="true" aria-controls="card-body-1">
        <span class="snum">1</span> Account Balances
        <span class="card-chev" aria-hidden="true">▲</span>
      </div>
      <div class="card-body" id="card-body-1">
        <div class="acct-wrap">
          <table class="acct-tbl" aria-label="Account balances">
            <thead>
              <tr>
                <th>Account</th>
                <th class="r">Balance ($)</th>
                <th class="r">Liquidity %</th>
                <th class="r">Move-In <span class="th-note">(weighted)</span></th>
                <th class="r">Reserve</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="acct-tbody"></tbody>
          </table>
        </div>
        <button class="btn-add-row" id="btn-add-acct" type="button">+ Add Account</button>
        <div class="acct-totals">
          <div>
            <div class="tot-lbl">Move-In Available</div>
            <div class="tot-val primary" id="tot-liquid">$0</div>
          </div>
          <div>
            <div class="tot-lbl">Reserve Available</div>
            <div class="tot-val" id="tot-reserve">$0</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Income -->
    <div class="card">
      <div class="card-title" id="card-title-2" aria-expanded="true" aria-controls="card-body-2">
        <span class="snum">2</span> Income
        <span class="card-chev" aria-hidden="true">▲</span>
      </div>
      <div class="card-body" id="card-body-2">
        <div class="form-row">
          <label class="lbl" for="annual-income">Annual gross income<small>Pre-tax, all sources</small></label>
          <div class="iw"><span class="px">$</span><input type="number" id="annual-income" class="w120" min="0" step="1000" value="75000"></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="monthly-income">Monthly gross income<small>Calculated automatically</small></label>
          <div class="iw"><span class="px">$</span><input type="number" id="monthly-income" class="w120 ro" readonly tabindex="-1"></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="other-debts">Other monthly debts<small>Car, student loans, credit cards, etc.</small></label>
          <div class="iw"><span class="px">$</span><input type="number" id="other-debts" class="w120" min="0" step="50" value="0"></div>
        </div>
      </div>
    </div>

    <!-- Card 3: Income Screening -->
    <div class="card">
      <div class="card-title" id="card-title-3" aria-expanded="true" aria-controls="card-body-3">
        <span class="snum">3</span> Income Screening
        <span class="card-chev" aria-hidden="true">▲</span>
      </div>
      <div class="card-body" id="card-body-3">
        <div class="form-row">
          <label class="lbl" for="income-mult">Income multiplier (× rule)<small>Landlords typically require 40× monthly rent</small></label>
          <div class="iw"><input type="number" id="income-mult" class="w60" min="20" max="80" step="1" value="40"><span class="sx">×</span></div>
        </div>
        <label class="toggle-row">
          <input type="checkbox" id="dti-enabled">
          Enable debt-to-income screening <small>(common for larger buildings)</small>
        </label>
        <div class="form-row" id="dti-row" hidden>
          <label class="lbl" for="dti-pct">Max rent-to-income ratio<small>30–35% is standard for DTI screening</small></label>
          <div class="iw"><input type="number" id="dti-pct" class="w60" min="10" max="60" step="1" value="35"><span class="sx">%</span></div>
        </div>
        <label class="toggle-row">
          <input type="checkbox" id="guarantor-enabled">
          I have / plan to use a guarantor <small>(co-signer)</small>
        </label>
        <div class="form-row" id="guarantor-row" hidden>
          <label class="lbl" for="guarantor-mult">Guarantor income multiplier<small>NYC guarantors typically need 80× monthly rent — the Afford Target tab will show the exact income your guarantor must earn</small></label>
          <div class="iw"><input type="number" id="guarantor-mult" class="w60" min="20" max="120" step="1" value="80"><span class="sx">×</span></div>
        </div>
      </div>
    </div>

    <!-- Card 4: Move-In Costs -->
    <div class="card">
      <div class="card-title" id="card-title-4" aria-expanded="true" aria-controls="card-body-4">
        <span class="snum">4</span> Move-In Costs
        <span class="card-chev" aria-hidden="true">▲</span>
      </div>
      <div class="card-body" id="card-body-4">
        <div class="form-row">
          <label class="lbl" for="sec-deposit">Security deposit<small>NYC law limits security deposit to 1 month's rent</small></label>
          <div class="iw"><select id="sec-deposit" class="w120">
            <option value="0">None</option>
            <option value="0.5">Half month</option>
            <option value="1" selected>1 month</option>
          </select></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="app-fee">Application fee<small>NYC cap: $20 (HSTPA 2019)</small></label>
          <div class="iw"><span class="px">$</span><input type="number" id="app-fee" class="w100" min="0" step="5" value="20"></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="building-fee">Building/admin fee<small>Move-in, key deposit, elevator, etc.</small></label>
          <div class="iw"><span class="px">$</span><input type="number" id="building-fee" class="w100" min="0" step="50" value="500"></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="utility-setup">Utility setup<small>Con Ed deposit, internet install, etc.</small></label>
          <div class="iw"><span class="px">$</span><input type="number" id="utility-setup" class="w100" min="0" step="50" value="250"></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="pet-fee">Pet deposit / fee<small>One-time; leave $0 if no pets</small></label>
          <div class="iw"><span class="px">$</span><input type="number" id="pet-fee" class="w100" min="0" step="50" value="0"></div>
        </div>
      </div>
    </div>

    <!-- Card 5: Broker Fees -->
    <div class="card">
      <div class="card-title" id="card-title-5" aria-expanded="true" aria-controls="card-body-5">
        <span class="snum">5</span> Broker Fees
        <span class="card-chev" aria-hidden="true">▲</span>
      </div>
      <div class="card-body" id="card-body-5">
        <div class="broker-note">
          <strong>FARE Act (effective June 11, 2025):</strong> NYC prohibits landlord/listing agents from charging broker fees to tenants.
          If the landlord's agent listed the apartment, you pay no broker fee. You may still choose to hire and pay your own tenant's broker.
          <a href="https://www.nyc.gov/site/dca/about/FAQ-Broker-Fees.page" target="_blank" rel="noopener noreferrer">NYC DCWP FAQ ↗</a>
        </div>
        <div class="form-row">
          <label class="lbl" for="broker-type">Broker fee type</label>
          <div class="iw"><select id="broker-type" class="w160">
            <option value="none" selected>No broker fee</option>
            <option value="pct_annual">% of annual rent</option>
            <option value="months">× months of rent</option>
            <option value="flat">Flat fee ($)</option>
          </select></div>
        </div>
        <div class="form-row" id="broker-pct-row" hidden>
          <label class="lbl" for="broker-pct">Broker fee %<small>Standard NYC rate is ~15% of annual rent (≈1.8 months)</small></label>
          <div class="iw"><input type="number" id="broker-pct" class="w60" min="0" max="100" step="1" value="15"><span class="sx">%</span></div>
        </div>
        <div class="form-row" id="broker-months-row" hidden>
          <label class="lbl" for="broker-months-val">Broker fee (months of rent)</label>
          <div class="iw"><input type="number" id="broker-months-val" class="w60" min="0" max="6" step="0.5" value="1"><span class="sx">mo</span></div>
        </div>
        <div class="form-row" id="broker-flat-row" hidden>
          <label class="lbl" for="broker-flat-val">Flat broker fee</label>
          <div class="iw"><span class="px">$</span><input type="number" id="broker-flat-val" class="w120" min="0" step="100" value="3000"></div>
        </div>
      </div>
    </div>

    <!-- Card 6: Monthly & Reserves -->
    <div class="card">
      <div class="card-title" id="card-title-6" aria-expanded="true" aria-controls="card-body-6">
        <span class="snum">6</span> Monthly &amp; Reserves
        <span class="card-chev" aria-hidden="true">▲</span>
      </div>
      <div class="card-body" id="card-body-6">
        <div class="form-row">
          <label class="lbl" for="renters-insurance">Renters insurance<small>Monthly; NYC average ~$15–25/mo</small></label>
          <div class="iw"><span class="px">$</span><input type="number" id="renters-insurance" class="w100" min="0" step="1" value="15"><span class="sx">/mo</span></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="reserve-months">Reserve buffer<small>Months of total housing costs kept in savings</small></label>
          <div class="iw"><select id="reserve-months" class="w120">
            <option value="0">None</option>
            <option value="1">1 month</option>
            <option value="2" selected>2 months</option>
            <option value="3">3 months</option>
            <option value="6">6 months</option>
          </select></div>
        </div>
      </div>
    </div>

  </div><!-- /inputs-panel -->

  <!-- ===== RESULTS PANEL ===== -->
  <div class="results-panel">
    <div class="results-tabs" role="tablist" aria-label="Results views">
      <button class="tab-btn active" id="tab-standard" role="tab" aria-selected="true" aria-controls="view-standard" tabindex="0" data-tab="standard">Standard</button>
      <button class="tab-btn" id="tab-analysis" role="tab" aria-selected="false" aria-controls="view-analysis" tabindex="-1" data-tab="analysis">Analysis</button>
      <button class="tab-btn" id="tab-afford" role="tab" aria-selected="false" aria-controls="view-afford" tabindex="-1" data-tab="afford">🎯 Afford Target</button>
    </div>

    <div class="results-card" id="view-standard" role="tabpanel" aria-labelledby="tab-standard">

      <!-- Hero -->
      <div class="hero">
        <div class="hero-eyebrow">Max Affordable Rent</div>
        <div class="hero-price" id="hero-price">$—</div>
        <span class="hero-mo">per month</span>
        <div style="margin-top:8px">
          <span class="hero-binding" id="hero-binding">
            Limiting factor: <span class="binding-val" id="hero-binding-val">—</span>
          </span>
        </div>
        <div class="hero-warn" id="hero-warn" role="alert" aria-live="polite"></div>
        <button class="btn-share" id="rent-share" type="button">Share your result</button>
      </div>

      <div class="results-body">
        <!-- ── Standard Tab ── -->

          <!-- Target rent row -->
          <div class="target-row">
            <span class="tgt-lbl">Target Rent:</span>
            <div class="tgt-wrap">
              <span class="px">$</span>
              <input type="number" id="target-rent" min="0" step="50" placeholder="Max">
            </div>
            <button class="btn-reset" id="btn-reset-tgt" type="button">Reset to max</button>
          </div>

          <!-- Borough presets -->
          <div class="presets-row">
            <span class="presets-lbl">Median rents:</span>
            <button class="btn-preset" data-preset="3995" type="button">🏙 Citywide $3,995</button>
            <button class="btn-preset" data-preset="4750" type="button">🗽 Manhattan $4,750</button>
            <button class="btn-preset" data-preset="3750" type="button">🌉 Brooklyn $3,750</button>
            <button class="btn-preset" data-preset="3100" type="button">🚇 Queens $3,100</button>
          </div>

          <!-- Move-in signing costs -->
          <div class="snap-block">
            <div class="snap-title">At Signing — Move-In Costs</div>
            <div class="snap-row"><span class="sr-lbl">First month's rent</span><span class="sr-val" id="s-first-month">—</span></div>
            <div class="snap-row"><span class="sr-lbl">Security deposit</span><span class="sr-val" id="s-sec-deposit">—</span></div>
            <div class="snap-row"><span class="sr-lbl">Broker fee</span><span class="sr-val" id="s-broker-fee">—</span></div>
            <div class="snap-row indent"><span class="sr-lbl">Application fee</span><span class="sr-val" id="s-app-fee">—</span></div>
            <div class="snap-row indent"><span class="sr-lbl">Building/admin fee</span><span class="sr-val" id="s-building-fee">—</span></div>
            <div class="snap-row indent"><span class="sr-lbl">Utility setup</span><span class="sr-val" id="s-utility-setup">—</span></div>
            <div class="snap-row indent"><span class="sr-lbl">Pet deposit</span><span class="sr-val" id="s-pet-fee">—</span></div>
            <div class="snap-row subtot"><span class="sr-lbl">Total at signing</span><span class="sr-val" id="s-total-signing">—</span></div>
            <div class="snap-row avail"><span class="sr-lbl">Move-in available (weighted)</span><span class="sr-val" id="s-movein-avail">—</span></div>
            <div class="snap-row"><span class="sr-lbl">Surplus / (Shortfall)</span><span class="sr-val" id="s-movein-surplus">—</span></div>
          </div>

          <hr class="snap-div">

          <!-- Reserve buffer -->
          <div class="snap-block">
            <div class="snap-title">Reserve Buffer</div>
            <div class="snap-row"><span class="sr-lbl">Reserve buffer (<span id="s-reserve-months-lbl">2</span> months)</span><span class="sr-val" id="s-reserve-buffer">—</span></div>
            <div class="snap-row subtot"><span class="sr-lbl">Total cash needed</span><span class="sr-val" id="s-total-cash">—</span></div>
            <div class="snap-row avail"><span class="sr-lbl">Reserve available</span><span class="sr-val" id="s-reserve-avail">—</span></div>
            <div class="snap-row"><span class="sr-lbl">Surplus / (Shortfall)</span><span class="sr-val" id="s-reserve-surplus">—</span></div>
          </div>

          <hr class="snap-div">

          <!-- Monthly obligations -->
          <div class="snap-block">
            <div class="snap-title">Monthly Obligations</div>
            <div class="snap-row"><span class="sr-lbl">Monthly rent</span><span class="sr-val" id="s-monthly-rent">—</span></div>
            <div class="snap-row indent"><span class="sr-lbl">Renters insurance</span><span class="sr-val" id="s-renters-ins">—</span></div>
            <div class="snap-row indent"><span class="sr-lbl">Other debts</span><span class="sr-val" id="s-other-debts-mo">—</span></div>
            <div class="snap-row subtot"><span class="sr-lbl">Total monthly</span><span class="sr-val" id="s-monthly-total">—</span></div>
            <div class="snap-row"><span class="sr-lbl">Rent-to-income ratio</span><span class="sr-val" id="s-rent-burden">—</span></div>
            <div class="snap-row"><span class="sr-lbl">Total DTI (all debts)</span><span class="sr-val" id="s-total-dti">—</span></div>
          </div>

          <hr class="snap-div">

          <!-- Feasibility pills -->
          <div class="feas-title">Qualification Check</div>
          <div class="feas-wrap">
            <div class="pill" id="pill-cash">
              <span class="p-icon">✓</span>
              <span class="p-name">Cash</span>
              <span class="p-detail" id="pd-cash">—</span>
            </div>
            <div class="pill" id="pill-mult">
              <span class="p-icon">✓</span>
              <span class="p-name">Income (×)</span>
              <span class="p-detail" id="pd-mult">—</span>
            </div>
            <div class="pill" id="pill-dti">
              <span class="p-icon">✓</span>
              <span class="p-name">Income (DTI)</span>
              <span class="p-detail" id="pd-dti">—</span>
            </div>
          </div>

      </div><!-- /results-body -->
    </div><!-- /results-card view-standard -->

    <!-- ── Analysis Tab ── -->
    <div class="results-card" id="view-analysis" role="tabpanel" aria-labelledby="tab-analysis" hidden>
      <div class="results-body">

          <!-- Mini hero -->
          <div class="anl-hero">
            <div class="anl-hero-col">
              <div class="anl-eyebrow">Income Limit</div>
              <div class="anl-price" id="anl-income-max">$—</div>
              <div class="anl-sub">max from income rules</div>
            </div>
            <div class="anl-hero-col border-l">
              <div class="anl-eyebrow">Cash Limit</div>
              <div class="anl-price" id="anl-cash-max">$—</div>
              <div class="anl-sub">binding: <strong id="anl-binding">—</strong></div>
            </div>
          </div>

          <!-- Broker fee scenarios -->
          <div class="anl-section-title">Broker Fee Impact on Move-In Budget</div>
          <table class="scen-tbl" id="broker-scen-tbl" aria-label="Broker fee scenarios">
            <thead><tr>
              <th>Broker Scenario</th>
              <th>Fee</th>
              <th>Cash Max Rent</th>
            </tr></thead>
            <tbody id="broker-scen-tbody"></tbody>
          </table>

          <!-- Reserve buffer scenarios -->
          <div class="anl-section-title">Reserve Buffer vs. Max Rent</div>
          <table class="scen-tbl" id="reserve-scen-tbl" aria-label="Reserve scenarios">
            <thead><tr>
              <th>Reserve Buffer</th>
              <th>Cash Needed</th>
              <th>Cash Max Rent</th>
            </tr></thead>
            <tbody id="reserve-scen-tbody"></tbody>
          </table>

          <!-- Income multiplier sensitivity -->
          <div class="anl-section-title">Income Multiplier Sensitivity</div>
          <table class="scen-tbl" id="mult-scen-tbl" aria-label="Multiplier sensitivity">
            <thead><tr>
              <th>Multiplier</th>
              <th>Income Max Rent</th>
              <th>vs. Current</th>
            </tr></thead>
            <tbody id="mult-scen-tbody"></tbody>
          </table>

          <!-- DTI sensitivity (shown only if DTI enabled) -->
          <div id="dti-scen-section" hidden>
            <div class="anl-section-title">DTI Ratio Sensitivity</div>
            <table class="scen-tbl" aria-label="DTI sensitivity">
              <thead><tr>
                <th>DTI Ratio</th>
                <th>DTI Max Rent</th>
                <th>vs. Current</th>
              </tr></thead>
              <tbody id="dti-scen-tbody"></tbody>
            </table>
          </div>

      </div><!-- /results-body -->
    </div><!-- /results-card view-analysis -->

    <!-- ── Afford Target Tab ── -->
    <div class="results-card" id="view-afford" role="tabpanel" aria-labelledby="tab-afford" hidden>
      <div class="results-body">

          <!-- Target bar -->
          <div class="aft-tgt-bar">
            <span class="aft-lbl">Target Rent:</span>
            <div class="aft-tgt-wrap">
              <span class="px">$</span>
              <input type="number" id="aft-target-rent" min="0" step="50" placeholder="e.g. 3500">
            </div>
            <button class="btn-reset" id="btn-aft-reset" type="button">Reset to max</button>
          </div>

          <!-- Prompt when no target -->
          <div class="aft-prompt" id="aft-prompt">
            <strong>Enter a target rent above</strong>
            Type the rent you want to qualify for and we'll show exactly what income or savings you need.
          </div>

          <!-- Success banner -->
          <div class="aft-success" id="aft-success" hidden>
            <div class="aft-ok-icon" id="aft-ok-icon">✅</div>
            <div class="aft-success-title" id="aft-success-title">You qualify!</div>
            <div class="aft-success-sub" id="aft-success-sub"></div>
          </div>

          <!-- Analysis section -->
          <div id="aft-analysis" hidden>

            <!-- 3-col summary -->
            <div class="aft-summary">
              <div>
                <div class="aft-sum-lbl">Target</div>
                <div class="aft-sum-val" id="aft-sum-target">—</div>
              </div>
              <div>
                <div class="aft-sum-lbl">Your Max</div>
                <div class="aft-sum-val" id="aft-sum-max">—</div>
              </div>
              <div>
                <div class="aft-sum-lbl">Gap</div>
                <div class="aft-sum-val neg" id="aft-sum-gap">—</div>
              </div>
            </div>

            <!-- Lever grid -->
            <div class="aft-section-title">What It Would Take</div>
            <div class="lever-grid">

              <!-- Income lever -->
              <div class="lever">
                <div class="lever-hd">
                  💰 Income
                  <span class="lbadge" id="lev-inc-badge">—</span>
                </div>
                <div class="lever-big" id="lev-inc-big">—</div>
                <div class="lever-sub" id="lev-inc-sub">—</div>
              </div>

              <!-- Cash lever -->
              <div class="lever">
