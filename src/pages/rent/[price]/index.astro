---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Footer from '../../../components/Footer.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedBudgets from '../../../components/RelatedBudgets.astro';
import MiniCalcWidget from '../../../components/MiniCalcWidget.astro';
import type { FooterColumn } from '../../../lib/footerLinks';
import { ALL_CALCULATORS, ALL_GUIDES, STANDARD_ABOUT_COLUMN, EXPLORE_LINKS } from '../../../lib/footerLinks';
import { AD_IN_ARTICLE } from '../../../lib/adSlots';
import { buildBreadcrumbJsonLd } from '../../../lib/breadcrumbs';
import { fmtMoney } from '../../../lib/format';
import { requiredIncomeForRent, maxAffordablePrice, DEFAULT_ASSUMPTIONS } from '../../../lib/afford';
import { nearest } from '../../../lib/relatedPages';
import { RENT_PRICES as PRICES, INCOME_AMOUNTS, BUY_PRICES } from '../../../data/priceGrids';

export function getStaticPaths() {
  return PRICES.map((price) => ({
    params: { price: String(price) },
    props: { price },
  }));
}

const { price } = Astro.props;
const standard = requiredIncomeForRent({ targetRent: price });
const guarantorMultiplier = 80;
const guarantor = requiredIncomeForRent({ targetRent: price, incomeMultiplier: guarantorMultiplier });

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: ALL_CALCULATORS },
  { heading: 'Guides', links: ALL_GUIDES },
  { heading: 'Explore', links: EXPLORE_LINKS },
  STANDARD_ABOUT_COLUMN,
];

const canonicalPath = `/rent/${price}/`;
const priceLabel = fmtMoney(price);
const pageTitle = `${priceLabel} Rent in NYC: Salary Needed & 40x Rule | NYC Affordability`;
const metaDescription = `The annual income typically needed to rent a ${priceLabel}/month NYC apartment under the 40x rule, plus the guarantor income requirement, calculated using our calculators' default assumptions.`;

const SITE_ORIGIN = 'https://www.nyc-affordability.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${priceLabel} rent in NYC: salary needed`,
  description: metaDescription,
  url: `${SITE_ORIGIN}${canonicalPath}`,
  isPartOf: { '@type': 'WebSite', name: 'NYC Affordability', url: `${SITE_ORIGIN}/` },
};
const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Renting', path: '/rent/prices/' },
  { name: priceLabel, path: canonicalPath },
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
const otherPrices = PRICES.filter((p) => p !== price);

// Condo is used as the canonical basis for the buy-equivalent link, matching
// the same convention used on the income and buy pages.
const relatedIncome = nearest(standard.annualIncomeNeeded, INCOME_AMOUNTS);
const relatedBuyPrice = nearest(
  maxAffordablePrice({ annualIncome: standard.annualIncomeNeeded, propertyType: 'condo' }).maxPrice,
  BUY_PRICES
);
---
<BaseLayout
  variant="site"
  ads
  pageTitle={pageTitle}
  metaDescription={metaDescription}
  canonicalPath={canonicalPath}
  ogTitle={`${priceLabel} rent in NYC: salary needed`}
  ogDescription={metaDescription}
  ogImage="/images/general-og.png"
  ogImageAlt={`Salary needed to rent a ${priceLabel} NYC apartment.`}
  twitterTitle={`${priceLabel} rent in NYC`}
  twitterDescription={metaDescription}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
<SiteHeader />

<main>
<div class="hero">
  <div class="hero-eyebrow">Renting</div>
  <h2>What income do you need for {priceLabel} rent?</h2>
  <p>The annual income a NYC landlord typically wants to see for a {priceLabel}/month apartment — calculated using this site's own affordability engine, not a rule of thumb.</p>
</div>

<div class="page">
  <Breadcrumbs items={breadcrumbItems} />

  <div class="calc-note card">
    <p><strong>This is the 40&times; rule income screening threshold only</strong> — the market convention most NYC landlords and management companies apply, not a legal requirement or a check against your real savings or debts. It doesn't include move-in cash (first month, security deposit, broker fee) or NYC's FARE Act broker-fee rules. Open the <a href="/rent/">Rent Calculator</a> for the full picture, including move-in costs and a guarantor lever.</p>
  </div>

  <div class="result-grid">
    <div class="result-card">
      <div class="result-label">Income needed (40&times; rule)</div>
      <div class="result-value"><span id="result-standard-income" aria-live="polite">{fmtMoney(standard.annualIncomeNeeded)}</span><span class="result-unit">/yr</span></div>
      <div class="result-binding">{DEFAULT_ASSUMPTIONS.rentIncomeMultiplier}&times; monthly rent</div>
      <a class="result-link" href="/rent/">Open Rent Calculator &rarr;</a>
    </div>
    <div class="result-card">
      <div class="result-label">Guarantor income needed</div>
      <div class="result-value"><span id="result-guarantor-income" aria-live="polite">{fmtMoney(guarantor.annualIncomeNeeded)}</span><span class="result-unit">/yr</span></div>
      <div class="result-binding">{guarantorMultiplier}&times; monthly rent</div>
      <a class="result-link" href="/guides/nyc-40x-rent-rule/">Read the 40x rule guide &rarr;</a>
    </div>
  </div>

  <MiniCalcWidget mode="rent-price" defaultValue={price} />

  <div style="margin-bottom:20px;">
    <AdSlot slot={AD_IN_ARTICLE} format="in-article" maxWidth="100%" sidePadding="0" />
  </div>

  <RelatedBudgets
    heading="This budget, from a different angle"
    items={[
      { label: `${fmtMoney(relatedIncome)}/yr income`, sublabel: 'See what that income affords', href: `/income/${relatedIncome}/` },
      { label: `${fmtMoney(relatedBuyPrice)} purchase`, sublabel: 'The equivalent buying budget', href: `/buy/${relatedBuyPrice}/` },
    ]}
  />

  <div class="card">
    <h3>See a different rent</h3>
    <div class="chip-row">
      {otherPrices.map((p) => (
        <a class="chip" href={`/rent/${p}/`}>{fmtMoney(p)}</a>
      ))}
    </div>
    <p class="custom-note">Have a different target rent? <a href="/rent/">Open the Rent Calculator</a> to enter any amount and check your own income against it.</p>
  </div>

</div>
</main>

<Footer
  variant="site"
  disclaimer="These figures are calculated using default assumptions (the 40x/80x income multiplier conventions) and do not reflect your actual accounts, debts, or a specific landlord's screening criteria. They are for informational purposes only and do not constitute financial or legal advice."
  columns={footerColumns}
/>
</BaseLayout>

<style>
.hero {
  background: linear-gradient(160deg, var(--navy) 0%, #0d1f3c 55%, #142240 100%);
  padding: 52px 24px 44px; text-align: center; color: #e2e8f0;
}
.hero-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
.hero h2 { font-size: clamp(26px, 4.5vw, 40px); font-weight: 800; letter-spacing: -1px; line-height: 1.15; margin-bottom: 14px; color: #f0f9ff; }
.hero p { font-size: 15px; color: #93b4d0; max-width: 640px; margin: 0 auto; line-height: 1.7; }

.page { max-width: 860px; margin: 0 auto; padding: 44px 24px 64px; flex: 1; }

.calc-note { background: var(--blue-xlt, #eef4ff); border: 1px solid var(--blue-lt, #cfe0fb); }
.calc-note p { font-size: 13px; color: var(--g700); line-height: 1.6; margin: 0; }

.card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 24px 26px 26px; margin-bottom: 20px; overflow-x: auto;
}
.card h3 { font-size: 17px; font-weight: 800; color: var(--g900); margin-bottom: 10px; letter-spacing: -.2px; }
.card p { font-size: 14px; color: var(--g600); line-height: 1.7; margin-bottom: 10px; }
.card a { color: var(--blue); text-decoration: none; }
.card a:hover { text-decoration: underline; }

.result-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 20px; }
.result-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 20px 18px 18px; text-align: center;
}
.result-label { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: var(--g500); margin-bottom: 8px; }
.result-value { font-size: 26px; font-weight: 800; color: var(--g900); letter-spacing: -.5px; }
.result-unit { font-size: 14px; font-weight: 600; color: var(--g500); }
.result-binding { font-size: 12px; color: var(--g500); margin: 6px 0 12px; }
.result-link { font-size: 12.5px; font-weight: 700; }

.chip-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
.chip {
  display: inline-block; padding: 7px 14px; border: 1px solid var(--border); border-radius: 999px;
  font-size: 13px; font-weight: 650; color: var(--g800); background: var(--g50); text-decoration: none;
}
.chip:hover { border-color: var(--blue-lt); background: var(--blue-lt); color: var(--blue); text-decoration: none; }
.custom-note { font-size: 13px; margin-top: 4px; }

@media (max-width: 640px) {
  .result-grid { grid-template-columns: 1fr; }
}
@media (max-width: 560px) {
  .card { padding: 20px 18px 22px; }
}
</style>
