---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { CALC_CONDO, otherCalculators, ALL_GUIDES, CFPB_OWNING_HOME_LINK, MANSION_TAX_GUIDE_LINK, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';

const footerColumns: FooterColumn[] = [
  { heading: 'Guides', links: ALL_GUIDES },
  {
    heading: 'NYC Housing Resources',
    links: [
      { label: 'NYC DOF: Real Property Transfer Tax', href: 'https://www.nyc.gov/site/finance/taxes/property-real-property-transfer-tax-rptt.page' },
      MANSION_TAX_GUIDE_LINK,
      { label: 'ACRIS (NYC Mortgage Recording)', href: 'https://www.nyc.gov/site/finance/property/acris.page' },
    ],
  },
  {
    heading: 'Mortgage & Financing',
    links: [
      CFPB_OWNING_HOME_LINK,
      { label: 'Verify Your Mortgage Broker (NMLS)', href: 'https://www.nmlsconsumeraccess.org/' },
      { label: 'Freddie Mac PMMS (Current Rates)', href: 'https://www.freddiemac.com/pmms' },
      { label: 'CFPB: When Can I Cancel PMI?', href: 'https://www.consumerfinance.gov/ask-cfpb/when-can-i-stop-paying-private-mortgage-insurance-pmi-en-202/' },
    ],
  },
  {
    heading: 'Find an Attorney',
    links: [{ label: 'NYC Bar Lawyer Referral', href: 'https://www.nycbar.org/lawyer-referral-service' }],
  },
  { heading: 'More NYC Calculators', links: otherCalculators(CALC_CONDO.href!) },
  STANDARD_ABOUT_COLUMN,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NYC Condo Home Affordability Calculator',
  url: 'https://www.nyc-affordability.com/condo/',
  description: 'A free NYC condo housing, home, and apartment affordability calculator that reverse-engineers your maximum purchase price from your financial profile, covering down payment, closing costs, mansion tax, mortgage recording tax, and lender DTI limits.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  areaServed: { '@type': 'City', name: 'New York City', sameAs: 'https://www.wikidata.org/wiki/Q60' },
};
---
<BaseLayout
  variant="app"
  ads
  pageTitle="NYC Condo Affordability Calculator | Calculate Your Max Purchase Price"
  metaDescription="Free NYC housing affordability calculator for condos. Estimate how much home or apartment you can afford from income, assets, mansion tax, DTI, and costs."
  canonicalPath="/condo/"
  ogTitle="NYC Condo Affordability Calculator | Calculate Your Max Purchase Price"
  ogDescription="Free NYC housing affordability calculator for condos. Find your max purchase price from your financial profile — covering down payment, closing costs, mansion tax, and DTI."
  ogImage="/images/condo-og.png"
  ogImageAlt="Can you afford a NYC condo? NYC Condo Affordability Calculator from NYC Affordability."
  twitterTitle="NYC Condo Affordability Calculator"
  twitterDescription="Free NYC housing affordability calculator for condos. Reverse-engineer your max purchase price from income, assets, and mortgage assumptions."
  jsonLd={jsonLd}
>
<AppHeader titleHtml="NYC <em>Condo</em> Affordability Calculator" tagline="Reverse-engineer your max purchase price from your financial profile" />

<main class="app-layout">

  <!-- ═══════════════════════════════════════ LEFT — INPUTS ═══════════════════════════════════════ -->
  <div class="inputs-panel">

    <!-- 1 · Account Balances -->
    <div class="card">
      <div class="card-title" id="card-title-1" aria-expanded="true" aria-controls="card-body-1"><span class="snum">1</span> Account Balances<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-1">
        <div class="acct-wrap">
          <table class="acct-tbl">
            <thead>
              <tr>
                <th>Account</th>
                <th class="r">Balance ($)</th>
                <th class="r">Liquidity %</th>
                <th class="r">For DP <span class="th-note">(weighted)</span></th>
                <th class="r">For Reserves</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="acct-tbody"></tbody>
          </table>
        </div>
        <button class="btn-add-row" id="btn-add-acct">+ Add Account</button>
        <p style="margin:8px 0 0;font-size:11px;color:var(--g400);line-height:1.5">
          Defaults reflect a $300K fully-liquid profile — enough to plausibly close a $1M condo at 20% down
          with closing costs. Liquidity % is the portion of each account available for the down-payment pool.
          Retirement accounts (401k, IRA) do not count toward the down-payment pool — add them at 0% for net-worth reference only.
          When reserves are enabled, all accounts weighted by liquidity % count toward post-close liquidity.
        </p>
        <div class="acct-totals">
          <div>
            <div class="tot-lbl">Total for Down Pmt + CC</div>
            <div class="tot-val" id="tot-liquid">—</div>
          </div>
          <div>
            <div class="tot-lbl">Total for Reserves</div>
            <div class="tot-val primary" id="tot-avail">—</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2 · Income & Debts -->
    <div class="card">
      <div class="card-title" id="card-title-2" aria-expanded="true" aria-controls="card-body-2"><span class="snum">2</span> Income &amp; Existing Debts<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-2">
        <div class="form-row">
          <label class="lbl" for="annual-income">Annual Gross Income
            <small>Illustrative profile for a $1M financed NYC condo at 20% down and 43% DTI — roughly the income needed once mortgage, common charges, taxes, and insurance are included. Adjust to your situation.</small>
          </label>
          <div class="iw w140"><span class="px">$</span><input type="number" id="annual-income" value="225000" min="0" step="1000"></div>
        </div>
        <div class="form-row">
          <label class="lbl">Monthly Gross Income <small>Auto-calculated</small></label>
          <div class="iw w140"><span class="px">$</span><input type="number" id="monthly-income" class="ro" readonly tabindex="-1"></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="other-debts">Other Monthly Debts
            <small>Car loans, student loans, credit cards, minimum payments, etc. Included in back-end DTI calculation per lender guidelines.</small>
          </label>
          <div class="iw w140"><span class="px">$</span><input type="number" id="other-debts" value="0" min="0" step="100"></div>
        </div>
      </div>
    </div>

    <!-- 3 · Mortgage Assumptions -->
    <div class="card">
      <div class="card-title" id="card-title-3" aria-expanded="true" aria-controls="card-body-3"><span class="snum">3</span> Mortgage Assumptions<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-3">
        <div class="form-row">
          <label class="lbl" for="mtg-rate">Annual Mortgage Rate
            <small>Freddie Mac PMMS Apr 30, 2026: 30-yr FRM avg 6.30% for conventional, conforming, fully amortizing loans with 20% down and excellent credit. Jumbo loans, credit score, points, and lender overlays can differ materially.</small>
          </label>
          <div class="iw w120"><input type="number" id="mtg-rate" value="6.30" min="0" max="30" step="0.05" style="text-align:right"><span class="sx">%</span></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="loan-term">Loan Term</label>
          <div class="iw w120"><input type="number" id="loan-term" value="30" min="1" max="40" step="1" style="text-align:right"><span class="sx">yrs</span></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="dp-pct">Down Payment
            <small>20% is the conventional baseline for conforming loans. Jumbo lenders often require 25–30%; investor or foreign-buyer lenders may require more. Higher down payments reduce monthly P+I and DTI, potentially unlocking a higher price — see the Optimizer tab.</small>
          </label>
          <div class="iw w120"><input type="number" id="dp-pct" value="20" min="0" max="100" step="1" style="text-align:right"><span class="sx">%</span></div>
        </div>
      </div>
    </div>

    <!-- 4 · Lender Requirements & Monthly Costs -->
    <div class="card">
      <div class="card-title" id="card-title-4" aria-expanded="true" aria-controls="card-body-4"><span class="snum">4</span> Lender Requirements &amp; Monthly Costs<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-4">
        <div class="form-row">
          <label class="lbl" for="max-dti">Max Back-End DTI
            <small>Lender back-end DTI includes mortgage P+I, common charges, property taxes, HO-6 insurance, and all other monthly debts. 43% is the standard conforming/QM limit; some lenders target 36% as a conservative benchmark; compensating factors may allow higher — CFPB / Fannie Mae guidelines.</small>
          </label>
          <div class="iw w120"><input type="number" id="max-dti" value="43" min="0" max="100" step="0.5" style="text-align:right"><span class="sx">%</span></div>
        </div>

        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--g100)">
          <div class="sub-title">Monthly Carrying Costs</div>

          <div class="form-row">
            <label class="lbl" for="common-charges">Monthly Common Charges
              <small>Citywide middle range default. Manhattan full-service buildings often $1,500–$3,000+; Brooklyn/Queens boutique buildings often $500–$900. Common charges exclude property taxes — verify with building financials or listing. Source: illustrative citywide estimate.</small>
            </label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="common-charges" value="1000" min="0" step="50"></div>
          </div>

          <div class="form-row">
            <label class="lbl" for="prop-taxes">Monthly Property Taxes
              <small>Citywide avg ~$15,134/yr ($1,261/mo) per Habitat Magazine / NYC DOF 2025–26 tentative assessment roll. Abatements (421-a, STAR, etc.) and assessments can change this dramatically — enter the actual tax from the listing or NYC DOF record.</small>
            </label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="prop-taxes" value="1250" min="0" step="50"></div>
          </div>

          <div class="form-row">
            <label class="lbl" for="ho-insurance">Monthly HO-6 / Homeowners Insurance
              <small>Editable placeholder (~$900/yr). Lenders require coverage; actual premiums depend on coverage limits, location, and insurer. Does not include building master policy. Verify with your insurer.</small>
            </label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="ho-insurance" value="75" min="0" step="10"></div>
          </div>
        </div>

        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--g100)">
          <div class="sub-title">Optional Post-Close Reserves</div>
          <div class="toggle-row">
            <input type="checkbox" id="reserves-enabled">
            <label for="reserves-enabled" class="toggle-lbl">Enable post-close reserve requirement
              <small>Condos do not impose co-op-style board reserves, but lenders or buyers may want a buffer. When enabled, reserves = X months × (mortgage P+I + common charges + taxes + insurance). Turned off by default.</small>
            </label>
          </div>
          <div class="form-row" id="reserve-mo-row" style="display:none">
            <label class="lbl" for="reserve-mo">Reserve Months
              <small>Lender-required reserves or buyer safety buffer. Default 6 months. Reserves are checked from all weighted accounts (not just 100%-liquid).</small>
            </label>
            <div class="iw w120"><input type="number" id="reserve-mo" value="6" min="0" max="120" step="1" style="text-align:right"><span class="sx">mo</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- 5 · Closing Costs -->
    <div class="card">
      <div class="card-title" id="card-title-5" aria-expanded="true" aria-controls="card-body-5"><span class="snum">5</span> Closing Costs<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-5">
        <div class="sub-title">Fixed Costs</div>
        <div class="fc-list">
          <div class="fc-row">
            <label for="fc-atty">Buyer Attorney <em style="font-style:normal;color:var(--g400);font-size:12px;">(NYC range $3,000–$6,000, 2025–26)</em></label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-atty" value="5000" min="0" step="100"></div>
          </div>
          <div class="fc-row">
            <label for="fc-lender">Lender / Bank Fees <em style="font-style:normal;color:var(--g400);font-size:12px;">(origination, points, misc.)</em></label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-lender" value="3500" min="0" step="100"></div>
          </div>
          <div class="fc-row">
            <label for="fc-appraisal">Appraisal, Credit Report &amp; Underwriting</label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-appraisal" value="1000" min="0" step="100"></div>
          </div>
          <div class="fc-row">
            <label for="fc-recording">Recording / Filing Fees</label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-recording" value="750" min="0" step="50"></div>
          </div>
          <div class="fc-row">
            <label for="fc-building">Building Fees <em style="font-style:normal;color:var(--g400);font-size:12px;">(application, move-in, waiver, misc.)</em></label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-building" value="1500" min="0" step="100"></div>
          </div>
          <div class="fc-row">
            <div style="flex:1">
              <div class="toggle-row" style="padding:0">
                <input type="checkbox" id="wc-enabled">
                <label for="wc-enabled" class="toggle-lbl" style="font-size:13px">Working-Capital Contribution
                  <small>Common in new development; possible in some resale buildings. Defaults to 2 × monthly common charges when enabled.</small>
                </label>
              </div>
              <div id="wc-months-row" style="display:none;margin-top:6px;padding-left:26px">
                <span style="font-size:12px;color:var(--g600)">Months of common charges:&nbsp;</span>
                <div class="iw w80" style="display:inline-flex"><input type="number" id="wc-months" value="2" min="0" step="1" style="text-align:right"></div>
              </div>
            </div>
          </div>
          <div class="fc-row fc-total">
            <label>Total Fixed (excl. title, MRT, mansion tax)</label>
            <div class="fc-total-val" id="fc-fixed-total-display">—</div>
          </div>
        </div>

        <div class="var-section">
          <div class="sub-title">Title Insurance (Rate-Based)</div>
          <div class="form-row">
            <label class="lbl" for="title-price-pct">Owner's Title: % of Purchase Price
              <small>Title insurance premium varies by insurer, endorsements, and loan amount. 0.45% is a mid-range NYC resale condo estimate. Verify with your title company. Source: illustrative market estimate.</small>
            </label>
            <div class="iw w120"><input type="number" id="title-price-pct" value="0.45" min="0" max="5" step="0.01" style="text-align:right"><span class="sx">%</span></div>
          </div>
          <div class="form-row">
            <label class="lbl" for="title-loan-pct">Lender's Title: % of Loan Amount
              <small>Lender's title policy and endorsements; separate from owner's policy above. 0.10% is an estimate. Verify with title company.</small>
            </label>
            <div class="iw w120"><input type="number" id="title-loan-pct" value="0.10" min="0" max="5" step="0.01" style="text-align:right"><span class="sx">%</span></div>
          </div>
        </div>

        <div class="cc-info-note">
          <strong>Auto-calculated taxes (shown in Results):</strong>
          <br>• <strong>Mortgage Recording Tax</strong> — 1.80% of loan &lt; $500K; 1.925% of loan ≥ $500K (borrower-paid estimate). Source: NYC DOF / ACRIS. Verify with closing attorney.
          <br>• <strong>Mansion Tax</strong> — 1.00% at $1M+, stepping up to 3.90% above $25M; buyer-paid on full price. Source: NYS Tax Dept pub1099. Watch the $1M cliff.
          <br>Resale financed condo closing costs typically run <strong>2.5%–5%+</strong> of price, mainly due to MRT and title insurance.
        </div>
      </div>
    </div>

  </div><!-- /inputs-panel -->

  <!-- ═══════════════════════════════════════ RIGHT — RESULTS ═══════════════════════════════════════ -->
  <div class="results-panel">

    <div class="results-tabs" role="tablist">
      <button class="tab-btn active" id="tab-standard" role="tab" aria-selected="true" aria-controls="view-standard" data-tab="standard">Standard</button>
      <button class="tab-btn" id="tab-optimizer" role="tab" aria-selected="false" aria-controls="view-optimizer" data-tab="optimizer">⚡ Optimizer</button>
      <button class="tab-btn" id="tab-afford" role="tab" aria-selected="false" aria-controls="view-afford" data-tab="afford">🎯 Afford Target</button>
    </div>

    <div class="results-card" id="view-standard" role="tabpanel" aria-labelledby="tab-standard">

      <!-- Hero -->
      <div class="hero">
        <div class="hero-eyebrow">Your Max Affordable Condo Price</div>
        <div class="hero-price" id="hero-price">$—</div>
        <div class="hero-binding">
          Binding constraint: <span class="binding-val" id="hero-binding">—</span>
        </div>
        <div class="hero-warn" id="hero-warn"></div>
      </div>

      <div class="results-body">

        <!-- Target price override -->
        <div class="target-row">
          <span class="tgt-lbl">Model a specific price:</span>
          <div class="tgt-wrap">
            <span class="px">$</span>
            <input type="number" id="target-price" min="0" step="1000" placeholder="—">
          </div>
          <button class="btn-reset" id="btn-reset-tgt">Reset to max</button>
        </div>

        <!-- Cash Waterfall -->
        <div class="snap-block">
          <div class="snap-title">Cash Waterfall</div>
          <div class="snap-row indent">
            <span class="sr-lbl">Down Payment</span>
            <span class="sr-val" id="s-dp">—</span>
          </div>
          <div class="snap-row indent">
            <span class="sr-lbl">Fixed Closing Costs</span>
            <span class="sr-val" id="s-fcc">—</span>
          </div>
          <div class="snap-row indent">
            <span class="sr-lbl">Title Insurance</span>
            <span class="sr-val" id="s-title">—</span>
          </div>
          <div class="snap-row indent mrt-row">
            <span class="sr-lbl">Mortgage Recording Tax <span class="sr-note">(est. — verify w/ attorney)</span></span>
            <span class="sr-val" id="s-mrt">—</span>
          </div>
          <div class="snap-row indent mansion-row" id="mansion-snap-row">
            <span class="sr-lbl">Mansion Tax <span class="sr-note">(buyer-paid ≥ $1M)</span></span>
            <span class="sr-val" id="s-mansion">—</span>
          </div>
          <div class="snap-row subtotal">
            <span class="sr-lbl">Total at Close</span>
            <span class="sr-val" id="s-atclose">—</span>
          </div>
          <div class="snap-row avail-row">
            <span class="sr-lbl">Avail for DP + CC <span class="sr-note">(weighted)</span></span>
            <span class="sr-val" id="s-dp-avail">—</span>
          </div>
          <div class="snap-row surplus-row">
            <span class="sr-lbl">DP + CC Surplus / (Deficit)</span>
            <span class="sr-val" id="s-dp-surplus">—</span>
          </div>

          <!-- Reserves section — hidden by default -->
          <div id="reserves-snap" style="display:none">
            <hr class="snap-div">
            <div class="snap-row indent">
              <span class="sr-lbl">Reserve Requirement (<span id="s-res-mo1">6</span> mo)</span>
              <span class="sr-val" id="s-res-req">—</span>
            </div>
            <div class="snap-row subtotal">
              <span class="sr-lbl">Total Cash Needed (incl. reserves)</span>
              <span class="sr-val" id="s-total-cash">—</span>
            </div>
            <hr class="snap-div">
            <div class="snap-row avail-row">
              <span class="sr-lbl">Total for Reserves <span class="sr-note">(all weighted)</span></span>
              <span class="sr-val" id="s-avail">—</span>
            </div>
            <div class="snap-row surplus-row">
              <span class="sr-lbl">Reserves Surplus / (Deficit)</span>
              <span class="sr-val" id="s-surplus">—</span>
            </div>
            <div class="snap-row">
              <span class="sr-lbl">Post-close for reserves</span>
              <span class="sr-val" id="s-pc-liquid">—</span>
            </div>
            <div class="snap-row">
              <span class="sr-lbl">Post-close reserve months</span>
              <span class="sr-val" id="s-pc-months">—</span>
            </div>
          </div>
        </div>

        <!-- Monthly Costs -->
        <div class="snap-block">
          <div class="snap-title">Monthly Costs</div>
          <div class="snap-row">
            <span class="sr-lbl">Mortgage (P+I)</span>
            <span class="sr-val" id="s-mtg">—</span>
          </div>
          <div class="snap-row indent pmi-row" id="pmi-snap-row" style="display:none">
            <span class="sr-lbl">PMI <span class="sr-note">(auto — dp &lt; 20%)</span></span>
            <span class="sr-val" id="s-pmi">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">Common Charges</span>
            <span class="sr-val" id="s-common">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">Property Taxes</span>
            <span class="sr-val" id="s-taxes">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">HO-6 Insurance</span>
            <span class="sr-val" id="s-insur">—</span>
          </div>
          <div class="snap-row subtotal">
            <span class="sr-lbl">Total Monthly Housing</span>
            <span class="sr-val" id="s-monthly-total">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">Effective DTI</span>
            <span class="sr-val" id="s-dti">—</span>
          </div>
        </div>

        <!-- Feasibility -->
        <div>
          <div class="feas-title">Feasibility Check</div>
          <div class="pill ok" id="pill-cash">
            <span class="p-icon">✓</span>
            <span class="p-name">Cash</span>
            <span class="p-detail" id="pd-cash">—</span>
          </div>
          <div class="pill ok" id="pill-dti">
            <span class="p-icon">✓</span>
            <span class="p-name">DTI</span>
            <span class="p-detail" id="pd-dti">—</span>
          </div>
          <div id="pill-res-wrap" style="display:none">
            <div class="pill ok" id="pill-res">
              <span class="p-icon">✓</span>
              <span class="p-name">Reserves</span>
              <span class="p-detail" id="pd-res">—</span>
            </div>
          </div>
        </div>

      </div><!-- /results-body -->
    </div><!-- /results-card view-standard -->

    <!-- OPTIMIZER VIEW -->
    <div class="opt-card" id="view-optimizer" role="tabpanel" aria-labelledby="tab-optimizer" hidden>
      <div class="opt-notice" id="opt-notice" hidden>
        <strong id="opt-notice-title">—</strong>
        <span id="opt-notice-detail">—</span>
      </div>
      <div id="opt-content">
        <div class="opt-hero">
          <div class="opt-hero-eyebrow">⚡ True Maximum Price</div>
          <div class="opt-hero-price" id="opt-hero-price">$—</div>
          <div class="opt-hero-sub">at <strong id="opt-hero-dp">—</strong> down (<strong id="opt-hero-dpamt">—</strong>)</div>
