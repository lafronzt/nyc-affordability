---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Footer from '../../../components/Footer.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedBudgets from '../../../components/RelatedBudgets.astro';
import MiniCalcWidget from '../../../components/MiniCalcWidget.astro';
import type { FooterColumn } from '../../../lib/footerLinks';
import { ALL_CALCULATORS, ALL_GUIDES, STANDARD_ABOUT_COLUMN, EXPLORE_LINKS } from '../../../lib/footerLinks';
import { AD_IN_ARTICLE } from '../../../lib/adSlots';
import { buildBreadcrumbJsonLd } from '../../../lib/breadcrumbs';
import { fmtMoney } from '../../../lib/format';
import { requiredIncomeForPrice, DEFAULT_ASSUMPTIONS } from '../../../lib/afford';
import { nearest } from '../../../lib/relatedPages';
import { BUY_PRICES as PRICES, INCOME_AMOUNTS, RENT_PRICES } from '../../../data/priceGrids';

export function getStaticPaths() {
  return PRICES.map((price) => ({
    params: { price: String(price) },
    props: { price },
  }));
}

const { price } = Astro.props;
const coop = requiredIncomeForPrice({ targetPrice: price, propertyType: 'coop' });
const condo = requiredIncomeForPrice({ targetPrice: price, propertyType: 'condo' });

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: ALL_CALCULATORS },
  { heading: 'Guides', links: ALL_GUIDES },
  { heading: 'Explore', links: EXPLORE_LINKS },
  STANDARD_ABOUT_COLUMN,
];

const canonicalPath = `/buy/${price}/`;
const priceLabel = fmtMoney(price);
const pageTitle = `What Does It Take to Buy a ${priceLabel} NYC Apartment? | NYC Affordability`;
const metaDescription = `Required income, down payment, and estimated cash needed to buy a ${priceLabel} co-op or condo in NYC, calculated using our calculators' default assumptions.`;

const SITE_ORIGIN = 'https://www.nyc-affordability.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `What does it take to buy a ${priceLabel} NYC apartment?`,
  description: metaDescription,
  url: `${SITE_ORIGIN}${canonicalPath}`,
  isPartOf: { '@type': 'WebSite', name: 'NYC Affordability', url: `${SITE_ORIGIN}/` },
};
const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Buying', path: '/buy/' },
  { name: priceLabel, path: canonicalPath },
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
const otherPrices = PRICES.filter((p) => p !== price);

// Condo income is used as the canonical basis for cross-family links (rather
// than co-op), matching the same convention used on the income pages.
const relatedIncome = nearest(condo.annualIncomeNeeded, INCOME_AMOUNTS);
const relatedRentPrice = nearest(condo.annualIncomeNeeded / DEFAULT_ASSUMPTIONS.rentIncomeMultiplier, RENT_PRICES);
---
<BaseLayout
  variant="site"
  ads
  pageTitle={pageTitle}
  metaDescription={metaDescription}
  canonicalPath={canonicalPath}
  ogTitle={`Buying a ${priceLabel} NYC apartment`}
  ogDescription={metaDescription}
  ogImage="/images/general-og.png"
  ogImageAlt={`What it takes to buy a ${priceLabel} NYC apartment.`}
  twitterTitle={`Buying a ${priceLabel} NYC apartment`}
  twitterDescription={metaDescription}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
<SiteHeader />

<main>
<div class="hero">
  <div class="hero-eyebrow">Buying</div>
  <h2>What does it take to buy a {priceLabel} apartment?</h2>
  <p>Required income, down payment, and estimated closing cash for a {priceLabel} co-op or condo in NYC — calculated using this site's own affordability engine.</p>
</div>

<div class="page">
  <Breadcrumbs items={breadcrumbItems} />

  <div class="calc-note card">
    <p><strong>The income figures above are calculated</strong>, not looked up — they're the minimum income to clear the DTI limit at {priceLabel}, using the same default mortgage rate and down payment as the live calculators below, assuming no other monthly debts. Clearing DTI is necessary but not sufficient: you'd separately need the cash shown in the table below (down payment, closing costs, and for co-ops, reserves) actually on hand — a lender or board checks both. Open the <a href="/coop/">Co-op</a> or <a href="/condo/">Condo Calculator</a> and enter your real income and accounts to see whether you clear both bars.</p>
  </div>

  <div class="result-grid">
    <div class="result-card">
      <div class="result-label">Co-op — income needed</div>
      <div class="result-value"><span id="result-coop-income">{fmtMoney(coop.annualIncomeNeeded)}</span><span class="result-unit">/yr</span></div>
      <div class="result-binding">{DEFAULT_ASSUMPTIONS.coopDownPaymentPct}% down · {DEFAULT_ASSUMPTIONS.coopMaxDtiPct}% board DTI</div>
      <a class="result-link" href="/coop/">Open Co-op Calculator &rarr;</a>
    </div>
    <div class="result-card">
      <div class="result-label">Condo — income needed</div>
      <div class="result-value"><span id="result-condo-income">{fmtMoney(condo.annualIncomeNeeded)}</span><span class="result-unit">/yr</span></div>
      <div class="result-binding">{DEFAULT_ASSUMPTIONS.condoDownPaymentPct}% down · {DEFAULT_ASSUMPTIONS.condoMaxDtiPct}% lender DTI</div>
      <a class="result-link" href="/condo/">Open Condo Calculator &rarr;</a>
    </div>
  </div>

  <MiniCalcWidget mode="buy-price" defaultValue={price} />

  <div class="card">
    <h3>Total liquid cash you'd want</h3>
    <p>Down payment, closing costs, mansion tax (if applicable), and — for co-ops — post-closing board reserves.</p>
    <table>
      <thead><tr><th></th><th>Co-op</th><th>Condo</th></tr></thead>
      <tbody>
        <tr><td>Purchase price</td><td>{priceLabel}</td><td>{priceLabel}</td></tr>
        <tr><td>Down payment</td><td>{fmtMoney(coop.downPayment)}</td><td>{fmtMoney(condo.downPayment)}</td></tr>
        <tr><td>Est. monthly P&amp;I + carrying</td><td>{fmtMoney(coop.monthlyPI + coop.monthlyCarrying)}/mo</td><td>{fmtMoney(condo.monthlyPI + condo.monthlyCarrying)}/mo</td></tr>
        <tr><td>Est. closing costs{coop.mansionTax > 0 && <span> (excl. mansion tax below)</span>}</td><td>{fmtMoney(coop.estimatedClosingCosts - coop.mansionTax)}</td><td>{fmtMoney(condo.estimatedClosingCosts - condo.mansionTax)}</td></tr>
        {coop.mansionTax > 0 && <tr><td>Mansion tax</td><td>{fmtMoney(coop.mansionTax)}</td><td>{fmtMoney(condo.mansionTax)}</td></tr>}
        <tr><td>Est. reserves (co-op only)</td><td>{fmtMoney(coop.estimatedReserves)}</td><td>&mdash;</td></tr>
        <tr class="total-row"><td>Total est. cash needed</td><td>{fmtMoney(coop.estimatedCashNeeded)}</td><td>{fmtMoney(condo.estimatedCashNeeded)}</td></tr>
      </tbody>
    </table>
  </div>

  <div style="margin-bottom:20px;">
    <AdSlot slot={AD_IN_ARTICLE} format="in-article" maxWidth="100%" sidePadding="0" />
  </div>

  <RelatedBudgets
    heading="This budget, from a different angle"
    items={[
      { label: `${fmtMoney(relatedIncome)}/yr income`, sublabel: 'See what that income affords', href: `/income/${relatedIncome}/` },
      { label: `${fmtMoney(relatedRentPrice)}/mo rent`, sublabel: 'The equivalent rent budget', href: `/rent/${relatedRentPrice}/` },
    ]}
  />

  <div class="card">
    <h3>See a different price</h3>
    <div class="chip-row">
      {otherPrices.map((p) => (
        <a class="chip" href={`/buy/${p}/`}>{fmtMoney(p)}</a>
      ))}
    </div>
    <p class="custom-note">Have a different target price? <a href="/coop/">Open the Co-op</a> or <a href="/condo/">Condo Calculator</a> and use the "Afford Target" tab to enter any price.</p>
  </div>

</div>
</main>

<Footer
  variant="site"
  disclaimer="These figures are calculated using default assumptions (mortgage rate, down payment, DTI, and closing-cost estimates) and do not reflect your actual accounts, debts, or a specific building's financials. They are for informational purposes only and do not constitute financial, legal, or mortgage advice. Always verify with a licensed mortgage professional and real estate attorney."
  columns={footerColumns}
/>
</BaseLayout>

<style>
.hero {
  background: linear-gradient(160deg, var(--navy) 0%, #0d1f3c 55%, #142240 100%);
  padding: 52px 24px 44px; text-align: center; color: #e2e8f0;
}
.hero-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
.hero h2 { font-size: clamp(26px, 4.5vw, 40px); font-weight: 800; letter-spacing: -1px; line-height: 1.15; margin-bottom: 14px; color: #f0f9ff; }
.hero p { font-size: 15px; color: #93b4d0; max-width: 640px; margin: 0 auto; line-height: 1.7; }

.page { max-width: 860px; margin: 0 auto; padding: 44px 24px 64px; flex: 1; }

.calc-note { background: var(--blue-xlt, #eef4ff); border: 1px solid var(--blue-lt, #cfe0fb); }
.calc-note p { font-size: 13px; color: var(--g700); line-height: 1.6; margin: 0; }

.card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 24px 26px 26px; margin-bottom: 20px; overflow-x: auto;
}
.card h3 { font-size: 17px; font-weight: 800; color: var(--g900); margin-bottom: 10px; letter-spacing: -.2px; }
.card p { font-size: 14px; color: var(--g600); line-height: 1.7; margin-bottom: 10px; }
.card a { color: var(--blue); text-decoration: none; }
.card a:hover { text-decoration: underline; }

.result-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 20px; }
.result-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 20px 18px 18px; text-align: center;
}
.result-label { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: var(--g500); margin-bottom: 8px; }
.result-value { font-size: 26px; font-weight: 800; color: var(--g900); letter-spacing: -.5px; }
.result-unit { font-size: 14px; font-weight: 600; color: var(--g500); }
.result-binding { font-size: 12px; color: var(--g500); margin: 6px 0 12px; }
.result-link { font-size: 12.5px; font-weight: 700; }

table { width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 380px; }
th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--border); }
th { font-weight: 700; color: var(--g900); background: var(--g50); }
td { color: var(--g600); }
.total-row td { font-weight: 750; color: var(--g900); border-top: 2px solid var(--border); }

.chip-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
.chip {
  display: inline-block; padding: 7px 14px; border: 1px solid var(--border); border-radius: 999px;
  font-size: 13px; font-weight: 650; color: var(--g800); background: var(--g50); text-decoration: none;
}
.chip:hover { border-color: var(--blue-lt); background: var(--blue-lt); color: var(--blue); text-decoration: none; }
.custom-note { font-size: 13px; margin-top: 4px; }

@media (max-width: 640px) {
  .result-grid { grid-template-columns: 1fr; }
}
@media (max-width: 560px) {
  .card { padding: 20px 18px 22px; }
}
</style>
