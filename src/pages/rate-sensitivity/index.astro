---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import AppHeader from '../../components/AppHeader.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { CALC_RATE_SENSITIVITY, otherCalculators, ALL_GUIDES, EXPLORE_LINKS, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';
import { ASSUMPTIONS as A } from '../../data/assumptions';

const rateWeek = new Date(`${A.mortgageRatePct.effectiveDate}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: otherCalculators(CALC_RATE_SENSITIVITY.href!) },
  { heading: 'Guides', links: ALL_GUIDES },
  { heading: 'Explore', links: EXPLORE_LINKS },
  STANDARD_ABOUT_COLUMN,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NYC Mortgage Rate & Maintenance Sensitivity Calculator',
  url: 'https://www.nyc-affordability.com/rate-sensitivity/',
  description: 'How much NYC co-op or condo you can buy at every mortgage rate from 3 points below today to 3 above, and how much each $100 of monthly maintenance or common charges costs in buying power.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  areaServed: { '@type': 'City', name: 'New York City', sameAs: 'https://www.wikidata.org/wiki/Q60' },
};
---
<BaseLayout
  variant="app"
  ads
  pageTitle="NYC Mortgage Rate & Maintenance Sensitivity: What If Rates Move? | NYC Affordability"
  metaDescription="What happens to your NYC co-op or condo budget if mortgage rates rise or fall, and what does $100/month more in maintenance or common charges cost you? Max price at every rate, with the income and cash limits shown separately."
  canonicalPath="/rate-sensitivity/"
  ogTitle="What If Rates Move? NYC Buying Power at Every Rate"
  ogDescription="Your max NYC co-op or condo price at every mortgage rate, and what each $100/month of maintenance costs in buying power."
  ogImage="/images/rate-sensitivity-og.png"
  ogImageAlt="What If Mortgage Rates Move? See how your NYC buying power changes."
  twitterTitle="What If Rates Move? NYC Buying Power at Every Rate"
  twitterDescription="Your max NYC co-op or condo price at every mortgage rate, and what each $100/month of maintenance costs in buying power."
  jsonLd={jsonLd}
>
<AppHeader
  titleHtml="NYC <em>Rate</em> Sensitivity"
  tagline="What your budget does when rates move, and what a building's monthly charges really cost."
  showSaveToggle
/>

<main class="page">
  <section class="hero">
    <div class="eyebrow">Rates &amp; monthly charges</div>
    <h2>What if rates move? What's $100 of maintenance worth?</h2>
    <p>A co-op's maintenance or a condo's common charges count against your income exactly like a mortgage payment does, so a building with high charges shrinks your budget the same way a higher rate does. This reruns the <a href="/coop/">co-op</a> and <a href="/condo/">condo</a> calculators at every rate (or every charge level) and shows which limit moves: the one set by your income, or the one set by your cash.</p>
  </section>

  <div class="layout">
    <section class="section-card" aria-labelledby="h-inputs">
      <div class="section-title" id="h-inputs">Your situation</div>
      <div class="editor-body">
        <fieldset class="type-toggle">
          <legend>Buying a</legend>
          <label><input type="radio" name="rs-type" value="coop" checked> Co-op</label>
          <label><input type="radio" name="rs-type" value="condo"> Condo</label>
        </fieldset>
        <fieldset class="type-toggle">
          <legend>What moves</legend>
          <label><input type="radio" name="rs-mode" value="rate" checked> Mortgage rate</label>
          <label><input type="radio" name="rs-mode" value="charges"> <span id="rs-mode-charges-label">Maintenance</span></label>
        </fieldset>
        <div class="editor-grid">
          <div class="field">
            <label for="rs-income">Annual gross income</label>
            <div class="input-wrap"><span>$</span><input type="number" id="rs-income" min="0" step="1000" inputmode="numeric"></div>
          </div>
          <div class="field">
            <label for="rs-debts">Other monthly debts</label>
            <div class="input-wrap"><span>$</span><input type="number" id="rs-debts" min="0" step="50" inputmode="numeric"></div>
          </div>
          <div class="field">
            <label for="rs-cash">Cash savings</label>
            <div class="input-wrap"><span>$</span><input type="number" id="rs-cash" min="0" step="1000" inputmode="numeric"></div>
          </div>
          <div class="field">
            <label for="rs-invest">Investments</label>
            <div class="input-wrap"><span>$</span><input type="number" id="rs-invest" min="0" step="1000" inputmode="numeric"></div>
          </div>
          <div class="field">
            <label for="rs-target">Target price <span class="optional">(optional)</span></label>
            <div class="input-wrap"><span>$</span><input type="number" id="rs-target" min="0" step="10000" inputmode="numeric" placeholder="e.g. 450000"></div>
          </div>
        </div>

        <details class="assumptions">
          <summary>Assumptions <span class="muted">(defaults from <a href="/methodology/sources/">our sources page</a>)</span></summary>
          <div class="editor-grid">
            <div class="field">
              <label for="rs-rate">Mortgage rate today</label>
              <div class="input-wrap"><input type="number" id="rs-rate" min="0.5" max="20" step="0.05"><span>%</span></div>
              <small>Freddie Mac average, week of {rateWeek}</small>
            </div>
            <div class="field">
              <label for="rs-charges" id="rs-charges-label">Monthly maintenance</label>
              <div class="input-wrap"><span>$</span><input type="number" id="rs-charges" min="0" step="50"><span>/mo</span></div>
            </div>
            <div class="field">
              <label for="rs-dp">Down payment</label>
              <div class="input-wrap"><input type="number" id="rs-dp" min="0" max="100" step="1"><span>%</span></div>
            </div>
            <div class="field">
              <label for="rs-dti" id="rs-dti-label">Board DTI limit</label>
              <div class="input-wrap"><input type="number" id="rs-dti" min="1" max="100" step="1"><span>%</span></div>
            </div>
            <div class="field coop-only">
              <label for="rs-reserves">Board reserves</label>
              <div class="input-wrap"><input type="number" id="rs-reserves" min="0" max="60" step="1"><span>mo</span></div>
            </div>
            <div class="field condo-only">
              <label for="rs-tax">Property tax</label>
              <div class="input-wrap"><span>$</span><input type="number" id="rs-tax" min="0" step="25"><span>/mo</span></div>
            </div>
            <div class="field condo-only">
              <label for="rs-ins">Homeowner's insurance</label>
              <div class="input-wrap"><span>$</span><input type="number" id="rs-ins" min="0" step="5"><span>/mo</span></div>
            </div>
            <div class="field">
              <label for="rs-liq">Investments counted toward liquidity</label>
              <div class="input-wrap"><input type="number" id="rs-liq" min="0" max="100" step="5"><span>%</span></div>
            </div>
          </div>
        </details>
        <p class="editor-note">Everything is calculated in your browser. Nothing you enter is sent anywhere.</p>
      </div>
    </section>

    <div class="results" aria-live="polite">
      <section class="section-card" aria-labelledby="h-answer">
        <div class="section-title" id="h-answer">Your answer</div>
        <div class="answer-body">
          <div class="big-label" id="rs-big-label">At today's rate, you can buy up to</div>
          <div class="big-value" id="rs-max">&mdash;</div>
          <p class="headline" id="rs-headline">&mdash;</p>
          <dl class="tiles">
            <div><dt id="rs-up-label">1 point higher</dt><dd id="rs-up">&mdash;</dd></div>
            <div><dt id="rs-down-label">1 point lower</dt><dd id="rs-down">&mdash;</dd></div>
            <div><dt id="rs-step-label">Income limit, per point</dt><dd id="rs-step">&mdash;</dd></div>
            <div><dt id="rs-equiv-label">$100/mo of maintenance is worth</dt><dd id="rs-equiv">&mdash;</dd></div>
          </dl>
          <p class="target-line" id="rs-target-line" hidden></p>
          <p class="editor-note">Calculated estimates from your inputs and the assumptions on the left, not market data or a rate quote.</p>
        </div>
      </section>
    </div>
  </div>

  <section class="section-card" aria-labelledby="h-chart">
    <div class="section-title" id="h-chart"><span id="rs-chart-title">Max price at each mortgage rate</span></div>
    <div class="chart-body">
      <ul class="legend" aria-label="Chart legend">
        <li><span class="key key-income"></span>Income limit (DTI)</li>
        <li><span class="key key-cash"></span><span>Cash limit (down payment, closing<span class="coop-only">, reserves</span>)</span></li>
        <li><span class="key key-max"></span>Your max: the lower line</li>
        <li id="rs-legend-target" hidden><span class="key key-target"></span>Your target</li>
      </ul>
      <div class="chart-wrap" id="rs-chart-wrap">
        <svg id="rs-chart" role="img" aria-labelledby="rs-chart-desc"></svg>
        <div class="tooltip" id="rs-tooltip" hidden></div>
      </div>
      <p class="chart-desc" id="rs-chart-desc">&mdash;</p>
      <details class="table-view">
        <summary>Show as a table</summary>
        <div class="table-wrap"><table class="data"><thead id="rs-thead"></thead><tbody id="rs-table"></tbody></table></div>
      </details>
    </div>
  </section>

  <div class="actions">
    <label class="share-personal"><input type="checkbox" id="rs-share-personal"> Include my income, savings, and debts in the link</label>
    <button class="btn-share" id="rs-share" type="button">Copy scenario link</button>
    <button class="btn-share" id="rs-print" type="button">Print</button>
  </div>

  <section class="section-card" aria-labelledby="h-how">
    <div class="section-title" id="h-how">How this works</div>
    <div class="prose-body">
      <p><strong>Two limits, one budget.</strong> Your income sets a ceiling: the price where mortgage, PMI, and the building's monthly charges (plus property tax and insurance for a condo) hit the <a href="/glossary/debt-to-income-ratio-dti/">DTI limit</a>. Your cash sets another: the price where the down payment and closing costs (and for a co-op, the board's <a href="/glossary/post-closing-liquidity/">post-closing reserves</a>) use up what you have. Your max price is whichever is lower. Each point on the chart is the full <a href="/coop/">co-op</a> or <a href="/condo/">condo</a> calculation, rerun with one number changed.</p>
      <p><strong>Rates move the income limit a lot and the cash limit a little.</strong> A higher rate means a bigger payment on the same loan, so the income limit drops. The cash limit for a condo doesn't care about the rate at all; for a co-op it moves a bit, because the board's reserve requirement counts months of mortgage payments. If cash is your tighter limit, a rate drop may barely change what you can buy.</p>
      <p><strong>Maintenance is a rate in disguise.</strong> Lenders and boards count <a href="/glossary/maintenance-coop/">maintenance</a> and <a href="/glossary/common-charges/">common charges</a> dollar for dollar against your income, same as the mortgage. The "worth" tile converts $100/month of charges into the rate change that would cost you the same buying power, which is handy when comparing two buildings at different charge levels.</p>
      <p><strong>What it can't see:</strong> rate quotes for your credit and loan size, points and buydowns, adjustable-rate loans, or how a building's charges will change. The mortgage-rate default is the Freddie Mac weekly average, not an offer. See <a href="/guides/how-mortgage-rates-affect-nyc-affordability/">how mortgage rates affect NYC affordability</a>, <a href="/afford-more/">what else moves your number</a>, and <a href="/methodology/">the methodology</a>.</p>
    </div>
  </section>
</main>

<AdSlot maxWidth="1300px" sidePadding="20px" />

<Footer
  variant="app"
  disclaimer="This calculator is for informational purposes only and does not constitute financial, legal, investment, or mortgage advice. Mortgage rates shown are scenarios, not quotes; the default is a published weekly average. Results are estimates using default assumptions. Verify financing with a licensed mortgage professional and building requirements with the board or managing agent."
  columns={footerColumns}
/>
</BaseLayout>

<script>
  import '../../scripts/rate-sensitivity';
</script>

<style>
.page { max-width: 1300px; margin: 20px auto; padding: 0 20px 60px; }
.hero {
  background: linear-gradient(135deg, #0a1628 0%, #0f2a54 100%);
  border: 1px solid #1e3a5f; border-radius: var(--r); color: #e2e8f0;
  box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 16px; padding: 26px 24px 22px;
}
.eyebrow { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--gold); margin-bottom: 8px; }
.hero h2 { font-size: clamp(22px, 3.2vw, 32px); line-height: 1.15; letter-spacing: -0.5px; color: #f0f9ff; margin-bottom: 10px; }
.hero p { color: #93b4d0; max-width: 820px; font-size: 14px; line-height: 1.65; }
.hero p a { color: #cfe0fb; }

.layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 16px; align-items: start; }
.section-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.05); margin-bottom: 16px;
}
.section-title {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--g500);
  padding: 12px 18px 11px; border-bottom: 1px solid var(--g100);
}
.editor-body { padding: 16px 18px 18px; }
.editor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-bottom: 12px; }
.field label { display: block; font-size: 12px; color: var(--g700); font-weight: 650; margin-bottom: 5px; }
.field small { display: block; font-size: 11px; color: var(--g500); margin-top: 4px; }
.optional { font-weight: 400; color: var(--g500); }
.input-wrap {
  display: flex; align-items: stretch; border: 1px solid var(--g300); border-radius: 5px; background: #fff;
  overflow: hidden; transition: border-color .15s, box-shadow .15s;
}
.input-wrap:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,.12); }
.input-wrap span {
  background: var(--g50); border-right: 1px solid var(--g200); padding: 0 8px; color: var(--g500);
  font-size: 13px; font-weight: 600; display: flex; align-items: center; white-space: nowrap;
}
.input-wrap input + span { border-right: 0; border-left: 1px solid var(--g200); }
.input-wrap input { border: 0; outline: 0; padding: 9px 9px; min-width: 0; width: 100%; font: inherit; color: var(--g900); background: #fff; }
.type-toggle { border: 0; padding: 0; margin: 0 0 14px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.type-toggle legend { font-size: 12px; font-weight: 650; color: var(--g700); margin-right: 4px; float: left; padding-top: 2px; }
.type-toggle label { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 650; color: var(--g800); min-height: 32px; cursor: pointer; }
.assumptions { border-top: 1px solid var(--g100); padding-top: 12px; margin-bottom: 8px; }
.assumptions summary { cursor: pointer; font-size: 13px; font-weight: 700; color: var(--g800); margin-bottom: 12px; min-height: 28px; }
.assumptions .muted { font-weight: 400; color: var(--g500); }
.assumptions a { color: var(--blue); }
.editor-note { font-size: 12px; color: var(--g500); line-height: 1.6; margin-top: 6px; }
:global(body.type-condo) .coop-only { display: none; }
:global(body.type-coop) .condo-only { display: none; }
table.data :global(tr.current td), table.data :global(tr.current th) { background: var(--blue-xlt); font-weight: 800; color: var(--g900); }
.key-max { background: rgba(17,24,39,.18); height: 8px; }
table.data :global(td.neg) { color: #b42318; }

.answer-body { padding: 18px; }
.big-label { font-size: 12px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: .8px; }
.big-value { font-size: 38px; font-weight: 850; letter-spacing: -1.1px; color: var(--g900); margin: 4px 0 8px; }
.big-value.long { font-size: 24px; letter-spacing: -0.4px; line-height: 1.25; }
.headline { font-size: 14.5px; color: var(--g700); line-height: 1.6; margin-bottom: 14px; }
.headline :global(strong) { color: var(--g900); }
.headline :global(a) { color: var(--blue); }
.tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; margin: 0 0 12px; }
.tiles div { background: var(--g50); border: 1px solid var(--g100); border-radius: 6px; padding: 9px 11px; }
.tiles dt { font-size: 11px; color: var(--g500); font-weight: 650; }
.tiles dd { margin: 2px 0 0; font-size: 16px; font-weight: 800; color: var(--g900); font-variant-numeric: tabular-nums; }
.target-line { font-size: 14px; color: var(--g700); line-height: 1.6; background: var(--blue-xlt); border: 1px solid var(--blue-lt); border-radius: 6px; padding: 10px 12px; }
.target-line :global(strong) { color: var(--g900); }


.chart-body { padding: 14px 18px 16px; }
.legend { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0 0 8px; padding: 0; }
.legend li { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--g700); font-weight: 600; }
.key { display: inline-block; width: 18px; height: 3px; border-radius: 2px; }
.key-income { background: #2a78d6; }
.key-cash { background: #eb6834; }
.key-target { background: repeating-linear-gradient(90deg, #374151 0 5px, transparent 5px 8px); }
.chart-wrap { position: relative; width: 100%; }
#rs-chart { display: block; width: 100%; height: 300px; overflow: visible; }
#rs-chart :global(.grid) { stroke: #eceae6; stroke-width: 1; }
#rs-chart :global(.axis-label) { fill: var(--g500); font-size: 11px; font-variant-numeric: tabular-nums; }
#rs-chart :global(.series) { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
#rs-chart :global(.s-income) { stroke: #2a78d6; }
#rs-chart :global(.s-cash) { stroke: #eb6834; }
#rs-chart :global(.max-band) { fill: none; stroke: #111827; stroke-opacity: .12; stroke-width: 9; stroke-linejoin: round; stroke-linecap: round; }
#rs-chart :global(.target) { stroke: #374151; stroke-width: 1.5; stroke-dasharray: 5 3; }
#rs-chart :global(.now) { stroke: #9ca3af; stroke-width: 1; stroke-dasharray: 2 3; }
#rs-chart :global(.zero) { stroke: var(--g400); stroke-width: 1; }
#rs-chart :global(.dot) { stroke: #fff; stroke-width: 2; }
#rs-chart :global(.direct-label) { fill: var(--g700); font-size: 11.5px; font-weight: 700; }
#rs-chart :global(.crosshair) { stroke: var(--g400); stroke-width: 1; }
.tooltip {
  position: absolute; pointer-events: none; background: #fff; border: 1px solid var(--g200); border-radius: 6px;
  box-shadow: 0 6px 16px rgba(0,0,0,.12); padding: 8px 10px; font-size: 12px; color: var(--g800); min-width: 170px; z-index: 5;
}
.tooltip :global(.tt-date) { font-weight: 800; margin-bottom: 4px; }
.tooltip :global(.tt-row) { display: flex; justify-content: space-between; gap: 12px; font-variant-numeric: tabular-nums; }
.tooltip :global(.tt-row span:first-child) { display: inline-flex; align-items: center; gap: 6px; color: var(--g600); }
.tooltip :global(.sw) { width: 10px; height: 3px; border-radius: 2px; display: inline-block; }
.chart-desc { font-size: 12.5px; color: var(--g600); line-height: 1.6; margin: 8px 0; }
.table-view summary { cursor: pointer; font-size: 13px; font-weight: 700; color: var(--g700); min-height: 28px; }

.table-wrap { overflow-x: auto; }
table.data { width: 100%; border-collapse: collapse; font-size: 13.5px; }
table.data th { text-align: left; font-size: 10px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: .8px; padding: 10px 14px; border-bottom: 1px solid var(--g100); background: var(--g50); }
table.data :global(td), table.data :global(th[scope="row"]) { padding: 10px 14px; border-bottom: 1px solid var(--g100); color: var(--g800); text-align: left; font-weight: 600; }
table.data :global(.num) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
table.data :global(tr.total td), table.data :global(tr.total th) { font-weight: 850; color: var(--g900); border-top: 2px solid var(--g200); }
table.data :global(.sub) { display: block; font-size: 12px; font-weight: 400; color: var(--g500); }

.actions { display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
.share-personal { font-size: 12.5px; color: var(--g600); display: inline-flex; align-items: center; gap: 6px; min-height: 32px; }
.btn-share {
  border: 1px solid var(--blue-lt); background: #fff; color: var(--blue); border-radius: 6px;
  padding: 10px 20px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; min-height: 40px;
}
.btn-share:hover { background: var(--blue-xlt); }

.prose-body { padding: 16px 18px 18px; }
.prose-body p { font-size: 13.5px; color: var(--g600); line-height: 1.7; margin-bottom: 10px; }
.prose-body p:last-child { margin-bottom: 0; }
.prose-body a { color: var(--blue); text-decoration: none; }
.prose-body a:hover { text-decoration: underline; }

@media (max-width: 960px) {
  .layout { grid-template-columns: 1fr; }
}
@media (max-width: 560px) {
  .page { padding: 0 14px 44px; margin-top: 14px; }
  .hero { padding: 22px 18px 18px; }
  .editor-grid { grid-template-columns: 1fr; }
  .big-value { font-size: 30px; }
  .tiles { grid-template-columns: 1fr; }
  #rs-chart { height: 240px; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
@media print {
  :global(header), :global(footer), :global(.page-tagline), .actions, .hero { display: none !important; }
  .page { margin: 0; padding: 0; max-width: none; }
  .section-card { box-shadow: none; break-inside: avoid; }
  .table-view { display: block; }
}
</style>
