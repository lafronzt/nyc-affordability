---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { ALL_CALCULATORS, ALL_GUIDES, STANDARD_ABOUT_COLUMN, EXPLORE_LINKS } from '../../lib/footerLinks';
import { AD_MULTIPLEX_HORIZONTAL } from '../../lib/adSlots';
import { buildBreadcrumbJsonLd } from '../../lib/breadcrumbs';
import { fmtMoney } from '../../lib/format';
import { maxAffordableRent, maxAffordablePrice } from '../../lib/afford';
import { INCOME_AMOUNTS as AMOUNTS } from '../../data/priceGrids';
import '../../styles/salaryIncomeLanding.css';

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: ALL_CALCULATORS },
  { heading: 'Guides', links: ALL_GUIDES },
  { heading: 'Explore', links: EXPLORE_LINKS },
  STANDARD_ABOUT_COLUMN,
];

const rows = AMOUNTS.map((amount) => ({
  amount,
  rent: maxAffordableRent({ annualIncome: amount }).maxRent,
  coop: maxAffordablePrice({ annualIncome: amount, propertyType: 'coop' }).maxPrice,
  condo: maxAffordablePrice({ annualIncome: amount, propertyType: 'condo' }).maxPrice,
}));

const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'What can I afford', path: '/income/' },
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
const SITE_ORIGIN = 'https://www.nyc-affordability.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'What Can I Afford in NYC?',
  url: `${SITE_ORIGIN}/income/`,
  isPartOf: { '@type': 'WebSite', name: 'NYC Affordability', url: `${SITE_ORIGIN}/` },
};
---
<BaseLayout
  variant="site"
  ads
  pageTitle="What Can I Afford in NYC? By Income | NYC Affordability"
  metaDescription="See max rent, co-op, and condo purchase price by income level — $50k to $500k/year — calculated using our affordability engine's default assumptions."
  canonicalPath="/income/"
  ogTitle="What Can I Afford in NYC?"
  ogDescription="Max rent, co-op, and condo purchase price by income level, calculated using our affordability engine."
  ogImage="/images/general-og.png"
  ogImageAlt="What can I afford in NYC by income."
  twitterTitle="What Can I Afford in NYC?"
  twitterDescription="Max rent, co-op, and condo purchase price by income level."
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
<SiteHeader />

<main>
<div class="hero">
  <div class="hero-eyebrow">What Can I Afford</div>
  <h2>What does your income get you in NYC?</h2>
  <p>Pick an income level to see max rent, co-op, and condo purchase price — calculated using the same math as the calculators, not a rule of thumb.</p>
</div>

<div class="page">
  <Breadcrumbs items={breadcrumbItems} />

  <p class="calc-caveat">Co-op/condo columns are an income (DTI) ceiling only — they don't check down payment cash, closing costs, or reserves against real savings, which usually caps the actual number lower. See a page's "Details" link for the full breakdown.</p>

  <div class="card">
    <table>
      <thead><tr><th>Income</th><th>Max rent</th><th>Max co-op</th><th>Max condo</th><th></th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td>{fmtMoney(r.amount)}</td>
            <td>{fmtMoney(r.rent)}/mo</td>
            <td>{fmtMoney(r.coop)}</td>
            <td>{fmtMoney(r.condo)}</td>
            <td><a href={`/income/${r.amount}/`}>Details &rarr;</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div style="margin-bottom:20px;">
    <AdSlot slot={AD_MULTIPLEX_HORIZONTAL} format="multiplex" maxWidth="100%" sidePadding="0" />
  </div>

  <div class="cta-box">
    <h3>Have a different income?</h3>
    <p>These pages use round-number defaults. For your exact salary, savings, and debts, run the full comparison.</p>
    <a class="cta-button" href="/compare/">Compare all your options &rarr;</a>
  </div>
</div>
</main>

<Footer
  variant="site"
  disclaimer="These figures are calculated using default assumptions and do not reflect your actual accounts, debts, or a specific building's financials. They are for informational purposes only and do not constitute financial, legal, or mortgage advice."
  columns={footerColumns}
/>
</BaseLayout>

<style>
/* Shared hero/card/table/cta-box rules live in salaryIncomeLanding.css
   (imported above) — this block is only for what's unique to this page. */
table { min-width: 480px; }
</style>
