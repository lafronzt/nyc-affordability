---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
import type { FooterColumn } from '../lib/footerLinks';
import { ALL_CALCULATORS, ALL_GUIDES, HPD_HOME_LINK, CFPB_OWNING_HOME_LINK, MANSION_TAX_GUIDE_LINK, STANDARD_ABOUT_COLUMN } from '../lib/footerLinks';

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: ALL_CALCULATORS },
  { heading: 'Guides', links: ALL_GUIDES },
  {
    heading: 'NYC Housing Resources',
    links: [
      HPD_HOME_LINK,
      CFPB_OWNING_HOME_LINK,
      { label: "NYS AG Tenants' Rights", href: 'https://ag.ny.gov/publications/residential-tenants-rights-guide' },
    ],
  },
  {
    heading: 'Taxes & Rules',
    links: [
      MANSION_TAX_GUIDE_LINK,
      { label: 'NYC Real Property Transfer Tax', href: 'https://www.nyc.gov/site/finance/taxes/property-real-property-transfer-tax-rptt.page' },
      { label: 'NYC FARE Act FAQ', href: 'https://www.nyc.gov/site/dca/about/FAQ-Broker-Fees.page' },
    ],
  },
  STANDARD_ABOUT_COLUMN,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NYC Affordability',
  url: 'https://www.nyc-affordability.com/',
  description: 'Free NYC apartment, home, and housing affordability calculators for co-ops, condos, rentals, and HPD affordable housing AMI eligibility.',
  areaServed: {
    '@type': 'City',
    name: 'New York City',
    sameAs: 'https://www.wikidata.org/wiki/Q60',
  },
};
---
<BaseLayout
  variant="site"
  ads
  pageTitle="NYC Housing, Home & Apartment Affordability Calculators"
  metaDescription="Free NYC housing calculators for co-ops, condos, rentals, and affordable housing (HPD AMI / Housing Connect). Estimate your max price, affordable rent, or AMI eligibility."
  canonicalPath="/"
  ogTitle="NYC Affordability | Free NYC Housing Calculators"
  ogDescription="Free NYC housing calculators for co-ops, condos, rentals, and affordable housing (HPD AMI / Housing Connect). Find your max purchase price, affordable rent, or check your AMI band eligibility."
  ogImage="/images/general-og.png"
  ogImageAlt="Can you afford NYC housing? Co-op, condo, rent, and affordable housing calculators from NYC Affordability."
  twitterTitle="NYC Affordability"
  twitterDescription="Free NYC housing calculators — co-op, condo, rental, and affordable housing (HPD AMI / Housing Connect). Reverse-engineer your numbers from your financial profile."
  jsonLd={jsonLd}
>
<SiteHeader />

<main><div class="hero">
  <div class="hero-eyebrow">Free NYC Housing Calculators</div>
  <h2>Know your numbers<br>before you sign anything.</h2>
  <p>Six tools built for how NYC housing actually works — co-ops with board reserves, condos with closing-cost math, rentals with FARE Act rules, affordable housing with HPD's AMI framework, seller net proceeds, and a side-by-side comparison dashboard.</p>
</div>

<section class="calc-section">
  <div class="calc-section-title">Choose your calculator</div>
  <div class="calc-grid">

    <!-- Co-op -->
    <a class="calc-card" href="/coop/">
      <div class="card-banner coop">
        <div class="card-icon">🏛️</div>
        <div class="card-banner-title">NYC Co-op<br>Affordability</div>
      </div>
      <div class="card-body">
        <p class="card-desc">Reverse-engineer your maximum co-op purchase price, factoring in board-mandated post-close reserves and strict DTI limits most mortgage calculators ignore.</p>
        <ul class="card-features">
          <li>Board reserve requirements (12–24 months)</li>
          <li>Co-op board DTI (typically 25–30%)</li>
          <li>Flip tax &amp; variable closing costs</li>
          <li>Down-payment optimizer with chart</li>
        </ul>
        <span class="card-cta cta-coop">Open Co-op Calculator →</span>
      </div>
    </a>

    <!-- Condo -->
    <a class="calc-card" href="/condo/">
      <div class="card-banner condo">
        <div class="card-icon">🏙️</div>
        <div class="card-banner-title">NYC Condo<br>Affordability</div>
      </div>
      <div class="card-body">
        <p class="card-desc">Find your maximum condo purchase price with lender-style DTI, mansion tax cliff math, mortgage recording tax, and title insurance calculated precisely.</p>
        <ul class="card-features">
          <li>Lender back-end DTI (43% default)</li>
          <li>Mansion tax tiers ($1M–$25M+)</li>
          <li>Mortgage recording tax on loan amount</li>
          <li>Separate common charges, taxes &amp; insurance</li>
        </ul>
        <span class="card-cta cta-condo">Open Condo Calculator →</span>
      </div>
    </a>

    <!-- Rent -->
    <a class="calc-card" href="/rent/">
      <div class="card-banner rent">
        <div class="card-icon">🗝️</div>
        <div class="card-banner-title">NYC Rent<br>Affordability</div>
      </div>
      <div class="card-body">
        <p class="card-desc">Find your maximum affordable monthly rent accounting for NYC's 40× income rule, FARE Act broker fee protections, security deposit law, and move-in cash requirements.</p>
        <ul class="card-features">
          <li>40× income multiplier screening</li>
          <li>FARE Act broker fee rules (June 2025)</li>
          <li>Security deposit cap (1 month)</li>
          <li>Reserve buffer &amp; move-in cash waterfall</li>
        </ul>
        <span class="card-cta cta-rent">Open Rent Calculator →</span>
      </div>
    </a>

    <!-- Affordable Housing -->
    <a class="calc-card" href="/affordable/">
      <div class="card-banner affordable">
        <div class="card-icon">🏠</div>
        <div class="card-banner-title">NYC Affordable<br>Housing Finder</div>
      </div>
      <div class="card-body">
        <p class="card-desc">Find your AMI percentage, check Housing Connect eligibility across all income bands, and see HPD's affordable rent framework for every unit size.</p>
        <ul class="card-features">
          <li>AMI % from household size &amp; income</li>
          <li>Housing Connect band eligibility (30–130%)</li>
          <li>HPD affordable rent table by unit size</li>
          <li>Editable FY2026 AMI reference values</li>
        </ul>
        <span class="card-cta cta-affordable">Open Affordable Finder →</span>
      </div>
    </a>

    <!-- Compare -->
    <a class="calc-card" href="/compare/">
      <div class="card-banner compare">
        <div class="card-icon">📊</div>
        <div class="card-banner-title">Compare<br>All Options</div>
      </div>
      <div class="card-body">
        <p class="card-desc">Use your saved profile to compare rent, co-op, and condo affordability side by side with cash required, monthly cost, DTI, reserves, and binding constraints.</p>
        <ul class="card-features">
          <li>Reads your saved browser profile</li>
          <li>Rent vs co-op vs condo maxes</li>
          <li>Cash, monthly cost, DTI &amp; reserves</li>
          <li>Links back into each calculator</li>
        </ul>
        <span class="card-cta cta-compare">Open Comparison →</span>
      </div>
    </a>

    <!-- Sale Net Proceeds -->
    <a class="calc-card" href="/sell/">
      <div class="card-banner sell">
        <div class="card-icon">💰</div>
        <div class="card-banner-title">NYC Sale<br>Net Proceeds</div>
      </div>
      <div class="card-body">
        <p class="card-desc">See what you'll actually walk away with when you sell — broker commission, NYC &amp; NYS transfer taxes, co-op flip tax, and an optional capital gains estimate.</p>
        <ul class="card-features">
          <li>NYC RPTT &amp; NYS transfer tax, auto-calculated</li>
          <li>Co-op flip tax &amp; transfer fee toggle</li>
          <li>Broker commission &amp; attorney fees</li>
          <li>Section 121 capital gains estimate</li>
        </ul>
        <span class="card-cta cta-sell">Open Net Proceeds Calculator →</span>
      </div>
    </a>

  </div>
</section>

<div class="features">
  <div class="features-inner">
    <div>
      <div class="feat-icon">🔒</div>
      <div class="feat-title">Fully Private</div>
      <div class="feat-desc">All calculations run in your browser. No data is ever sent to a server or stored anywhere but your own device.</div>
    </div>
    <div>
      <div class="feat-icon">📐</div>
      <div class="feat-title">NYC-Specific Math</div>
      <div class="feat-desc">Each calculator models the rules that actually govern NYC housing — not generic national formulas.</div>
    </div>
    <div>
      <div class="feat-icon">📋</div>
      <div class="feat-title">Sourced Assumptions</div>
      <div class="feat-desc">Every default value links to its source — Freddie Mac, NYC DOF, StreetEasy, and NYC DCWP — so you can verify the numbers.</div>
    </div>
  </div>
</div>

<AdSlot />
</main>

<Footer
  variant="site"
  disclaimer="These calculators are for informational purposes only and do not constitute financial, legal, or mortgage advice. Tax rates, board requirements, and closing costs vary by building, lender, and transaction. Always verify all figures with a licensed mortgage professional and real estate attorney before making housing decisions."
  columns={footerColumns}
/>
</BaseLayout>

<style>
.hero {
  background: linear-gradient(160deg, var(--navy) 0%, #0d1f3c 55%, #142240 100%);
  padding: 64px 24px 56px;
  text-align: center;
  color: #e2e8f0;
}
.hero-eyebrow {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 14px;
}
.hero h2 {
  font-size: clamp(28px, 5vw, 46px);
  font-weight: 800;
  letter-spacing: -1px;
  line-height: 1.1;
  margin-bottom: 18px;
  color: #f0f9ff;
}
.hero p {
  font-size: clamp(14px, 2vw, 16px);
  color: #93b4d0;
  max-width: 560px;
  margin: 0 auto 8px;
  line-height: 1.65;
}

.calc-section {
  max-width: 1120px;
  margin: 0 auto;
  padding: 48px 24px 64px;
  flex: 1;
}
.calc-section-title {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--g500);
  text-align: center;
  margin-bottom: 32px;
}
.calc-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 24px;
}
.calc-card { grid-column: span 2; }

.calc-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--r);
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,.06);
  display: flex;
  flex-direction: column;
  transition: transform .18s, box-shadow .18s;
  text-decoration: none;
  color: inherit;
}
.calc-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,.12);
}
.calc-card:focus-visible {
  outline: 3px solid var(--blue);
  outline-offset: 2px;
}

.card-banner {
  padding: 28px 24px 22px;
  text-align: center;
}
.card-banner.coop       { background: var(--navy); }
.card-banner.condo      { background: linear-gradient(135deg, #1a3a6b, #0f2a54); }
.card-banner.rent       { background: linear-gradient(135deg, #134e38, #0e3d2c); }
.card-banner.affordable { background: linear-gradient(135deg, #1e1b4b, #111840); }
.card-banner.sell       { background: linear-gradient(135deg, #0f766e, #042f2e); }
.card-banner.compare    { background: linear-gradient(135deg, #78350f, #0f2a54); }

.card-icon {
  font-size: 32px;
  margin-bottom: 10px;
  line-height: 1;
}
.card-banner-title {
  font-size: 18px;
  font-weight: 800;
  color: #f0f9ff;
  letter-spacing: -0.3px;
  line-height: 1.2;
  margin-bottom: 6px;
}
.card-banner-sub {
  font-size: 12px;
  color: rgba(255,255,255,0.55);
  line-height: 1.4;
}

.card-body {
  padding: 20px 22px 24px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.card-desc {
  font-size: 13.5px;
  color: var(--g600);
  line-height: 1.6;
  flex: 1;
}
.card-features {
  list-style: none;
  padding: 0;
  margin: 0;
}
.card-features li {
  font-size: 12.5px;
  color: var(--g500);
  padding: 3px 0;
  display: flex;
  align-items: flex-start;
  gap: 7px;
  line-height: 1.4;
}
.card-features li::before {
  content: '✓';
  color: var(--green);
  font-size: 11px;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 2px;
}

.card-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 11px 20px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  transition: opacity .15s;
  cursor: pointer;
  border: none;
  width: 100%;
}
.card-cta:hover { opacity: 0.88; }
.cta-coop       { background: var(--navy); color: #e2e8f0; }
.cta-condo      { background: #1a3a6b; color: #e2e8f0; }
.cta-rent       { background: #134e38; color: #e2e8f0; }
.cta-affordable { background: #1e1b4b; color: #e0e7ff; }
.cta-sell       { background: #0f766e; color: #e2e8f0; }
.cta-compare    { background: #78350f; color: #e2e8f0; }

.features {
  background: #fff;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 36px 24px;
}
.features-inner {
  max-width: 900px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  text-align: center;
}
.feat-icon { font-size: 24px; margin-bottom: 8px; line-height: 1; }
.feat-title { font-size: 13px; font-weight: 700; color: var(--g800); margin-bottom: 4px; }
.feat-desc  { font-size: 12.5px; color: var(--g500); line-height: 1.5; }

@media (max-width: 1100px) {
  .calc-grid { grid-template-columns: repeat(2, 1fr); }
  .calc-card,
  .calc-card--row2-left,
  .calc-card--row2-right { grid-column: span 1; }
}
@media (max-width: 820px) {
  .calc-grid { grid-template-columns: repeat(2, 1fr); max-width: 640px; margin: 0 auto; }
  .features-inner { grid-template-columns: 1fr; gap: 24px; }
  .hero { padding: 44px 20px 40px; }
}
@media (max-width: 560px) {
  .calc-grid { grid-template-columns: 1fr; max-width: 480px; }
  .calc-section { padding: 32px 16px 48px; }
  :global(.site-header) { padding: 0 16px; }
}
</style>
