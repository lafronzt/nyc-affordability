---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { CALC_AFFORDABLE, otherCalculators, ALL_GUIDES, NYC_HPD_TENANT_RIGHTS_LINK, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';
import { buildBreadcrumbJsonLd } from '../../lib/breadcrumbs';

const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: CALC_AFFORDABLE.label, path: CALC_AFFORDABLE.href! },
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);

const footerColumns: FooterColumn[] = [
  { heading: 'More Calculators', links: otherCalculators(CALC_AFFORDABLE.href!) },
  { heading: 'Guides', links: ALL_GUIDES },
  {
    heading: 'Affordable Housing',
    links: [
      { label: 'Housing Connect', href: 'https://housingconnect.nyc.gov' },
      { label: 'NYC HPD Affordable Housing', href: 'https://www.nyc.gov/site/hpd/renters/affordable-housing.page' },
      { label: 'HUD Income Limits', href: 'https://www.huduser.gov/portal/datasets/il.html' },
    ],
  },
  {
    heading: 'Renter Resources',
    links: [
      NYC_HPD_TENANT_RIGHTS_LINK,
      { label: 'NYS AG Tenant Guide', href: 'https://ag.ny.gov/publications/residential-tenants-rights-guide' },
    ],
  },
  STANDARD_ABOUT_COLUMN,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NYC Affordable Housing Eligibility Calculator',
  url: 'https://www.nyc-affordability.com/affordable/',
  description: 'Find your AMI percentage, check Housing Connect AMI band eligibility, and see HPD affordable rent tables for NYC affordable housing lotteries.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  areaServed: { '@type': 'City', name: 'New York City', sameAs: 'https://www.wikidata.org/wiki/Q60' },
};
---
<BaseLayout
  variant="app"
  ads
  pageTitle="NYC Affordable Housing Eligibility Calculator | AMI & Housing Connect Bands"
  metaDescription="Free NYC affordable housing eligibility calculator. Enter your household size and income to find your AMI percentage, check Housing Connect eligibility across income bands, and see HPD affordable rent tables."
  canonicalPath="/affordable/"
  ogTitle="NYC Affordable Housing Eligibility Calculator | AMI & Housing Connect"
  ogDescription="Find your AMI percentage, check Housing Connect band eligibility, and see HPD affordable rent tables for NYC affordable housing."
  ogImage="/images/affordable-og.png"
  ogImageAlt="NYC Affordable Housing Calculator — enter household size and income to find AMI percentage and Housing Connect band eligibility."
  twitterTitle="NYC Affordable Housing Calculator"
  twitterDescription="Find your AMI percentage and check Housing Connect eligibility for NYC affordable housing."
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
<AppHeader titleHtml="NYC <em>Affordable</em> Housing Finder" tagline="Calculate your AMI percentage and check Housing Connect eligibility across all income bands." />
<Breadcrumbs items={breadcrumbItems} padded />

<main class="app-layout">

  <!-- ===== INPUTS PANEL ===== -->
  <div class="inputs-panel">

    <!-- Card 1: Household -->
    <div class="card">
      <div class="card-title" id="card-title-1" aria-expanded="true" aria-controls="card-body-1">
        <span class="snum">1</span> Your Household
        <span class="card-chev" aria-hidden="true">▲</span>
      </div>
      <div class="card-body" id="card-body-1">
        <div class="form-row">
          <label class="lbl" for="hh-size">Household size<small>Total people who will live in the unit</small></label>
          <div class="iw">
            <select id="hh-size" class="w120">
              <option value="1">1 person</option>
              <option value="2" selected>2 persons</option>
              <option value="3">3 persons</option>
              <option value="4">4 persons</option>
              <option value="5">5 persons</option>
              <option value="6">6 persons</option>
              <option value="7">7 persons</option>
              <option value="8">8 persons</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <label class="lbl" for="annual-income">Annual household income<small>Combined gross income of all members, pre-tax</small></label>
          <div class="iw"><span class="px">$</span><input type="number" id="annual-income" class="w120" min="0" step="1000" value="80000"></div>
        </div>
      </div>
    </div>

    <!-- Card 2: Target & Preferences -->
    <div class="card">
      <div class="card-title" id="card-title-2" aria-expanded="true" aria-controls="card-body-2">
        <span class="snum">2</span> Target &amp; Preferences
        <span class="card-chev" aria-hidden="true">▲</span>
      </div>
      <div class="card-body" id="card-body-2">
        <div class="form-row">
          <label class="lbl" for="unit-size">Unit size<small>Used to calculate affordable rent in the Rent Table tab</small></label>
          <div class="iw">
            <select id="unit-size" class="w120">
              <option value="studio">Studio / 0 BR</option>
              <option value="1br" selected>1 Bedroom</option>
              <option value="2br">2 Bedrooms</option>
              <option value="3br">3 Bedrooms</option>
              <option value="4br">4 Bedrooms</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <label class="lbl" for="borough">Target borough<small>For Housing Connect searches — does not change AMI income limits</small></label>
          <div class="iw">
            <select id="borough" class="w160">
              <option value="any" selected>Any / Citywide</option>
              <option value="manhattan">Manhattan</option>
              <option value="brooklyn">Brooklyn</option>
              <option value="queens">Queens</option>
              <option value="bronx">The Bronx</option>
              <option value="staten-island">Staten Island</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <label class="lbl" for="target-band">Target AMI band<small>The band you want to apply for on Housing Connect</small></label>
          <div class="iw">
            <select id="target-band" class="w120">
              <option value="30">30% AMI</option>
              <option value="40">40% AMI</option>
              <option value="50">50% AMI</option>
              <option value="60" selected>60% AMI</option>
              <option value="70">70% AMI</option>
              <option value="80">80% AMI</option>
              <option value="90">90% AMI</option>
              <option value="100">100% AMI</option>
              <option value="110">110% AMI</option>
              <option value="120">120% AMI</option>
              <option value="130">130% AMI</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 3: AMI Reference Values -->
    <div class="card">
      <div class="card-title" id="card-title-3" aria-expanded="true" aria-controls="card-body-3">
        <span class="snum">3</span> AMI Reference Values
        <span class="card-chev" aria-hidden="true">▲</span>
      </div>
      <div class="card-body" id="card-body-3">
        <div class="acct-wrap">
          <table class="ami-ref-tbl" aria-label="100% AMI income limits by household size">
            <thead>
              <tr>
                <th>Household</th>
                <th class="r">100% AMI limit</th>
              </tr>
            </thead>
            <tbody id="ami-ref-tbody"></tbody>
          </table>
        </div>
        <p class="ref-note">
          HUD FY2024 income limits for New York HMFA, used by NYC HPD for Housing Connect. Edit any value to override with updated figures.
          <a href="https://www.huduser.gov/portal/datasets/il.html" target="_blank" rel="noopener noreferrer">HUD source ↗</a> ·
          <a href="https://www.nyc.gov/site/hpd/renters/affordable-housing.page" target="_blank" rel="noopener noreferrer">NYC HPD ↗</a>
        </p>
      </div>
    </div>

  </div><!-- /inputs-panel -->

  <!-- ===== RESULTS PANEL ===== -->
  <div class="results-panel">

    <div class="results-tabs" role="tablist" aria-label="Results views">
      <button class="tab-btn active" id="tab-eligibility" role="tab" aria-selected="true"
              aria-controls="view-eligibility" tabindex="0" data-tab="eligibility">Eligibility</button>
      <button class="tab-btn" id="tab-rents" role="tab" aria-selected="false"
              aria-controls="view-rents" tabindex="-1" data-tab="rents">Rent Table</button>
    </div>

    <!-- ── Eligibility Tab ── -->
    <div class="results-card" id="view-eligibility" role="tabpanel" aria-labelledby="tab-eligibility">

      <!-- Hero -->
      <div class="hero">
        <div class="hero-eyebrow">Your AMI Percentage</div>
        <div class="hero-price" id="hero-ami-pct">—%</div>
        <span class="hero-mo">of area median income</span>
        <div id="hero-band-pill-wrap" style="margin-top:4px"></div>
      </div>

      <!-- AMI Meter -->
      <div class="ami-meter-outer">
        <div class="ami-track" aria-hidden="true">
          <div class="ami-seg eli">ELI</div>
          <div class="ami-seg vli">VLI</div>
          <div class="ami-seg li">LI</div>
          <div class="ami-seg mod">Moderate</div>
          <div class="ami-seg mi">Middle</div>
        </div>
        <div class="ami-marker-row">
          <div class="ami-marker-ptr" id="ami-marker-ptr" style="left:50%"></div>
          <div class="ami-marker-label" id="ami-marker-label" style="left:50%"></div>
        </div>
        <div class="ami-seg-labels" aria-hidden="true">
          <div class="ami-seg-label eli">≤30%</div>
          <div class="ami-seg-label vli">50%</div>
          <div class="ami-seg-label li">80%</div>
          <div class="ami-seg-label mod">120%</div>
          <div class="ami-seg-label mi">165%+</div>
        </div>
      </div>

      <div class="results-body">

        <!-- Income summary -->
        <div class="snap-block">
          <div class="snap-title">Income Summary</div>
          <div class="snap-row highlight">
            <span class="sr-lbl">Your AMI percentage</span>
            <span class="sr-val" id="s-ami-pct">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">Annual household income</span>
            <span class="sr-val" id="s-income">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">100% AMI (<span id="s-hh-size-lbl">2</span>-person household)</span>
            <span class="sr-val" id="s-hh-100-ami">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">Income band classification</span>
            <span class="sr-val" id="s-band-class">—</span>
          </div>
        </div>

        <hr class="snap-div">

        <!-- Target band result -->
        <div class="snap-title" style="margin-bottom:8px">Your Target Band</div>
        <div id="target-result" class="target-result ok">
          <div class="tr-icon" id="tr-icon">—</div>
          <div class="tr-title" id="tr-title">—</div>
          <div class="tr-sub" id="tr-sub">—</div>
        </div>

        <hr class="snap-div">

        <!-- All bands -->
        <div class="feas-title">All Housing Connect Bands</div>
        <div class="band-list" id="band-list" role="list" aria-label="Housing Connect AMI band eligibility"></div>

        <div class="info-note">
          <strong>Note:</strong> Eligibility is based on HPD income limits only. Individual listings on
          <a href="https://housingconnect.nyc.gov" target="_blank" rel="noopener noreferrer">housingconnect.nyc.gov ↗</a>
          may also require a minimum income (typically 40× the monthly rent). Household size and unit occupancy standards vary by building.
          <span id="borough-note"></span>
        </div>

      </div><!-- /results-body -->
    </div><!-- /view-eligibility -->

    <!-- ── Rent Table Tab ── -->
    <div class="results-card" id="view-rents" role="tabpanel" aria-labelledby="tab-rents" hidden>
      <div class="results-body">

        <div class="snap-title" style="margin-bottom:6px">HPD Affordable Rent Framework</div>
        <p class="rent-tbl-intro">
          Max affordable monthly rent by unit size and AMI band. Calculated as <strong>30% of gross income at each AMI level</strong>,
          using the standard occupancy per unit type (Studio = 1 person, 1BR = 2, 2BR = 3, 3BR = 4, 4BR = 5).
          Your target band is highlighted in blue; your selected unit size row is shaded.
        </p>

        <div class="rent-tbl-wrap" id="rent-tbl-wrap"></div>

        <p class="rent-tbl-note">
          Rents on Housing Connect may differ; this reflects HPD's standard rent calculation methodology.
          <a href="https://www.nyc.gov/site/hpd/renters/affordable-housing.page" target="_blank" rel="noopener noreferrer">HPD affordable housing ↗</a>
        </p>

      </div>
    </div><!-- /view-rents -->

  </div><!-- /results-panel -->

</main>

<!-- ===== INFO COLLAPSIBLES ===== -->
<div class="info-wrap">

  <button class="info-btn" id="how-btn" aria-expanded="false" aria-controls="how-body" type="button">
    <em class="info-caret" aria-hidden="true">▼</em> How This Calculator Works
  </button>
  <div class="info-body" id="how-body" role="region" aria-labelledby="how-btn">
    <h3>What Is AMI?</h3>
    <p>AMI stands for <strong>Area Median Income</strong> — the midpoint income for a family of four in a given metro area, as calculated annually by HUD. NYC's affordable housing programs use the AMI for the New York HMFA (HUD Metro Fair Market Rent Area). In FY2024, the 4-person 100% AMI is $134,800. See our <a href="/guides/nyc-ami-housing-connect-explained/">full AMI &amp; Housing Connect guide</a> for the complete income table by household size and how band eligibility works.</p>
    <h3>How Your AMI% Is Calculated</h3>
    <p>Your AMI percentage = (your annual household income ÷ 100% AMI limit for your household size) × 100. The AMI limit scales with household size using HUD's standard adjustment factors: 70% for 1 person, 80% for 2, 90% for 3, 100% for 4, 108% for 5, and so on.</p>
    <h3>Income Band Classifications</h3>
    <ul>
      <li><strong>ELI — Extremely Low Income:</strong> ≤ 30% AMI</li>
      <li><strong>VLI — Very Low Income:</strong> 31–50% AMI</li>
      <li><strong>LI — Low Income:</strong> 51–80% AMI</li>
      <li><strong>Moderate Income:</strong> 81–120% AMI</li>
      <li><strong>Middle Income:</strong> 121–165% AMI</li>
    </ul>
    <h3>Housing Connect Eligibility</h3>
    <p>NYC HPD's Housing Connect lists affordable units with income requirements. Each lottery specifies an AMI band (e.g., 60% AMI). To qualify, your income must be <em>at or below</em> the income limit for that band and your household size. Many listings also set a minimum income — typically 40× the monthly rent — to confirm you can afford the unit. See our <a href="/guides/nyc-40x-rent-rule/">40x rent rule guide</a> for how that minimum-income screen works.</p>
    <h3>Rent Table</h3>
    <p>Affordable rents are computed as 30% of gross income at each AMI level, using the standard occupancy for each unit type. This is the methodology HPD uses to set rents on Housing Connect; actual rents may vary slightly by building.</p>
    <h3>Borough Preference</h3>
    <p>HUD AMI income limits are the same across all five NYC boroughs. Your borough preference is just a reminder for filtering on Housing Connect — it does not affect any calculations here.</p>
  </div>

  <button class="info-btn" id="assump-btn" aria-expanded="false" aria-controls="assump-body" type="button">
    <em class="info-caret" aria-hidden="true">▼</em> Assumptions &amp; Sources
  </button>
  <div class="info-body" id="assump-body" role="region" aria-labelledby="assump-btn">
    <dl class="sources-dl">
      <dt>HUD Income Limits (AMI Reference)</dt>
      <dd>HUD FY2024 Income Limits for New York HMFA. 4-person 100% AMI = $134,800. Limits adjusted by household size per HUD standard factors.
        <a href="https://www.huduser.gov/portal/datasets/il.html" target="_blank" rel="noopener noreferrer">huduser.gov ↗</a></dd>
      <dt>HPD Affordable Rent Methodology</dt>
      <dd>Affordable rent = (100% AMI × AMI band%) × 30% ÷ 12. Standard occupancy: Studio = 1 person, 1BR = 2, 2BR = 3, 3BR = 4, 4BR = 5.
        <a href="https://www.nyc.gov/site/hpd/renters/affordable-housing.page" target="_blank" rel="noopener noreferrer">NYC HPD ↗</a></dd>
      <dt>Housing Connect</dt>
      <dd>NYC HPD's lottery platform for affordable housing. Apply at
        <a href="https://housingconnect.nyc.gov" target="_blank" rel="noopener noreferrer">housingconnect.nyc.gov ↗</a></dd>
      <dt>Income Band Definitions</dt>
      <dd>ELI ≤ 30%, VLI 31–50%, LI 51–80%, Moderate 81–120%, Middle 121–165%. Source: NYC HPD affordable housing guidelines.</dd>
      <dt>HUD Household Size Adjustment Factors</dt>
      <dd>1 person = 70%, 2 = 80%, 3 = 90%, 4 = 100%, 5 = 108%, 6 = 116%, 7 = 124%, 8 = 132% of 4-person AMI.
        <a href="https://www.huduser.gov/portal/datasets/il.html" target="_blank" rel="noopener noreferrer">HUD ↗</a></dd>
    </dl>
    <p style="margin-top:10px;font-size:11px;color:var(--g400)">Income limits change annually. Verify current limits with NYC HPD or HUD before applying to any program. This calculator is for informational purposes only. See our <a href="/about/">full sourcing methodology</a> for where every default above comes from.</p>
  </div>

</div><!-- /info-wrap -->

<AdSlot maxWidth="1300px" sidePadding="20px" />

<Footer
  variant="app"
  disclaimer="Income limits are based on HUD FY2024 data and change annually. This calculator is for informational purposes only and does not constitute financial, legal, or housing advice. Always verify current AMI limits with NYC HPD or HUD before applying to affordable housing programs."
  columns={footerColumns}
/>
</BaseLayout>

<script>
  import '../../scripts/affordable';
</script>

<style>
:global(.app-header .tagline) { display: none; }
@media (min-width: 700px) { :global(.app-header .tagline) { display: block; } }

/* ===== MAIN LAYOUT ===== */
main.app-layout {
  display: grid;
  grid-template-columns: 1fr 440px;
  gap: 20px;
  max-width: 1300px;
  margin: 20px auto;
  padding: 0 20px 60px;
  align-items: start;
}
@media (max-width: 1060px) {
  main.app-layout { grid-template-columns: 1fr; }
}

.inputs-panel { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.results-panel {
  position: sticky;
  top: calc(var(--header-h) + 20px);
  max-height: calc(100vh - var(--header-h) - 40px);
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--g300) transparent;
}
@media (max-width: 1060px) { .results-panel { position: static; max-height: none; } }

/* ===== INFO COLLAPSIBLES ===== */
.info-wrap { max-width: 1300px; margin: 0 auto 20px; padding: 0 20px; }
.info-btn {
  display: flex; align-items: center; gap: 6px;
  width: 100%; text-align: left;
  background: none; border: none; cursor: pointer;
  font-size: 13px; color: var(--blue);
  font-family: inherit; font-weight: 500; padding: 8px 0;
}
.info-btn:hover { color: #1d4ed8; }
.info-caret { transition: transform .2s; font-style: normal; }
.info-btn.open .info-caret { transform: rotate(180deg); }
.info-body {
  display: none; background: #fff;
  border: 1px solid var(--border); border-radius: var(--r);
  padding: 16px 20px; font-size: 13px; color: var(--g600); line-height: 1.65;
}
.info-body.open { display: block; }
.info-body h3 { font-size: 13px; font-weight: 700; color: var(--g800); margin: 12px 0 4px; }
.info-body h3:first-child { margin-top: 0; }
.info-body p { margin-bottom: 7px; }
.info-body ul { padding-left: 18px; margin-bottom: 7px; }
.info-body li { margin-bottom: 3px; }
.info-body a { color: var(--blue); }
.sources-dl dt { font-weight: 700; color: var(--g700); font-size: 12px; margin-top: 8px; }
.sources-dl dd { padding-left: 12px; font-size: 12px; color: var(--g500); margin-top: 2px; }
.sources-dl dd a { color: var(--blue); }

/* ===== INPUT CARD ===== */
.card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05);
  overflow: hidden;
}
.card-title {
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 1px;
  color: var(--g500);
  padding: 12px 16px 11px;
  border-bottom: 1px solid var(--g100);
  display: flex; align-items: center; gap: 8px;
  cursor: pointer; user-select: none;
  transition: background .12s;
}
.card-title:hover { background: var(--g50); }
.snum {
  background: var(--afi-dark); color: #fff;
  border-radius: 50%; width: 17px; height: 17px;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 700; flex-shrink: 0;
}
.card-chev { font-size: 10px; color: var(--g400); margin-left: auto; transition: transform .2s; }
.card-chev.open { transform: rotate(180deg); }
.card-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
.card-body.collapsed { display: none; }

/* ===== FORM ROWS ===== */
.form-row { display: flex; align-items: flex-start; gap: 10px; }
.lbl {
  flex: 1;
  font-size: 12.5px; color: var(--g700); font-weight: 500;
  padding-top: 8px;
}
.lbl small {
  display: block; font-size: 11px;
  color: var(--g400); font-weight: 400;
  margin-top: 2px; line-height: 1.4;
}
.iw {
  display: flex; align-items: stretch;
  border: 1px solid var(--g300); border-radius: 5px;
  background: #fff; overflow: hidden; flex-shrink: 0;
  transition: border-color .15s, box-shadow .15s;
}
.iw:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,.12); }
.iw .px, .iw .sx {
  background: var(--g50); padding: 0 8px;
  font-size: 13px; color: var(--g500); font-weight: 500;
  display: flex; align-items: center; user-select: none; white-space: nowrap;
}
.iw .px { border-right: 1px solid var(--g200); }
.iw .sx { border-left:  1px solid var(--g200); }
.iw input, .iw select {
  border: none; outline: none; background: transparent;
  padding: 7px 9px; font-size: 13px; font-family: inherit;
  color: var(--g900); min-width: 0; -moz-appearance: textfield;
}
.iw input::-webkit-inner-spin-button,
.iw input::-webkit-outer-spin-button { -webkit-appearance: none; }
.iw select { cursor: pointer; }
.w80  { width: 80px; }
.w100 { width: 100px; }
.w120 { width: 120px; }
.w160 { width: 160px; }

/* AMI Reference table */
.ami-ref-tbl { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.ami-ref-tbl th {
  text-align: left; font-size: 10px; font-weight: 600;
  color: var(--g400); text-transform: uppercase; letter-spacing: 0.5px;
  padding: 3px 6px 7px; border-bottom: 1px solid var(--g200); white-space: nowrap;
}
.ami-ref-tbl th.r { text-align: right; }
/* tbody rows are injected via innerHTML at runtime — stays :global(). */
:global(.ami-ref-tbl td) { padding: 3px 3px; vertical-align: middle; }
:global(.ami-ref-tbl td.hh-lbl) { padding: 3px 6px; font-size: 12.5px; color: var(--g700); }
:global(.ami-ref-tbl td input[type="number"]) {
  border: 1px solid var(--g200); border-radius: 4px;
  padding: 5px 7px; font-size: 12px; color: var(--g800);
  outline: none; text-align: right; width: 96px;
