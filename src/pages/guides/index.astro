---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { ALL_CALCULATORS, ALL_GUIDES, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';
import { AD_MULTIPLEX_HORIZONTAL } from '../../lib/adSlots';
import { buildBreadcrumbJsonLd } from '../../lib/breadcrumbs';

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: ALL_CALCULATORS },
  { heading: 'Guides', links: ALL_GUIDES },
  STANDARD_ABOUT_COLUMN,
];

const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const guides = allGuides.sort(
  (a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime()
);

const formatUpdated = (updated: string) =>
  new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const SITE_ORIGIN = 'https://www.nyc-affordability.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'NYC Housing Guides',
  url: `${SITE_ORIGIN}/guides/`,
  description: 'Sourced explainers on NYC housing rules — mansion tax, closing costs, board requirements, and more.',
  isPartOf: { '@type': 'WebSite', name: 'NYC Affordability', url: `${SITE_ORIGIN}/` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((guide, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_ORIGIN}/guides/${guide.id}/`,
      name: guide.data.title,
    })),
  },
};

const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---
<BaseLayout
  variant="site"
  ads
  pageTitle="NYC Housing Guides | NYC Affordability"
  metaDescription="Sourced explainers on NYC housing rules — mansion tax tiers, closing costs, board requirements, and more — with the same math and defaults used across our calculators."
  canonicalPath="/guides/"
  ogTitle="NYC Housing Guides"
  ogDescription="Sourced explainers on NYC housing rules — mansion tax tiers, closing costs, board requirements, and more."
  ogImage="/images/general-og.png"
  ogImageAlt="NYC Housing Guides from NYC Affordability."
  twitterTitle="NYC Housing Guides"
  twitterDescription="Sourced explainers on NYC housing rules — mansion tax tiers, closing costs, board requirements, and more."
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
<SiteHeader />

<main>
<div class="hero">
  <div class="hero-eyebrow">Guides</div>
  <h2>Sourced explainers on how<br>NYC housing rules actually work.</h2>
  <p>Plain-language breakdowns of the taxes, rules, and thresholds that drive the math in our calculators — mansion tax cliffs, closing costs, board requirements, and more — each one backed by a named, checkable source.</p>
</div>

<div class="page">

  <Breadcrumbs items={breadcrumbItems} />

  {guides.length === 0 ? (
    <div class="card">
      <h3>Guides are coming soon</h3>
      <p>We're working on the first batch of sourced explainers. In the meantime, try one of the <a href="/">calculators</a>.</p>
    </div>
  ) : (
    guides.map((guide) => (
      <a class="card guide-card" href={`/guides/${guide.id}/`}>
        <div class="guide-card-eyebrow">Guide</div>
        <h3>{guide.data.title}</h3>
        <p>{guide.data.metaDescription}</p>
        <div class="guide-card-footer">
          <span class="updated">Last updated: {formatUpdated(guide.data.updated)}</span>
          <span class="read-link">Read the guide &rarr;</span>
        </div>
      </a>
    ))
  )}

  {guides.length > 0 && (
    <div style="margin-bottom:20px;">
      <AdSlot slot={AD_MULTIPLEX_HORIZONTAL} format="multiplex" maxWidth="100%" sidePadding="0" />
    </div>
  )}

  <div class="card">
    <h3>Run your own numbers</h3>
    <p>Every guide here feeds into the same calculators, so once you understand a rule you can see exactly how it affects your max price or affordable rent.</p>
    <div class="tool-grid">
      <a href="/coop/">NYC Co-op Affordability</a>
      <a href="/condo/">NYC Condo Affordability</a>
      <a href="/rent/">NYC Rent Affordability</a>
      <a href="/affordable/">NYC Affordable Housing Finder</a>
      <a href="/compare/">Compare All Options</a>
      <a href="/sell/">NYC Sale Net Proceeds</a>
      <a href="/">NYC Affordability Hub</a>
    </div>
  </div>

</div>
</main>

<Footer
  variant="site"
  disclaimer="These calculators are for informational purposes only and do not constitute financial, legal, or mortgage advice. Always verify all figures with a licensed mortgage professional and real estate attorney before making housing decisions."
  columns={footerColumns}
/>
</BaseLayout>

<style>
.hero {
  background: linear-gradient(160deg, var(--navy) 0%, #0d1f3c 55%, #142240 100%);
  padding: 52px 24px 44px; text-align: center; color: #e2e8f0;
}
.hero-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
.hero h2 { font-size: clamp(26px, 4.5vw, 40px); font-weight: 800; letter-spacing: -1px; line-height: 1.15; margin-bottom: 14px; color: #f0f9ff; }
.hero p { font-size: 15px; color: #93b4d0; max-width: 640px; margin: 0 auto; line-height: 1.7; }

.page { max-width: 820px; margin: 0 auto; padding: 44px 24px 64px; flex: 1; }

.card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 28px 28px 30px; margin-bottom: 20px;
}
.card h3 { font-size: 17px; font-weight: 800; color: var(--g900); margin-bottom: 10px; letter-spacing: -.2px; }
.card p { font-size: 14px; color: var(--g600); line-height: 1.75; margin-bottom: 10px; }
.card p:last-child { margin-bottom: 0; }
.card a { color: var(--blue); text-decoration: none; }
.card a:hover { text-decoration: underline; }

.guide-card {
  display: block; text-decoration: none; color: inherit;
  transition: transform .18s, box-shadow .18s;
}
.guide-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.1); }
.guide-card:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
.guide-card-eyebrow {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
  color: var(--blue); margin-bottom: 8px;
}
.guide-card h3 { margin-bottom: 8px; }
.guide-card p { margin-bottom: 16px; }
.guide-card-footer {
  display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  padding-top: 14px; border-top: 1px solid var(--border);
}
.guide-card-footer .updated { font-size: 11px; color: var(--g500); letter-spacing: .3px; }
.guide-card-footer .read-link { font-size: 13px; font-weight: 700; color: var(--blue); }

.tool-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; margin-top: 6px; }
.tool-grid a {
  display: block; padding: 9px 12px; border: 1px solid var(--border); border-radius: 6px;
  font-weight: 650; font-size: 13.5px; color: var(--g800); text-decoration: none; background: var(--g50);
}
.tool-grid a:hover { border-color: var(--blue-lt); background: var(--blue-lt); color: var(--blue); }

@media (max-width: 560px) {
  .card { padding: 22px 18px 24px; }
  .tool-grid { grid-template-columns: 1fr; }
}
</style>
