---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { ALL_CALCULATORS, ALL_GUIDES, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';
import { AD_IN_ARTICLE } from '../../lib/adSlots';
import { buildBreadcrumbJsonLd } from '../../lib/breadcrumbs';

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: ALL_CALCULATORS },
  { heading: 'Guides', links: ALL_GUIDES },
  STANDARD_ABOUT_COLUMN,
];

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { data } = guide;
const { Content } = await render(guide);

const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const relatedGuides = data.relatedGuides
  .map((slug) => allGuides.find((g) => g.id === slug))
  .filter((g) => g !== undefined);

const canonicalPath = `/guides/${guide.id}/`;
const updatedLabel = new Date(`${data.updated}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const SITE_ORIGIN = 'https://www.nyc-affordability.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.metaDescription,
  url: `${SITE_ORIGIN}${canonicalPath}`,
  datePublished: data.updated,
  dateModified: data.updated,
  isPartOf: { '@type': 'WebSite', name: 'NYC Affordability', url: `${SITE_ORIGIN}/` },
};

const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
  { name: data.title, path: canonicalPath },
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---
<BaseLayout
  variant="site"
  ads
  robots={data.draft ? 'noindex, nofollow' : undefined}
  pageTitle={`${data.title} | NYC Affordability`}
  metaDescription={data.metaDescription}
  canonicalPath={canonicalPath}
  ogTitle={data.ogTitle ?? data.title}
  ogDescription={data.ogDescription ?? data.metaDescription}
  ogImage={data.ogImage}
  ogImageAlt={data.ogImageAlt ?? data.title}
  twitterTitle={data.twitterTitle ?? data.title}
  twitterDescription={data.twitterDescription ?? data.metaDescription}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
<SiteHeader />

<main>
<div class="hero">
  <div class="hero-eyebrow">Guide</div>
  <h2>{data.title}</h2>
  <p>{data.intro}</p>
  <span class="updated">Last updated: {updatedLabel}</span>
</div>

<div class="page">

  <Breadcrumbs items={breadcrumbItems} />

  <div class="card guide-body">
    <Content />
  </div>

  <div style="margin-bottom:20px;">
    <AdSlot slot={AD_IN_ARTICLE} format="in-article" maxWidth="100%" sidePadding="0" />
  </div>

  <div class="card">
    <h3>Sources</h3>
    <ul>
      {data.sources.map((source) => (
        <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>
      ))}
    </ul>
  </div>

  {relatedGuides.length > 0 && (
    <div class="card">
      <h3>Related guides</h3>
      <ul class="related-list">
        {relatedGuides.map((related) => (
          <li><a href={`/guides/${related.id}/`}>{related.data.title}</a></li>
        ))}
      </ul>
    </div>
  )}

  <div class="cta-box">
    <h3>{data.cta.heading}</h3>
    <p>{data.cta.body}</p>
    <a class="cta-button" href={data.cta.href}>{data.cta.label} &rarr;</a>
  </div>

</div>
</main>

<Footer
  variant="site"
  disclaimer="These calculators are for informational purposes only and do not constitute financial, legal, or mortgage advice. Always verify all figures with a licensed mortgage professional and real estate attorney before making housing decisions."
  columns={footerColumns}
/>
</BaseLayout>

<style>
.hero {
  background: linear-gradient(160deg, var(--navy) 0%, #0d1f3c 55%, #142240 100%);
  padding: 52px 24px 44px; text-align: center; color: #e2e8f0;
}
.hero-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
.hero h2 { font-size: clamp(26px, 4.5vw, 40px); font-weight: 800; letter-spacing: -1px; line-height: 1.15; margin-bottom: 14px; color: #f0f9ff; }
.hero p { font-size: 15px; color: #93b4d0; max-width: 640px; margin: 0 auto; line-height: 1.7; }
.hero .updated { display: inline-block; margin-top: 16px; font-size: 11px; color: #6b8ab8; letter-spacing: .4px; }

.page { max-width: 820px; margin: 0 auto; padding: 44px 24px 64px; flex: 1; }

.card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 28px 28px 30px; margin-bottom: 20px;
}
.card h3 { font-size: 17px; font-weight: 800; color: var(--g900); margin-bottom: 10px; letter-spacing: -.2px; }
.card p { font-size: 14px; color: var(--g600); line-height: 1.75; margin-bottom: 10px; }
.card p:last-child { margin-bottom: 0; }
.card ul, .card ol { padding-left: 20px; color: var(--g600); font-size: 14px; line-height: 1.75; margin-bottom: 10px; }
.card li { margin-bottom: 4px; }
.card a { color: var(--blue); text-decoration: none; }
.card a:hover { text-decoration: underline; }

/* Section headings inside markdown guide body (## in .md renders as h2) */
.guide-body :global(h2) {
  font-size: 17px; font-weight: 800; color: var(--g900);
  letter-spacing: -.2px; margin-bottom: 10px; margin-top: 24px;
}
.guide-body :global(h2:first-child) { margin-top: 0; }
.guide-body :global(p) { font-size: 14px; color: var(--g600); line-height: 1.75; margin-bottom: 10px; }
.guide-body :global(ul), .guide-body :global(ol) { padding-left: 20px; color: var(--g600); font-size: 14px; line-height: 1.75; margin-bottom: 10px; }
.guide-body :global(li) { margin-bottom: 4px; }
.guide-body :global(a) { color: var(--blue); text-decoration: none; }
.guide-body :global(a:hover) { text-decoration: underline; }
.guide-body :global(table) {
  width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 13.5px;
}
.guide-body :global(th), .guide-body :global(td) {
  text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--border);
}
.guide-body :global(th) {
  font-weight: 700; color: var(--g900); background: var(--g50);
}
.guide-body :global(td) { color: var(--g600); }
.guide-body :global(tr:last-child td) { border-bottom: none; }

@media (max-width: 560px) {
  .guide-body :global(table) { font-size: 12.5px; }
  .guide-body :global(th), .guide-body :global(td) { padding: 7px 8px; }
}

.cta-box {
  background: var(--blue-xlt); border: 1px solid var(--blue-lt); border-radius: var(--r);
  padding: 26px 28px 28px; text-align: center;
}
.cta-box h3 { font-size: 17px; font-weight: 800; color: var(--g900); margin-bottom: 8px; letter-spacing: -.2px; }
.cta-box p { font-size: 14px; color: var(--g600); line-height: 1.6; margin-bottom: 16px; max-width: 480px; margin-left: auto; margin-right: auto; }
.cta-button {
  display: inline-block; background: var(--blue); color: #fff; font-weight: 700; font-size: 14px;
  padding: 11px 22px; border-radius: 8px; text-decoration: none;
}
.cta-button:hover { opacity: .9; }

@media (max-width: 560px) {
  .card { padding: 22px 18px 24px; }
  .cta-box { padding: 22px 18px 24px; }
}
</style>
