---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import AppHeader from '../../components/AppHeader.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { CALC_SAVINGS_PLANNER, otherCalculators, ALL_GUIDES, EXPLORE_LINKS, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';
import { ASSUMPTIONS as A } from '../../data/assumptions';

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: otherCalculators(CALC_SAVINGS_PLANNER.href!) },
  { heading: 'Guides', links: ALL_GUIDES },
  { heading: 'Explore', links: EXPLORE_LINKS },
  STANDARD_ABOUT_COLUMN,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NYC Down Payment & Home Purchase Savings Planner',
  url: 'https://www.nyc-affordability.com/savings-planner/',
  description: 'How long until you can afford to buy in NYC? Total cash needed for a co-op or condo (down payment, closing costs, mansion tax, co-op board reserves), your savings timeline, and the monthly savings needed to hit a target date.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  areaServed: { '@type': 'City', name: 'New York City', sameAs: 'https://www.wikidata.org/wiki/Q60' },
};
---
<BaseLayout
  variant="app"
  ads
  pageTitle="NYC Down Payment Savings Planner: How Long Until I Can Buy? | NYC Affordability"
  metaDescription="How long until you can afford a NYC co-op or condo? Total cash needed (down payment, closing costs, mansion tax, board reserves), your savings timeline, and the monthly savings to hit a target date."
  canonicalPath="/savings-planner/"
  ogTitle="How Long Until I Can Buy in NYC?"
  ogDescription="Total cash needed for a NYC co-op or condo, your savings timeline, and the monthly savings to hit a target date."
  ogImage="/images/general-og.png"
  ogImageAlt="NYC Affordability calculators for rent, co-op, and condo housing."
  twitterTitle="How Long Until I Can Buy in NYC?"
  twitterDescription="Total cash needed for a NYC co-op or condo, your savings timeline, and the monthly savings to hit a target date."
  jsonLd={jsonLd}
>
<AppHeader
  titleHtml="NYC <em>Savings</em> Planner"
  tagline="How long until you can afford to buy, and what it takes to get there sooner."
  showSaveToggle
/>

<main class="page">
  <section class="hero">
    <div class="eyebrow">Down payment &amp; purchase savings</div>
    <h2>How long until you can actually buy?</h2>
    <p>In NYC the down payment is only part of the cash you need. Closing costs, mansion tax at $1M+, mortgage recording tax on condos, and a co-op board's post-closing reserves all have to be in the bank too. This adds it all up with the same engine as the <a href="/coop/">co-op</a> and <a href="/condo/">condo</a> calculators, then projects when your savings get there.</p>
  </section>

  <div class="layout">
    <section class="section-card" aria-labelledby="h-inputs">
      <div class="section-title" id="h-inputs">Your plan</div>
      <div class="editor-body">
        <fieldset class="type-toggle">
          <legend>Buying a</legend>
          <label><input type="radio" name="sp-type" value="coop"> Co-op</label>
          <label><input type="radio" name="sp-type" value="condo" checked> Condo</label>
        </fieldset>
        <div class="editor-grid">
          <div class="field">
            <label for="sp-price">Target purchase price</label>
            <div class="input-wrap"><span>$</span><input type="number" id="sp-price" min="0" step="10000" inputmode="numeric"></div>
          </div>
          <div class="field">
            <label for="sp-savings">Saved so far</label>
            <div class="input-wrap"><span>$</span><input type="number" id="sp-savings" min="0" step="1000" inputmode="numeric"></div>
            <small>Cash and investments you'd use</small>
          </div>
          <div class="field">
            <label for="sp-monthly">Saving per month</label>
            <div class="input-wrap"><span>$</span><input type="number" id="sp-monthly" min="0" step="100" inputmode="numeric"></div>
          </div>
          <div class="field">
            <label for="sp-yield">Yield on savings</label>
            <div class="input-wrap"><input type="number" id="sp-yield" min="0" max="20" step="0.1"><span>%/yr</span></div>
            <small>Your account's APY</small>
          </div>
          <div class="field">
            <label for="sp-income">Annual gross income</label>
            <div class="input-wrap"><span>$</span><input type="number" id="sp-income" min="0" step="1000" inputmode="numeric"></div>
          </div>
          <div class="field">
            <label for="sp-debts">Other monthly debts</label>
            <div class="input-wrap"><span>$</span><input type="number" id="sp-debts" min="0" step="50" inputmode="numeric"></div>
          </div>
          <div class="field">
            <label for="sp-emergency">Keep as emergency fund</label>
            <div class="input-wrap"><span>$</span><input type="number" id="sp-emergency" min="0" step="1000" inputmode="numeric"></div>
            <small>Left untouched after closing</small>
          </div>
          <div class="field">
            <label for="sp-date">Want to buy by <span class="optional">(optional)</span></label>
            <div class="input-wrap"><input type="month" id="sp-date"></div>
          </div>
        </div>

        <details class="assumptions">
          <summary>Assumptions <span class="muted">(defaults from <a href="/methodology/sources/">our sources page</a>)</span></summary>
          <div class="editor-grid">
            <div class="field">
              <label for="sp-raise">Income growth</label>
              <div class="input-wrap"><input type="number" id="sp-raise" min="0" max="20" step="0.5"><span>%/yr</span></div>
            </div>
            <div class="field">
              <label for="sp-pricegrowth">Home price growth</label>
              <div class="input-wrap"><input type="number" id="sp-pricegrowth" min="-10" max="20" step="0.5"><span>%/yr</span></div>
            </div>
            <div class="field">
              <label for="sp-rate">Mortgage rate</label>
              <div class="input-wrap"><input type="number" id="sp-rate" min="0" max="20" step="0.05"><span>%</span></div>
            </div>
            <div class="field">
              <label for="sp-dp">Down payment</label>
              <div class="input-wrap"><input type="number" id="sp-dp" min="0" max="100" step="1"><span>%</span></div>
            </div>
            <div class="field">
              <label for="sp-charges" id="sp-charges-label">Monthly common charges</label>
              <div class="input-wrap"><span>$</span><input type="number" id="sp-charges" min="0" step="50"></div>
            </div>
            <div class="field">
              <label for="sp-dti" id="sp-dti-label">Lender DTI limit</label>
              <div class="input-wrap"><input type="number" id="sp-dti" min="1" max="100" step="1"><span>%</span></div>
            </div>
            <div class="field coop-only">
              <label for="sp-reserves">Board reserves</label>
              <div class="input-wrap"><input type="number" id="sp-reserves" min="0" max="60" step="1"><span>mo</span></div>
            </div>
          </div>
          <p class="editor-note">Income and price growth default to 0%, so the timeline doesn't count on raises or a flat market. These assumptions apply to the type you picked; the co-op vs. condo comparison uses each type's standard defaults for the other.</p>
        </details>
        <p class="editor-note">Everything is calculated in your browser. Nothing you enter is sent anywhere.</p>
      </div>
    </section>

    <div class="results" aria-live="polite">
      <section class="section-card" aria-labelledby="h-answer">
        <div class="section-title" id="h-answer">Your answer</div>
        <div class="answer-body">
          <div class="big-label">You can buy</div>
          <div class="big-value" id="sp-when">&mdash;</div>
          <p class="headline" id="sp-headline">&mdash;</p>
          <dl class="tiles">
            <div><dt>Cash needed today</dt><dd id="sp-need">&mdash;</dd></div>
            <div><dt>Gap today</dt><dd id="sp-gap">&mdash;</dd></div>
            <div><dt>Income needed</dt><dd id="sp-incneed">&mdash;</dd></div>
            <div><dt>In your accounts after closing</dt><dd id="sp-left">&mdash;</dd></div>
          </dl>
          <p class="target-line" id="sp-target-line" hidden></p>
        </div>
      </section>
    </div>
  </div>

  <section class="section-card" aria-labelledby="h-compare">
    <div class="section-title" id="h-compare">Co-op vs. condo at the same price</div>
    <div class="compare-grid" id="sp-compare"></div>
  </section>

  <section class="section-card" aria-labelledby="h-chart">
    <div class="section-title" id="h-chart">Savings vs. cash needed</div>
    <div class="chart-body">
      <ul class="legend" aria-label="Chart legend">
        <li><span class="key key-savings"></span>Your savings</li>
        <li><span class="key key-coop"></span>Cash needed: co-op</li>
        <li><span class="key key-condo"></span>Cash needed: condo</li>
      </ul>
      <div class="chart-wrap" id="sp-chart-wrap">
        <svg id="sp-chart" role="img" aria-labelledby="sp-chart-desc"></svg>
        <div class="tooltip" id="sp-tooltip" hidden></div>
      </div>
      <p class="chart-desc" id="sp-chart-desc">&mdash;</p>
      <details class="table-view">
        <summary>Show as a table</summary>
        <div class="table-wrap"><table class="data"><thead><tr><th scope="col">Date</th><th scope="col" class="num">Your savings</th><th scope="col" class="num">Co-op cash needed</th><th scope="col" class="num">Condo cash needed</th></tr></thead><tbody id="sp-table"></tbody></table></div>
      </details>
    </div>
  </section>

  <section class="section-card" aria-labelledby="h-breakdown">
    <div class="section-title" id="h-breakdown">What the cash covers (<span id="sp-bd-type">condo</span>, today's price)</div>
    <div class="table-wrap">
      <table class="data"><tbody id="sp-breakdown"></tbody></table>
    </div>
  </section>

  <div class="actions">
    <label class="share-personal"><input type="checkbox" id="sp-share-personal"> Include my savings and income in the link</label>
    <button class="btn-share" id="sp-share" type="button">Copy scenario link</button>
    <button class="btn-share" id="sp-print" type="button">Print</button>
  </div>

  <section class="section-card" aria-labelledby="h-how">
    <div class="section-title" id="h-how">How this works</div>
    <div class="prose-body">
      <p><strong>Cash needed</strong> comes from the same engine as the <a href="/coop/">co-op</a> and <a href="/condo/">condo</a> calculators and the <a href="/buy/">price pages</a>: down payment, fixed and variable closing costs, the <a href="/guides/nyc-mansion-tax-explained/">mansion tax</a> at $1M and up, <a href="/glossary/mortgage-recording-tax/">mortgage recording tax</a> on condo loans, and for co-ops, the board's <a href="/glossary/post-closing-liquidity/">post-closing liquidity</a> ({A.coopReserveMonths.value} months of mortgage + maintenance by default). Your emergency fund is added on top.</p>
      <p><strong>Why co-ops take longer.</strong> The reserve requirement is cash that has to still be in your account after closing, on top of the down payment. At a $600,000 price that's tens of thousands of dollars, which is why the co-op line on the chart sits above the condo line even though condos add mortgage recording tax. See <a href="/guides/coop-board-reserve-requirements/">how much reserve a board requires</a>.</p>
      <p><strong>The projection</strong> compounds your savings monthly at the yield you enter, with contributions at the end of each month. "You can buy" is the first month when savings cover the cash needed <em>and</em> your income clears the DTI limit at that month's price. Raises (if you add them) land once a year. Home price growth raises the cash target as you save.</p>
      <p><strong>What it can't see:</strong> market timing, rate changes, a specific building's fees or reserve rules, or whether a lender counts your investments in full. Want to buy sooner? <a href="/afford-more/">How Do I Afford More?</a> ranks the levers. Not sure buying beats renting at all? Try <a href="/rent-vs-buy/">rent vs. buy</a>. See <a href="/methodology/">the methodology</a> for what's sourced and what's assumed.</p>
    </div>
  </section>
</main>

<AdSlot maxWidth="1300px" sidePadding="20px" />

<Footer
  variant="app"
  disclaimer="This planner is for informational purposes only and does not constitute financial, legal, investment, or mortgage advice. Savings yields, prices, and incomes change; projections are estimates using default assumptions. Verify closing costs with a real estate attorney and financing with a licensed mortgage professional."
  columns={footerColumns}
/>
</BaseLayout>

<script>
  import '../../scripts/savings-planner';
</script>

<style>
.page { max-width: 1300px; margin: 20px auto; padding: 0 20px 60px; }
.hero {
  background: linear-gradient(135deg, #0a1628 0%, #0f2a54 100%);
  border: 1px solid #1e3a5f; border-radius: var(--r); color: #e2e8f0;
  box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 16px; padding: 26px 24px 22px;
}
.eyebrow { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--gold); margin-bottom: 8px; }
.hero h2 { font-size: clamp(22px, 3.2vw, 32px); line-height: 1.15; letter-spacing: -0.5px; color: #f0f9ff; margin-bottom: 10px; }
.hero p { color: #93b4d0; max-width: 820px; font-size: 14px; line-height: 1.65; }
.hero p a { color: #cfe0fb; }

.layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 16px; align-items: start; }
.section-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.05); margin-bottom: 16px;
}
.section-title {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--g500);
  padding: 12px 18px 11px; border-bottom: 1px solid var(--g100);
}
.editor-body { padding: 16px 18px 18px; }
.editor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-bottom: 12px; }
.field label { display: block; font-size: 12px; color: var(--g700); font-weight: 650; margin-bottom: 5px; }
.field small { display: block; font-size: 11px; color: var(--g500); margin-top: 4px; }
.optional { font-weight: 400; color: var(--g500); }
.input-wrap {
  display: flex; align-items: stretch; border: 1px solid var(--g300); border-radius: 5px; background: #fff;
  overflow: hidden; transition: border-color .15s, box-shadow .15s;
}
.input-wrap:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,.12); }
.input-wrap span {
  background: var(--g50); border-right: 1px solid var(--g200); padding: 0 8px; color: var(--g500);
  font-size: 13px; font-weight: 600; display: flex; align-items: center; white-space: nowrap;
}
.input-wrap input + span { border-right: 0; border-left: 1px solid var(--g200); }
.input-wrap input { border: 0; outline: 0; padding: 9px 9px; min-width: 0; width: 100%; font: inherit; color: var(--g900); background: #fff; }
.type-toggle { border: 0; padding: 0; margin: 0 0 14px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.type-toggle legend { font-size: 12px; font-weight: 650; color: var(--g700); margin-right: 4px; float: left; padding-top: 2px; }
.type-toggle label { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 650; color: var(--g800); min-height: 32px; cursor: pointer; }
.assumptions { border-top: 1px solid var(--g100); padding-top: 12px; margin-bottom: 8px; }
.assumptions summary { cursor: pointer; font-size: 13px; font-weight: 700; color: var(--g800); margin-bottom: 12px; min-height: 28px; }
.assumptions .muted { font-weight: 400; color: var(--g500); }
.assumptions a { color: var(--blue); }
.editor-note { font-size: 12px; color: var(--g500); line-height: 1.6; margin-top: 6px; }
:global(body.type-condo) .coop-only { display: none; }

.answer-body { padding: 18px; }
.big-label { font-size: 12px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: .8px; }
.big-value { font-size: 38px; font-weight: 850; letter-spacing: -1.1px; color: var(--g900); margin: 4px 0 8px; }
.big-value.long { font-size: 24px; letter-spacing: -0.4px; line-height: 1.25; }
.headline { font-size: 14.5px; color: var(--g700); line-height: 1.6; margin-bottom: 14px; }
.headline :global(strong) { color: var(--g900); }
.headline :global(a) { color: var(--blue); }
.tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; margin: 0 0 12px; }
.tiles div { background: var(--g50); border: 1px solid var(--g100); border-radius: 6px; padding: 9px 11px; }
.tiles dt { font-size: 11px; color: var(--g500); font-weight: 650; }
.tiles dd { margin: 2px 0 0; font-size: 16px; font-weight: 800; color: var(--g900); font-variant-numeric: tabular-nums; }
.target-line { font-size: 14px; color: var(--g700); line-height: 1.6; background: var(--blue-xlt); border: 1px solid var(--blue-lt); border-radius: 6px; padding: 10px 12px; }
.target-line :global(strong) { color: var(--g900); }

.compare-grid { display: grid; grid-template-columns: 1fr 1fr; }
.compare-grid :global(.cmp) { padding: 16px 18px; }
.compare-grid :global(.cmp + .cmp) { border-left: 1px solid var(--g100); }
.compare-grid :global(.cmp h3) { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .6px; color: var(--g700); display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.compare-grid :global(.cmp .when) { font-size: 22px; font-weight: 850; color: var(--g900); margin-bottom: 6px; }
.compare-grid :global(.cmp p) { font-size: 13px; color: var(--g600); line-height: 1.6; margin-bottom: 4px; }
.compare-grid :global(.cmp strong) { color: var(--g900); }

.chart-body { padding: 14px 18px 16px; }
.legend { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0 0 8px; padding: 0; }
.legend li { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--g700); font-weight: 600; }
.key { display: inline-block; width: 18px; height: 3px; border-radius: 2px; }
.key-savings { background: #2a78d6; }
.key-coop { background: #eb6834; }
.key-condo { background: #1baf7a; }
.chart-wrap { position: relative; width: 100%; }
#sp-chart { display: block; width: 100%; height: 300px; overflow: visible; }
#sp-chart :global(.grid) { stroke: #eceae6; stroke-width: 1; }
#sp-chart :global(.axis-label) { fill: var(--g500); font-size: 11px; font-variant-numeric: tabular-nums; }
#sp-chart :global(.series) { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
#sp-chart :global(.s-savings) { stroke: #2a78d6; }
#sp-chart :global(.s-coop) { stroke: #eb6834; }
#sp-chart :global(.s-condo) { stroke: #1baf7a; }
#sp-chart :global(.dot) { stroke: #fff; stroke-width: 2; }
#sp-chart :global(.direct-label) { fill: var(--g700); font-size: 11.5px; font-weight: 700; }
#sp-chart :global(.crosshair) { stroke: var(--g400); stroke-width: 1; }
.tooltip {
  position: absolute; pointer-events: none; background: #fff; border: 1px solid var(--g200); border-radius: 6px;
  box-shadow: 0 6px 16px rgba(0,0,0,.12); padding: 8px 10px; font-size: 12px; color: var(--g800); min-width: 170px; z-index: 5;
}
.tooltip :global(.tt-date) { font-weight: 800; margin-bottom: 4px; }
.tooltip :global(.tt-row) { display: flex; justify-content: space-between; gap: 12px; font-variant-numeric: tabular-nums; }
.tooltip :global(.tt-row span:first-child) { display: inline-flex; align-items: center; gap: 6px; color: var(--g600); }
.tooltip :global(.sw) { width: 10px; height: 3px; border-radius: 2px; display: inline-block; }
.chart-desc { font-size: 12.5px; color: var(--g600); line-height: 1.6; margin: 8px 0; }
.table-view summary { cursor: pointer; font-size: 13px; font-weight: 700; color: var(--g700); min-height: 28px; }

.table-wrap { overflow-x: auto; }
table.data { width: 100%; border-collapse: collapse; font-size: 13.5px; }
table.data th { text-align: left; font-size: 10px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: .8px; padding: 10px 14px; border-bottom: 1px solid var(--g100); background: var(--g50); }
table.data :global(td), table.data :global(th[scope="row"]) { padding: 10px 14px; border-bottom: 1px solid var(--g100); color: var(--g800); text-align: left; font-weight: 600; }
table.data :global(.num) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
table.data :global(tr.total td), table.data :global(tr.total th) { font-weight: 850; color: var(--g900); border-top: 2px solid var(--g200); }
table.data :global(.sub) { display: block; font-size: 12px; font-weight: 400; color: var(--g500); }

.actions { display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
.share-personal { font-size: 12.5px; color: var(--g600); display: inline-flex; align-items: center; gap: 6px; min-height: 32px; }
.btn-share {
  border: 1px solid var(--blue-lt); background: #fff; color: var(--blue); border-radius: 6px;
  padding: 10px 20px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; min-height: 40px;
}
.btn-share:hover { background: var(--blue-xlt); }

.prose-body { padding: 16px 18px 18px; }
.prose-body p { font-size: 13.5px; color: var(--g600); line-height: 1.7; margin-bottom: 10px; }
.prose-body p:last-child { margin-bottom: 0; }
.prose-body a { color: var(--blue); text-decoration: none; }
.prose-body a:hover { text-decoration: underline; }

@media (max-width: 960px) {
  .layout { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .compare-grid { grid-template-columns: 1fr; }
  .compare-grid :global(.cmp + .cmp) { border-left: 0; border-top: 1px solid var(--g100); }
}
@media (max-width: 560px) {
  .page { padding: 0 14px 44px; margin-top: 14px; }
  .hero { padding: 22px 18px 18px; }
  .editor-grid { grid-template-columns: 1fr; }
  .big-value { font-size: 30px; }
  .tiles { grid-template-columns: 1fr; }
  #sp-chart { height: 240px; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
@media print {
  :global(header), :global(footer), :global(.page-tagline), .actions, .hero { display: none !important; }
  .page { margin: 0; padding: 0; max-width: none; }
  .section-card { box-shadow: none; break-inside: avoid; }
  .table-view { display: block; }
}
</style>
