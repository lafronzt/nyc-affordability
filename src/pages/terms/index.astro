---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { ALL_CALCULATORS, ALL_GUIDES, STANDARD_ABOUT_COLUMN, TERMS_LINK } from '../../lib/footerLinks';
import { AD_IN_ARTICLE } from '../../lib/adSlots';
import { buildBreadcrumbJsonLd } from '../../lib/breadcrumbs';

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: ALL_CALCULATORS },
  { heading: 'Guides', links: ALL_GUIDES },
  STANDARD_ABOUT_COLUMN,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Terms of Service',
  url: 'https://www.nyc-affordability.com/terms/',
  description: 'Terms of service for NYC Affordability: acceptable use, no warranty on calculator outputs, and limitation of liability.',
  isPartOf: { '@type': 'WebSite', name: 'NYC Affordability', url: 'https://www.nyc-affordability.com/' },
};

const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: TERMS_LINK.label, path: TERMS_LINK.href! },
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---
<BaseLayout
  variant="site"
  ads
  pageTitle="Terms of Service | NYC Affordability"
  metaDescription="Terms of service for NYC Affordability: acceptable use, no warranty on calculator outputs, and limitation of liability for this free, open-source housing calculator project."
  canonicalPath="/terms/"
  ogTitle="Terms of Service | NYC Affordability"
  ogDescription="Terms of service for NYC Affordability: acceptable use, no warranty on calculator outputs, and limitation of liability."
  ogImage="/images/general-og.png"
  ogImageAlt="NYC Affordability calculators for rent, co-op, and condo housing."
  twitterTitle="Terms of Service | NYC Affordability"
  twitterDescription="Terms of service for NYC Affordability: acceptable use, no warranty on calculator outputs, and limitation of liability."
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
<SiteHeader />

<main>
<div class="hero">
  <div class="hero-eyebrow">Terms of Service</div>
  <h2>The short version: these tools are free, informational, and come with no warranty.</h2>
  <p>By using NYC Affordability's calculators and guides, you agree to the terms below.</p>
  <span class="updated">Last updated: August 11, 2026</span>
</div>

<div class="page">

  <Breadcrumbs items={breadcrumbItems} />

  <div class="card">
    <h3>What this site is</h3>
    <p>NYC Affordability provides free, informational calculators and guides covering NYC rent, co-op, and condo affordability, and NYC's affordable housing lottery system. Everything runs client-side in your browser — see the <a href="/about/">About page</a> for how the math works and where the underlying assumptions come from.</p>
  </div>

  <div class="card">
    <h3>Not financial, legal, or mortgage advice</h3>
    <p>Nothing on this site constitutes financial, legal, tax, or mortgage advice, and using it does not create any advisory or professional relationship between you and the maintainer. Calculator outputs are estimates based on the assumptions and formulas described in each page's "How this works" section — actual figures from a lender, co-op board, or landlord can and will differ based on your specific circumstances, the specific building, and terms that change over time. Always verify any number that matters to a financial decision with a licensed mortgage professional and a real estate attorney before acting on it.</p>
  </div>

  <div class="card">
    <h3>No warranty</h3>
    <p>This site and its calculators are provided "as is," without warranty of any kind, express or implied, including but not limited to accuracy, completeness, or fitness for a particular purpose. Tax rates, DTI limits, reserve requirements, and other defaults are sourced and reviewed periodically, but rules change, and no guarantee is made that any figure is current at the moment you use it — check each guide's or calculator's cited sources and "last updated" date directly.</p>
  </div>

  <div class="card">
    <h3>Limitation of liability</h3>
    <p>To the fullest extent permitted by law, the maintainer of NYC Affordability is not liable for any loss, damage, or decision made in reliance on this site's calculators, guides, or any other content — including decisions about whether to rent, buy, or apply for housing. Use of this site, and any decisions made using it, are entirely at your own risk.</p>
  </div>

  <div class="card">
    <h3>Acceptable use</h3>
    <p>You may use this site for personal, non-commercial reference. You may not attempt to disrupt the site's availability, scrape it at a volume that degrades service for other users, or misrepresent this site's content as your own without attribution. The underlying source code is open-source and separately licensed on <a href="https://github.com/lafronzt/nyc-affordability" target="_blank" rel="noopener noreferrer">GitHub</a> — reuse of the code itself is governed by that repository's license, not by these terms.</p>
  </div>

  <div class="card">
    <h3>Third-party links and advertising</h3>
    <p>This site links to third-party sources (government agencies, news outlets, industry publications) to support the figures it cites, and may display ads served by Google AdSense. The maintainer isn't responsible for the content, accuracy, or availability of any linked third-party site. See the <a href="/privacy/">Privacy Policy</a> for how advertising and any related cookies work on this site.</p>
  </div>

  <div class="card">
    <h3>Changes to these terms</h3>
    <p>These terms may be updated from time to time; the "last updated" date at the top of this page reflects the most recent change. Continued use of the site after an update constitutes acceptance of the revised terms.</p>
  </div>

  <div style="margin-bottom:20px;">
    <AdSlot slot={AD_IN_ARTICLE} format="in-article" maxWidth="100%" sidePadding="0" />
  </div>

  <div class="card">
    <h3>Questions</h3>
    <p>Questions about these terms can be raised via the <a href="/contact/">Contact page</a>.</p>
  </div>

</div>
</main>

<Footer
  variant="site"
  disclaimer="These calculators are for informational purposes only and do not constitute financial, legal, or mortgage advice. Always verify all figures with a licensed mortgage professional and real estate attorney before making housing decisions."
  columns={footerColumns}
/>
</BaseLayout>

<style>
.hero {
  background: linear-gradient(160deg, var(--navy) 0%, #0d1f3c 55%, #142240 100%);
  padding: 44px 24px 36px; text-align: center; color: #e2e8f0;
}
.hero-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
.hero h2 { font-size: clamp(24px, 4vw, 34px); font-weight: 800; letter-spacing: -.8px; margin-bottom: 10px; color: #f0f9ff; }
.hero p { font-size: 13.5px; color: #93b4d0; max-width: 600px; margin: 0 auto; }
.hero .updated { display: inline-block; margin-top: 14px; font-size: 11px; color: #6b8ab8; letter-spacing: .4px; }

.page { max-width: 820px; margin: 0 auto; padding: 40px 24px 64px; flex: 1; }
.card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 26px 28px 28px; margin-bottom: 18px;
}
.card h3 { font-size: 16px; font-weight: 800; color: var(--g900); margin-bottom: 9px; letter-spacing: -.2px; }
.card p { font-size: 13.5px; color: var(--g600); line-height: 1.75; margin-bottom: 9px; }
.card p:last-child { margin-bottom: 0; }
.card a { color: var(--blue); text-decoration: none; }
.card a:hover { text-decoration: underline; }

@media (max-width: 560px) {
  .card { padding: 22px 18px 24px; }
}
</style>
