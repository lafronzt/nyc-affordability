---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import AppHeader from '../../components/AppHeader.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { CALC_REQUIRED_SALARY, otherCalculators, ALL_GUIDES, EXPLORE_LINKS, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';
import { fmtMoney } from '../../lib/format';
import { getHealthcareFsaCap, getDependentCareFsaCap } from '../../lib/salaryCalc';
import { TAX_CONSTANTS_2026 } from '../../lib/salaryTaxConstants2026';

// These caps don't depend on any user selection, so they're rendered at build
// time instead of populated by client JS (unlike the HSA/401(k) caps, which
// vary with coverage type / age50 and stay dynamic in required-salary.ts).
const transitCapMonthly = fmtMoney(TAX_CONSTANTS_2026.commuterBenefit.transitMonthly);
const parkingCapMonthly = fmtMoney(TAX_CONSTANTS_2026.commuterBenefit.parkingMonthly);
const healthcareFsaCapAnnual = fmtMoney(getHealthcareFsaCap(TAX_CONSTANTS_2026));
const dependentCareFsaCapAnnual = fmtMoney(getDependentCareFsaCap(TAX_CONSTANTS_2026));

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: otherCalculators(CALC_REQUIRED_SALARY.href!) },
  { heading: 'Guides', links: ALL_GUIDES },
  { heading: 'Explore', links: EXPLORE_LINKS },
  STANDARD_ABOUT_COLUMN,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NYC Required Salary Calculator',
  url: 'https://www.nyc-affordability.com/required-salary/',
  description: 'Enter your monthly expenses and savings goal and find the gross salary you need after federal, NY State, NYC, and FICA taxes, plus 401(k), HSA, health insurance, and other paycheck deductions.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  areaServed: { '@type': 'City', name: 'New York City', sameAs: 'https://www.wikidata.org/wiki/Q60' },
};
---
<BaseLayout
  variant="app"
  ads
  pageTitle="Required Salary Calculator | What Salary Do I Need? | NYC Affordability"
  metaDescription="Work backwards from your monthly expenses and savings goal to the gross salary you need, after federal, NY State, and NYC tax, FICA, 401(k), and HSA contributions."
  canonicalPath="/required-salary/"
  ogTitle="Required Salary Calculator"
  ogDescription="Enter your target take-home pay and see the gross salary you need to hit it, after taxes and pre-tax contributions."
  ogImage="/images/general-og.png"
  ogImageAlt="NYC Required Salary Calculator — reverse-engineer the gross salary you need."
  twitterTitle="Required Salary Calculator"
  twitterDescription="What gross salary do you need to take home a target amount, after taxes and 401(k)/HSA?"
  jsonLd={jsonLd}
>
<AppHeader
  titleHtml="Required <em>Salary</em> Calculator"
  tagline="Tell us what you need to take home each month. We'll work backwards to the gross salary."
  showSaveToggle
/>

<main class="page">
  <section class="hero">
    <div class="eyebrow">Reverse Paycheck Calculator</div>
    <h2>What gross salary do you actually need?</h2>
    <p>Most calculators go salary &rarr; take-home. This one runs the other way: tell us your monthly expenses and savings goal, and we solve for the gross salary that gets you there after federal, NY State, and NYC tax, FICA, and your 401(k)/HSA/health insurance elections.</p>
  </section>

  <section class="section-card">
    <div class="section-title">Your target take-home</div>
    <div class="editor-body">
      <div class="editor-grid cols-2">
        <div class="field">
          <label for="rs-expenses">Monthly expenses</label>
          <div class="input-wrap"><span>$</span><input type="number" id="rs-expenses" min="0" step="50"></div>
        </div>
        <div class="field">
          <label for="rs-savings-goal">Extra monthly savings goal</label>
          <div class="input-wrap"><span>$</span><input type="number" id="rs-savings-goal" min="0" step="50"></div>
        </div>
      </div>
      <p class="editor-note">We add these together and multiply by 12 to get the annual take-home you need — that's the number every tax and contribution calculation below solves backwards from.</p>
    </div>
  </section>

  <section class="section-card">
    <div class="section-title">Tax situation</div>
    <div class="editor-body">
      <div class="field field-narrow">
        <label for="rs-filing-status">Filing status</label>
        <div class="input-wrap"><select id="rs-filing-status">
          <option value="single">Single</option>
          <option value="marriedFilingJointly">Married Filing Jointly</option>
          <option value="headOfHousehold">Head of Household</option>
        </select></div>
      </div>
      <p class="editor-note">This calculator is built for NYC residents — federal, NY State, and the NYC resident local surcharge are always applied.</p>
    </div>
  </section>

  <section class="section-card">
    <div class="section-title">Pre-tax contributions</div>
    <div class="editor-body">
      <div class="subsection-label">Retirement</div>
      <div class="editor-grid cols-3">
        <div class="field">
          <label for="rs-retirement-type">Plan type</label>
          <div class="input-wrap"><select id="rs-retirement-type">
            <option value="k401">401(k)</option>
            <option value="k403b">403(b)</option>
            <option value="k457b">457(b)</option>
            <option value="pension">NYC Pension (NYCERS/TRS/BERS)</option>
          </select></div>
        </div>
        <div class="field">
          <label for="rs-401k-pct" id="rs-401k-pct-label">401(k) contribution</label>
          <div class="input-wrap"><input type="number" id="rs-401k-pct" min="0" max="100" step="1"><span>% of gross</span></div>
        </div>
        <div class="field">
          <label for="rs-401k-type">Traditional or Roth</label>
          <div class="input-wrap"><select id="rs-401k-type">
            <option value="traditional">Traditional</option>
            <option value="roth">Roth</option>
          </select></div>
        </div>
        <div class="field">
          <label class="checkbox-label" for="rs-age50">
            <input type="checkbox" id="rs-age50">
            Age 50+ (catch-up limits)
          </label>
        </div>
      </div>
      <p class="editor-note">401(k)/403(b)/457(b) share the same contribution cap here (real 457(b) limits are technically independent and could stack, which isn't modeled). Pension (NYCERS/TRS/BERS) isn't an elective deferral, so no cap applies at all.</p>
      <p class="editor-note" id="rs-401k-warn" hidden aria-live="polite"></p>

      <div class="subsection-label">Employer <span id="rs-match-plan-label">401(k)</span> match <span class="subsection-hint">(informational only)</span></div>
      <div class="editor-grid cols-2">
        <div class="field">
          <label for="rs-match-pct">Employer match</label>
          <div class="input-wrap"><input type="number" id="rs-match-pct" min="0" max="100" step="1"><span>% of gross</span></div>
        </div>
        <div class="field">
          <label for="rs-match-cap">Match cap (optional)</label>
          <div class="input-wrap"><span>$</span><input type="number" id="rs-match-cap" min="0" step="500" placeholder="No cap"></div>
        </div>
      </div>
      <p class="editor-note">The match is money on top of your paycheck — it does not reduce the salary you need.</p>

      <div class="subsection-label">HSA</div>
      <div class="editor-grid cols-2">
        <div class="field">
          <label for="rs-hsa-coverage">HSA enrollment</label>
          <div class="input-wrap"><select id="rs-hsa-coverage">
            <option value="none">None</option>
            <option value="selfOnly">Self-only</option>
            <option value="family">Family</option>
          </select></div>
        </div>
        <div class="field">
          <label for="rs-hsa-amount">HSA contribution</label>
          <div class="input-wrap input-wrap-maxable">
            <span>$</span><input type="number" id="rs-hsa-amount" min="0" step="100">
            <label class="max-chip" for="rs-hsa-max" title="Set to your coverage's IRS max">
              <input type="checkbox" id="rs-hsa-max"><span>Max</span>
            </label>
          </div>
          <p class="field-hint" id="rs-hsa-max-hint"></p>
        </div>
      </div>
      <p class="editor-note" id="rs-hsa-warn" hidden aria-live="polite"></p>
    </div>
  </section>

  <details class="section-card" id="rs-other-deductions">
    <summary class="section-title">
      Other paycheck deductions
      <span class="section-summary-count" id="rs-other-deductions-count" hidden></span>
      <span class="section-summary-hint">click to expand</span>
    </summary>
    <div class="editor-body">
      <p class="editor-note">Most people only need health insurance and maybe a commuter benefit — the rest are here if they apply to you. Anything left at $0 is ignored.</p>

      <div class="subsection-label"><span class="subsection-icon" aria-hidden="true">🏥</span> Health &amp; insurance</div>
      <div class="editor-grid cols-2">
        <div class="field">
          <label for="rs-health-premium">Health insurance premium</label>
          <div class="input-wrap"><span>$</span><input type="number" id="rs-health-premium" min="0" step="10"><span>/mo</span></div>
        </div>
        <div class="field">
          <label for="rs-dental-vision-premium">Dental / vision premium</label>
          <div class="input-wrap"><span>$</span><input type="number" id="rs-dental-vision-premium" min="0" step="5"><span>/mo</span></div>
        </div>
      </div>
      <p class="editor-note">Pre-tax (Section 125) for most employer plans — reduces income tax and FICA, same as an HSA.</p>

      <div class="subsection-label"><span class="subsection-icon" aria-hidden="true">🚇</span> Commuter benefits <span class="subsection-hint">(two separate buckets — maxing out both is allowed)</span></div>
      <div class="editor-grid cols-2">
        <div class="field">
          <label for="rs-commuter-transit">Transit</label>
          <div class="input-wrap input-wrap-maxable">
            <span>$</span><input type="number" id="rs-commuter-transit" min="0" step="10"><span>/mo</span>
            <label class="max-chip" for="rs-commuter-transit-max" title={`Set to the IRS max of ${transitCapMonthly}/mo`}>
              <input type="checkbox" id="rs-commuter-transit-max"><span>Max</span>
            </label>
          </div>
          <p class="field-hint">up to {transitCapMonthly}/mo</p>
        </div>
        <div class="field">
          <label for="rs-commuter-parking">Parking</label>
          <div class="input-wrap input-wrap-maxable">
            <span>$</span><input type="number" id="rs-commuter-parking" min="0" step="10"><span>/mo</span>
            <label class="max-chip" for="rs-commuter-parking-max" title={`Set to the IRS max of ${parkingCapMonthly}/mo`}>
              <input type="checkbox" id="rs-commuter-parking-max"><span>Max</span>
            </label>
          </div>
          <p class="field-hint">up to {parkingCapMonthly}/mo</p>
        </div>
      </div>

      <div class="subsection-label"><span class="subsection-icon" aria-hidden="true">🧾</span> FSA</div>
      <div class="editor-grid cols-2">
        <div class="field">
          <label for="rs-healthcare-fsa">Healthcare FSA</label>
          <div class="input-wrap input-wrap-maxable">
            <span>$</span><input type="number" id="rs-healthcare-fsa" min="0" step="50"><span>/yr</span>
            <label class="max-chip" for="rs-healthcare-fsa-max" title={`Set to the IRS max of ${healthcareFsaCapAnnual}/yr`}>
              <input type="checkbox" id="rs-healthcare-fsa-max"><span>Max</span>
            </label>
          </div>
          <p class="field-hint" id="rs-healthcare-fsa-hint">up to {healthcareFsaCapAnnual}/yr</p>
        </div>
        <div class="field">
          <label for="rs-dependent-care-fsa">Dependent Care FSA</label>
          <div class="input-wrap input-wrap-maxable">
            <span>$</span><input type="number" id="rs-dependent-care-fsa" min="0" step="50"><span>/yr</span>
            <label class="max-chip" for="rs-dependent-care-fsa-max" title={`Set to the IRS max of ${dependentCareFsaCapAnnual}/yr`}>
              <input type="checkbox" id="rs-dependent-care-fsa-max"><span>Max</span>
            </label>
          </div>
          <p class="field-hint">up to {dependentCareFsaCapAnnual}/yr &middot; independent of HSA/Healthcare FSA</p>
        </div>
      </div>
      <p class="editor-note" id="rs-healthcare-fsa-hsa-note" hidden>You can't have both a Healthcare FSA and an HSA — since HSA enrollment is set above, Healthcare FSA is disabled.</p>
      <p class="editor-note" id="rs-deductions-warn" hidden aria-live="polite"></p>

      <div class="subsection-label"><span class="subsection-icon" aria-hidden="true">🛡️</span> Post-tax deductions <span class="subsection-hint">(no tax benefit)</span></div>
      <div class="editor-grid cols-3">
        <div class="field">
          <label for="rs-life-insurance">Life insurance</label>
          <div class="input-wrap"><span>$</span><input type="number" id="rs-life-insurance" min="0" step="5"><span>/mo</span></div>
        </div>
        <div class="field">
          <label for="rs-disability-insurance">Disability insurance</label>
          <div class="input-wrap"><span>$</span><input type="number" id="rs-disability-insurance" min="0" step="5"><span>/mo</span></div>
        </div>
        <div class="field">
          <label for="rs-union-dues">Union dues</label>
          <div class="input-wrap"><span>$</span><input type="number" id="rs-union-dues" min="0" step="5"><span>/mo</span></div>
        </div>
      </div>
      <p class="editor-note">Disability insurance is deliberately post-tax here — pre-tax premiums would make any paid-out benefit taxable, so most people pay these post-tax on purpose.</p>
    </div>
  </details>

  <section class="headline-card">
    <div class="headline-eyebrow">You need a gross salary of</div>
    <div class="headline-value" id="rs-required-annual" aria-live="polite">&mdash;</div>
    <div class="headline-sub"><span id="rs-required-monthly" aria-live="polite">&mdash;</span> / month, before taxes</div>
  </section>

  <section class="section-card">
    <div class="section-title">Where it goes</div>
    <div class="table-wrap">
      <table aria-label="Salary breakdown">
        <colgroup>
          <col style="width: 280px">
          <col style="width: 100px">
          <col style="width: 100px">
        </colgroup>
        <thead><tr><th>Line item</th><th>Annual</th><th>Monthly</th></tr></thead>
        <tbody id="rs-breakdown-body"></tbody>
      </table>
    </div>
    <div class="prose-body">
      <p>NY State Disability Insurance and Paid Family Leave are mandatory payroll deductions for every NY W-2 employee — self-employed/1099 filers don't have this line.</p>
    </div>
  </section>

  <section class="section-card">
    <div class="section-title">The cost of saving more</div>
    <div class="table-wrap">
      <table aria-label="Required salary sensitivity to savings goal">
        <colgroup>
          <col style="width: 140px">
          <col style="width: 150px">
          <col style="width: 180px">
        </colgroup>
        <thead><tr><th>Savings goal</th><th>Monthly savings</th><th>Required annual salary</th></tr></thead>
        <tbody id="rs-sensitivity-body">
        </tbody>
      </table>
    </div>
    <div class="prose-body">
      <p>This shows how much more gross salary you'd need if you pushed your monthly savings goal up (or down) by 5% and 10% — everything else about your tax situation and contributions held constant.</p>
    </div>
  </section>

  <details class="section-card assumptions">
    <summary class="section-title">Assumptions used (click to expand)</summary>
    <div class="prose-body">
      <ul id="rs-assumptions-list" class="assumptions-list"></ul>
    </div>
  </details>

  <div class="share-row">
    <button class="btn-share" id="rs-share" type="button">Share your result</button>
  </div>

  <section class="section-card">
    <div class="section-title">How this works</div>
    <div class="prose-body">
      <p>We take your monthly expenses plus savings goal, multiply by 12, and binary-search for the gross salary whose net take-home lands on that number — after federal, NY State, and NYC resident tax brackets, the Social Security wage base cap, the Additional Medicare surtax, and your 401(k)/HSA elections. Traditional 401(k) contributions reduce taxable income; Roth contributions don't. HSA contributions are exempt from both income tax and FICA, regardless of 401(k) type.</p>
      <p>This is a planning estimate, not a paycheck. Health insurance, commuter benefits, FSAs, life/disability insurance, union dues, and NY's mandatory SDI/PFL are all modeled in "Other paycheck deductions" above if you enter them — leave them at $0 if they don't apply. It otherwise assumes a single job with no other income.</p>
    </div>
  </section>

  <section class="section-card">
    <div class="section-title">Related tools</div>
    <div class="related-grid">
      <a class="related-item" href="/reality-check/">
        <div class="related-label">NYC Housing Reality Check</div>
        <div class="related-sublabel">Already know your income? See what rent, co-op, condo, or affordable housing it gets you.</div>
      </a>
      <a class="related-item" href="/income/">
        <div class="related-label">What Can I Afford by Income</div>
        <div class="related-sublabel">See max rent and purchase price at set income levels, not just your take-home target.</div>
      </a>
      <a class="related-item" href="/salary/">
        <div class="related-label">Salary After Taxes in NYC</div>
        <div class="related-sublabel">Working forward instead? See what a specific gross salary nets you.</div>
      </a>
      <a class="related-item" href="/compare/">
        <div class="related-label">Compare All Options</div>
        <div class="related-sublabel">Run your real accounts and debts through rent, co-op, and condo side by side.</div>
      </a>
    </div>
  </section>
</main>

<AdSlot maxWidth="1300px" sidePadding="20px" />

<Footer
  variant="app"
  disclaimer="Estimate only, not tax advice. Assumes 2026 federal, New York State, and NYC resident tax brackets and contribution limits. Health insurance, FSA, commuter benefit, and other paycheck deduction figures are only as accurate as what you enter, and NY SDI/PFL are modeled as flat statutory amounts, not your employer's exact payroll calculation. Consult a tax professional for guidance specific to your situation."
  columns={footerColumns}
/>
</BaseLayout>

<script>
  import '../../scripts/required-salary';
</script>

<style>
.page { max-width: 1300px; margin: 20px auto; padding: 0 20px 60px; }
.hero {
  background: linear-gradient(135deg, #0a1628 0%, #0f2a54 100%);
  border: 1px solid #1e3a5f; border-radius: var(--r); overflow: hidden; color: #e2e8f0;
  box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 16px; padding: 26px 24px 22px;
}
.eyebrow { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--gold); margin-bottom: 8px; }
.hero h2 { font-size: clamp(24px, 3.6vw, 36px); line-height: 1.1; letter-spacing: -0.6px; color: #f0f9ff; margin-bottom: 10px; }
.hero p { color: #93b4d0; max-width: 760px; font-size: 14px; line-height: 1.65; }

.section-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.05); margin-bottom: 16px;
}
.section-title {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--g500);
  padding: 12px 18px 11px; border-bottom: 1px solid var(--g100);
}
details.section-card summary.section-title { cursor: pointer; list-style: none; }
details.section-card summary::-webkit-details-marker { display: none; }
details.section-card summary::after { content: '\25BE'; float: right; }
details.section-card[open] summary::after { content: '\25B4'; }

.editor-body { padding: 16px 18px 18px; }
.editor-grid { display: grid; gap: 14px; margin-bottom: 12px; }
.editor-grid.cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.editor-grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.field-narrow { max-width: 320px; margin-bottom: 12px; }
.subsection-label { display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: var(--g600); text-transform: uppercase; letter-spacing: .6px; margin-bottom: 10px; }
.subsection-label:not(:first-child) { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--g100); }
.subsection-icon { font-size: 13px; }
.subsection-hint { text-transform: none; font-weight: 500; color: var(--g400); letter-spacing: 0; }
.field label { display: block; font-size: 12px; color: var(--g700); font-weight: 650; margin-bottom: 5px; }
.field .checkbox-label { display: flex; align-items: center; gap: 8px; margin-top: 22px; cursor: pointer; }
.field .checkbox-label input { width: 16px; height: 16px; }
.field-hint { font-size: 11px; color: var(--g400); margin-top: 4px; }
.input-wrap {
  display: flex; align-items: stretch; border: 1px solid var(--g300); border-radius: 5px; background: #fff;
  overflow: hidden; transition: border-color .15s, box-shadow .15s;
}
.input-wrap:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,.12); }
.input-wrap span {
  background: var(--g50); border-right: 1px solid var(--g200); padding: 0 8px; color: var(--g500);
  font-size: 13px; font-weight: 600; display: flex; align-items: center; white-space: nowrap;
}
.input-wrap span:last-child { border-right: 0; border-left: 1px solid var(--g200); }
.input-wrap:has(.max-chip) span:last-of-type { border-right: 0; }
.input-wrap input, .input-wrap select {
  border: 0; outline: 0; padding: 8px 9px; min-width: 0; width: 100%; font: inherit; color: var(--g900); background: #fff;
}

/* Compact "Max" toggle chip embedded at the end of an input-wrap, replacing a
   separate "Use max" checkbox field so a capped money field is one grid cell,
   not two. */
.max-chip {
  display: flex; align-items: center; gap: 0; padding: 0 10px; cursor: pointer;
  background: var(--g50); border-left: 1px solid var(--g200); flex-shrink: 0;
}
.max-chip input {
  position: absolute; opacity: 0; width: 0; height: 0; pointer-events: none;
}
.max-chip span {
  font-size: 11px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: .4px;
}
.max-chip input:checked + span { color: var(--blue); }
.max-chip:has(input:checked) { background: var(--blue-xlt); }
.max-chip:hover { background: var(--g100); }
.max-chip:has(input:checked):hover { background: var(--blue-lt); }

.editor-note { font-size: 12px; color: var(--g500); line-height: 1.6; margin-bottom: 8px; }
.editor-note.warn { color: #b45309; background: rgba(245,158,11,.12); border: 1px solid rgba(245,158,11,.3); padding: 8px 10px; border-radius: 5px; }

.section-summary-count {
  display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: 999px;
  background: var(--blue-lt); color: var(--blue); font-size: 10px; font-weight: 800; text-transform: none; letter-spacing: 0;
}
.section-summary-hint { margin-left: 8px; font-weight: 500; text-transform: none; letter-spacing: 0; color: var(--g400); }

.headline-card {
  background: var(--navy); border-radius: var(--r); overflow: hidden; color: #f0f9ff;
  box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 16px; padding: 26px 24px; text-align: center;
}
.headline-eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,.65); margin-bottom: 8px; }
.headline-value { font-size: clamp(34px, 6vw, 56px); font-weight: 850; letter-spacing: -1.5px; font-variant-numeric: tabular-nums; line-height: 1; }
.headline-sub { font-size: 14px; color: rgba(255,255,255,.75); margin-top: 10px; }

/* These two tables are much narrower than the 1300px page, so a table
