---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { CALC_COOP, otherCalculators, ALL_GUIDES, HPD_HOME_LINK, CFPB_OWNING_HOME_LINK, MANSION_TAX_GUIDE_LINK, STANDARD_ABOUT_COLUMN } from '../../lib/footerLinks';

const footerColumns: FooterColumn[] = [
  { heading: 'Guides', links: ALL_GUIDES },
  {
    heading: 'NYC Housing Resources',
    links: [
      HPD_HOME_LINK,
      { label: 'NYC Housing Development Corp.', href: 'https://www.nychdc.com/' },
      { label: 'HUD New York Resources', href: 'https://portal.hud.gov/hudportal/HUD?src=/states/new_york' },
    ],
  },
  {
    heading: 'Mortgage & Financing',
    links: [
      CFPB_OWNING_HOME_LINK,
      { label: 'Verify Your Mortgage Broker (NMLS)', href: 'https://www.nmlsconsumeraccess.org/' },
      { label: 'Current Interest Rate Data (Fed)', href: 'https://www.federalreserve.gov/releases/h15/' },
      { label: 'CFPB: When Can I Cancel PMI?', href: 'https://www.consumerfinance.gov/ask-cfpb/when-can-i-stop-paying-private-mortgage-insurance-pmi-en-202/' },
    ],
  },
  {
    heading: 'Taxes & Closing Costs',
    links: [
      MANSION_TAX_GUIDE_LINK,
      { label: 'NYC Real Property Transfer Tax', href: 'https://www.nyc.gov/site/finance/taxes/property-real-property-transfer-tax-rptt.page' },
      { label: 'Find a Real Estate Attorney (NYC Bar)', href: 'https://www.nycbar.org/lawyer-referral-service' },
    ],
  },
  { heading: 'More NYC Calculators', links: otherCalculators(CALC_COOP.href!) },
  STANDARD_ABOUT_COLUMN,
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NYC Co-op Apartment Affordability Calculator',
  url: 'https://www.nyc-affordability.com/coop/',
  description: 'A free NYC co-op housing, apartment, and home affordability calculator that reverse-engineers your maximum purchase price from your financial profile, covering down payment, closing costs, debt-to-income limits, and post-close reserve requirements.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  areaServed: { '@type': 'City', name: 'New York City', sameAs: 'https://www.wikidata.org/wiki/Q60' },
};

// Questions and answers below are condensed, non-invented restatements of the
// "How this works" copy already visible in the collapsible panel on this page
// (see the <h3>/<p> pairs starting at "Two constraints, one limit").
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How does this calculator determine my maximum co-op purchase price?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "This calculator finds the lower of two maximum prices. Cash / Reserves: your assets are split into two pools — accounts marked 'Closing?' cover the down payment and closing costs, while all accounts (weighted by Reserve %) count toward the post-close reserve cushion. DTI / Income: your total monthly housing payment (mortgage P&I + maintenance + other debts) must stay within the board's debt-to-income ratio limit on your gross monthly income. Whichever constraint produces the lower max price is your binding limit.",
      },
    },
    {
      '@type': 'Question',
      name: "What's the difference between the Closing? checkbox and Reserve % for each account?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Closing? is checked for any account you can fully liquidate and wire on closing day (cash, HYSA, brokerage you plan to sell) — the full balance then counts toward the down payment and closing costs. Reserve % is the fraction of the balance your board credits toward post-closing reserves. Boards typically credit 100% for cash and HYSA, 70-80% for brokerage (a market-volatility haircut), and 0% for retirement accounts (401k, IRA, Roth IRA).",
      },
    },
    {
      '@type': 'Question',
      name: 'When is PMI required on a co-op share loan, and how much does it cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Private mortgage insurance (PMI) is required on conventional co-op share loans with less than 20% down. The calculator applies PMI automatically based on your down payment percentage, using typical rates for a borrower with good credit (about 720-740 FICO): roughly 0.52%/yr at 15-20% down, 0.70% at 10-15%, 0.95% at 5-10%, and 1.20% below 5%. PMI is factored into the DTI and reserve calculations.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is the mansion tax calculated on a co-op purchase?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "New York's mansion tax applies to co-op purchases just as it does to condos, following the consideration paid. It starts at 1% on purchases of $1,000,000-$2,000,000 and steps up to 3.9% above $25,000,000. The tax is not marginal: crossing a tier raises the entire bill, so a $999,999 purchase owes $0 while a $1,000,001 purchase owes roughly $10,000.",
      },
    },
    {
      '@type': 'Question',
      name: 'How many months of reserves and what DTI ratio do NYC co-op boards typically require?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most co-op boards require 12 months of post-close carrying costs (maintenance + mortgage) in liquid reserves, though conservative buildings ask for 24 or more. Most NYC boards use a 25-30% debt-to-income ratio on your total monthly housing payment.',
      },
    },
  ],
};

// Steps mirror the calculator's own visibly numbered input cards (1-5, each
// rendered with a <span class="snum"> on this page) plus the results panel.
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to use the NYC Co-op Affordability Calculator',
  description: 'Reverse-engineer your maximum NYC co-op purchase price from your income, assets, and a building’s board requirements.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Account Balances',
      text: 'List your checking, savings, and investment accounts, each with a balance, a Reserve % weighting, and whether it is available at closing.',
      url: 'https://www.nyc-affordability.com/coop/#card-body-1',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Income & Existing Debts',
      text: 'Enter your annual gross income and any existing monthly debts.',
      url: 'https://www.nyc-affordability.com/coop/#card-body-2',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Mortgage Assumptions',
      text: 'Set your expected mortgage rate, loan term, and down payment percentage.',
      url: 'https://www.nyc-affordability.com/coop/#card-body-3',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Co-op Requirements',
      text: "Set the building's required post-close reserve months and its maximum board debt-to-income ratio.",
      url: 'https://www.nyc-affordability.com/coop/#card-body-4',
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'Closing Costs',
      text: 'Enter estimated attorney, bank attorney, co-op application, and move-in fees.',
      url: 'https://www.nyc-affordability.com/coop/#card-body-5',
    },
    {
      '@type': 'HowToStep',
      position: 6,
      name: 'Your Max Affordable Price',
      text: 'View your maximum affordable purchase price, which constraint (cash or DTI) is binding, and the full cost breakdown.',
      url: 'https://www.nyc-affordability.com/coop/',
    },
  ],
};

const jsonLd = [webAppSchema, faqSchema, howToSchema];
---
<BaseLayout
  variant="app"
  ads
  pageTitle="NYC Co-op Affordability Calculator | Calculate Your Max Purchase Price"
  metaDescription="Free NYC housing affordability calculator for co-op apartments. Estimate how much home you can afford from income, assets, mansion tax, DTI, costs, and reserves."
  canonicalPath="/coop/"
  ogTitle="NYC Co-op Affordability Finder | Calculate Your Max Purchase Price"
  ogDescription="Free NYC housing affordability calculator for co-op apartments. Find your max purchase price from your financial profile — covering down payment, closing costs, DTI, and reserves."
  ogImage="/images/coop-og.png"
  ogImageAlt="Can you afford a NYC co-op? NYC Co-op Affordability Calculator from NYC Affordability."
  twitterTitle="NYC Co-op Affordability Finder"
  twitterDescription="Free NYC housing affordability calculator for co-op apartments. Reverse-engineer your max purchase price from income, assets, and mortgage assumptions."
  jsonLd={jsonLd}
>
<AppHeader titleHtml="NYC <em>Co-op</em> Affordability Finder" tagline="Reverse-engineer your max purchase price from your financial profile" />

<main class="app-layout">

  <!-- ═══════════════════════════════════════ LEFT — INPUTS ═══════════════════════════════════════ -->
  <div class="inputs-panel">

    <!-- 1 · Account Balances -->
    <div class="card">
      <div class="card-title" id="card-title-1" aria-expanded="true" aria-controls="card-body-1"><span class="snum">1</span> Account Balances<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-1">
        <div class="acct-wrap">
          <table class="acct-tbl">
            <thead>
              <tr>
                <th>Account</th>
                <th class="r">Balance ($)</th>
                <th class="c">Closing?</th>
                <th class="r">Reserve %</th>
                <th class="r">Closing Cash</th>
                <th class="r">Reserve Value</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="acct-tbody"></tbody>
          </table>
        </div>
        <button class="btn-add-row" id="btn-add-acct">+ Add Account</button>

        <!-- Two-pool explanation -->
        <div class="pool-callout">
          <div class="pool-row">
            <span class="pool-dot green"></span>
            <span><strong>Closing Cash</strong> (Closing? = ✓) — wired at closing to cover the down payment + closing costs. Check any account you can fully liquidate on closing day.</span>
          </div>
          <div class="pool-row">
            <span class="pool-dot blue"></span>
            <span><strong>Reserve Value</strong> (balance × Reserve %) — counts toward the board's post-close cushion. Boards typically apply a 70–80% haircut on brokerage and exclude retirement accounts — set Reserve % to 0% for accounts your board ignores.</span>
          </div>
        </div>

        <p style="margin:4px 0 0;font-size:11px;color:var(--g400);line-height:1.5">
          Defaults reflect a typical NYC co-op buyer (~$150K income, age 35–42) based on
          2024–25 Federal Reserve SCF, Fidelity, and Vanguard data.
        </p>
        <div class="acct-totals">
          <div>
            <div class="tot-lbl">Total Closing Cash</div>
            <div class="tot-val" id="tot-liquid">—</div>
          </div>
          <div>
            <div class="tot-lbl">Total Reserve Value</div>
            <div class="tot-val primary" id="tot-avail">—</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2 · Income & Debts -->
    <div class="card">
      <div class="card-title" id="card-title-2" aria-expanded="true" aria-controls="card-body-2"><span class="snum">2</span> Income &amp; Existing Debts<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-2">
        <div class="form-row">
          <label class="lbl" for="annual-income">Annual Gross Income
            <small>$150K is the minimum needed at 28% DTI to qualify for the city-wide median co-op (~$506K, Q1 2025 — StreetEasy/Baruch CUNY). Typical buyers targeting Manhattan pay considerably more.</small>
          </label>
          <div class="iw w140"><span class="px">$</span><input type="number" id="annual-income" value="150000" min="0" step="1000"></div>
        </div>
        <div class="form-row">
          <label class="lbl">Monthly Gross Income <small>Auto-calculated</small></label>
          <div class="iw w140"><span class="px">$</span><input type="number" id="monthly-income" class="ro" readonly tabindex="-1"></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="other-debts">Other Monthly Debts
            <small>Car loans, student loans, credit cards, etc.</small>
          </label>
          <div class="iw w140"><span class="px">$</span><input type="number" id="other-debts" value="0" min="0" step="100"></div>
        </div>
      </div>
    </div>

    <!-- 3 · Mortgage Assumptions -->
    <div class="card">
      <div class="card-title" id="card-title-3" aria-expanded="true" aria-controls="card-body-3"><span class="snum">3</span> Mortgage Assumptions<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-3">
        <div class="form-row">
          <label class="lbl" for="mtg-rate">Annual Mortgage Rate
            <small>30-yr fixed consensus as of Apr 2026 — Freddie Mac (6.23%), Bankrate (6.40%). Co-ops require conventional financing; FHA loans are not permitted.</small>
          </label>
          <div class="iw w120"><input type="number" id="mtg-rate" value="6.25" min="0" max="30" step="0.05" style="text-align:right"><span class="sx">%</span></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="loan-term">Loan Term</label>
          <div class="iw w120"><input type="number" id="loan-term" value="30" min="1" max="40" step="1" style="text-align:right"><span class="sx">yrs</span></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="dp-pct">Down Payment
            <small>20% is the minimum for most buildings; mid-range Manhattan boards often require 25%; luxury/conservative buildings may require 30–50% — Skybriz, Prevu (2025).</small>
          </label>
          <div class="iw w120"><input type="number" id="dp-pct" value="20" min="0" max="100" step="1" style="text-align:right"><span class="sx">%</span></div>
        </div>
      </div>
    </div>

    <!-- 4 · Co-op Requirements -->
    <div class="card">
      <div class="card-title" id="card-title-4" aria-expanded="true" aria-controls="card-body-4"><span class="snum">4</span> Co-op Requirements<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-4">
        <div class="form-row">
          <label class="lbl" for="reserve-mo">Post-Close Reserve
            <small>12 months is the most common standard for typical buildings; conservative/luxury boards require 24+. Only liquid assets count (cash, HYSA, brokerage) — retirement accounts are generally excluded — Prevu, Aaron &amp; Geoff Compass (2026).</small>
          </label>
          <div class="iw w120"><input type="number" id="reserve-mo" value="12" min="0" max="120" step="1" style="text-align:right"><span class="sx">mo</span></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="max-dti">Max DTI Allowed by Board
            <small>28% is the long-standing NYC standard. Outer-borough buildings may allow up to 30–35%; Park/Fifth Ave luxury buildings may cap at 20–25% — Prevu, YRE (2025).</small>
          </label>
          <div class="iw w120"><input type="number" id="max-dti" value="28" min="0" max="100" step="0.5" style="text-align:right"><span class="sx">%</span></div>
        </div>
        <div class="form-row">
          <label class="lbl" for="monthly-maint">Projected Monthly Maintenance
            <small>Includes building's underlying mortgage + property tax share (typically 30–50% is tax-deductible). City-wide medians: Queens ~$750, Brooklyn ~$900, Manhattan ~$1,500–$1,800. $1,200 is a mid-range city-wide estimate — Elliman/Miller Samuel Q4 2024.</small>
          </label>
          <div class="iw w140"><span class="px">$</span><input type="number" id="monthly-maint" value="1200" min="0" step="50"></div>
        </div>
      </div>
    </div>

    <!-- 5 · Closing Costs -->
    <div class="card">
      <div class="card-title" id="card-title-5" aria-expanded="true" aria-controls="card-body-5"><span class="snum">5</span> Closing Costs<span class="card-chev" aria-hidden="true">▲</span></div>
      <div class="card-body" id="card-body-5">
        <div class="sub-title">Fixed Costs</div>
        <div class="fc-list">
          <div class="fc-row">
            <label for="fc-atty">Attorney Fees <em style="font-style:normal;color:var(--g400);font-size:12px;">(NYC range: $2,500–$5,000 in 2025 — Prevu, Brick Underground)</em></label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-atty" value="4000" min="0" step="100"></div>
          </div>
          <div class="fc-row">
            <label for="fc-bank-atty">Bank Attorney Fees</label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-bank-atty" value="1500" min="0" step="100"></div>
          </div>
          <div class="fc-row">
            <label for="fc-coop">Co-op Application / Board Fee</label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-coop" value="750" min="0" step="50"></div>
          </div>
          <div class="fc-row">
            <label for="fc-movein">Move-In Deposit <em style="font-style:normal;color:var(--g400);font-size:12px;">(refundable)</em></label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-movein" value="1000" min="0" step="100"></div>
          </div>
          <div class="fc-row">
            <label for="fc-other">Other Fixed Costs <em style="font-style:normal;color:var(--g400);font-size:12px;">(UCC, filing, etc.)</em></label>
            <div class="iw w140"><span class="px">$</span><input type="number" id="fc-other" value="800" min="0" step="100"></div>
          </div>
          <div class="fc-row fc-total">
            <label>Total Fixed</label>
            <div class="fc-total-val" id="fc-total-display">—</div>
          </div>
        </div>

        <div class="var-section">
          <div class="sub-title">Variable Costs</div>
          <div class="form-row" style="margin-bottom:0">
            <label class="lbl" for="var-pct">Combined Variable Rate
              <small>0.5% default covers loan origination fees. Mansion tax is calculated automatically below. Add 1–3% if your building charges a buyer-side flip tax — check the proprietary lease.</small>
            </label>
            <div class="iw w120"><input type="number" id="var-pct" value="0.5" min="0" max="20" step="0.1" style="text-align:right"><span class="sx">%</span></div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /inputs-panel -->


  <!-- ═══════════════════════════════════════ RIGHT — RESULTS ═══════════════════════════════════════ -->
  <div class="results-panel">

    <div class="results-tabs" role="tablist">
      <button class="tab-btn active" id="tab-standard" role="tab" aria-selected="true" aria-controls="view-standard" data-tab="standard">Standard</button>
      <button class="tab-btn" id="tab-optimizer" role="tab" aria-selected="false" aria-controls="view-optimizer" data-tab="optimizer">⚡ Optimizer</button>
      <button class="tab-btn" id="tab-afford" role="tab" aria-selected="false" aria-controls="view-afford" data-tab="afford">🎯 Afford Target</button>
    </div>

    <div class="results-card" id="view-standard" role="tabpanel" aria-labelledby="tab-standard">

      <!-- Hero -->
      <div class="hero">
        <div class="hero-eyebrow">Your Max Affordable Price</div>
        <div class="hero-price" id="hero-price">$—</div>
        <div class="hero-binding">
          Binding constraint: <span class="binding-val" id="hero-binding">—</span>
        </div>
        <div class="hero-warn" id="hero-warn"></div>
        <button class="btn-share" id="coop-share" type="button">Share your result</button>
      </div>

      <div class="results-body">

        <!-- Target price override -->
        <div class="target-row">
          <span class="tgt-lbl">Model a specific price:</span>
          <div class="tgt-wrap">
            <span class="px">$</span>
            <input type="number" id="target-price" min="0" step="1000" placeholder="—">
          </div>
          <button class="btn-reset" id="btn-reset-tgt">Reset to max</button>
        </div>

        <!-- Cash Waterfall -->
        <div class="snap-block">
          <div class="snap-title">Cash Waterfall</div>
          <div class="snap-row indent">
            <span class="sr-lbl">Down Payment</span>
            <span class="sr-val" id="s-dp">—</span>
          </div>
          <div class="snap-row indent">
            <span class="sr-lbl">Fixed Closing Costs</span>
            <span class="sr-val" id="s-fcc">—</span>
          </div>
          <div class="snap-row indent">
            <span class="sr-lbl">Variable Closing Costs</span>
            <span class="sr-val" id="s-vcc">—</span>
          </div>
          <div class="snap-row indent mansion-row" id="mansion-snap-row" style="display:none">
            <span class="sr-lbl">Mansion Tax <span class="sr-note">(buyer-paid ≥ $1M)</span></span>
            <span class="sr-val" id="s-mansion">—</span>
          </div>
          <div class="snap-row subtotal">
            <span class="sr-lbl">Total at Close</span>
            <span class="sr-val" id="s-atclose">—</span>
          </div>
          <div class="snap-row avail-row">
            <span class="sr-lbl">Avail for DP + CC <span class="sr-note">(Closing ✓)</span></span>
            <span class="sr-val" id="s-dp-avail">—</span>
          </div>
          <div class="snap-row surplus-row">
            <span class="sr-lbl">DP + CC Surplus / (Deficit)</span>
            <span class="sr-val" id="s-dp-surplus">—</span>
          </div>
          <hr class="snap-div">
          <div class="snap-row indent">
            <span class="sr-lbl">Maintenance Reserve (<span id="s-res-mo1">24</span> mo)</span>
            <span class="sr-val" id="s-maint-res">—</span>
          </div>
          <div class="snap-row indent">
            <span class="sr-lbl">Mortgage Reserve (<span id="s-res-mo2">24</span> mo)</span>
            <span class="sr-val" id="s-mtg-res">—</span>
          </div>
          <div class="snap-row subtotal">
            <span class="sr-lbl">Total Cash Needed</span>
            <span class="sr-val" id="s-total-cash">—</span>
          </div>
          <hr class="snap-div">
          <div class="snap-row avail-row">
            <span class="sr-lbl">Total for Reserves <span class="sr-note">(all weighted)</span></span>
            <span class="sr-val" id="s-avail">—</span>
          </div>
          <div class="snap-row surplus-row">
            <span class="sr-lbl">Reserves Surplus / (Deficit)</span>
            <span class="sr-val" id="s-surplus">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">Post-close for reserves</span>
            <span class="sr-val" id="s-pc-liquid">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">Post-close reserve months</span>
            <span class="sr-val" id="s-pc-months">—</span>
          </div>
        </div>

        <!-- Monthly Costs -->
        <div class="snap-block">
          <div class="snap-title">Monthly Costs</div>
          <div class="snap-row">
            <span class="sr-lbl">Mortgage (P+I)</span>
            <span class="sr-val" id="s-mtg">—</span>
          </div>
          <div class="snap-row indent pmi-row" id="pmi-snap-row" style="display:none">
            <span class="sr-lbl">PMI <span class="sr-note">(auto — dp &lt; 20%)</span></span>
            <span class="sr-val" id="s-pmi">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">Maintenance</span>
            <span class="sr-val" id="s-maint">—</span>
          </div>
          <div class="snap-row subtotal">
            <span class="sr-lbl">Total Monthly Housing</span>
            <span class="sr-val" id="s-monthly-total">—</span>
          </div>
          <div class="snap-row">
            <span class="sr-lbl">Effective DTI</span>
            <span class="sr-val" id="s-dti">—</span>
          </div>
        </div>

        <!-- Feasibility -->
        <div>
          <div class="feas-title">Feasibility Check</div>
          <div class="pill ok" id="pill-cash">
            <span class="p-icon">✓</span>
            <span class="p-name">Cash</span>
