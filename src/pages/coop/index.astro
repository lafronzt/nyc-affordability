  background: none; border: 1px solid var(--blue-lt); border-radius: 4px;
  padding: 5px 11px; cursor: pointer; margin-top: 10px; font-family: inherit; font-weight: 500;
  transition: background .15s;
}
.btn-add-row:hover { background: var(--blue-xlt); }
/* Two-pool callout — static markup, no :global() needed. */
.pool-callout {
  display: flex; flex-direction: column; gap: 6px;
  background: var(--g50); border: 1px solid var(--g200); border-radius: 6px;
  padding: 9px 12px; margin: 10px 0 6px; font-size: 12px; line-height: 1.4; color: var(--g700);
}
.pool-row { display: flex; gap: 8px; align-items: flex-start; }
.pool-dot { flex-shrink: 0; width: 8px; height: 8px; border-radius: 50%; margin-top: 4px; }
.pool-dot.green { background: var(--green); }
.pool-dot.blue  { background: var(--blue); }
.acct-totals { display: flex; gap: 28px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--g200); }
.tot-lbl { font-size: 10px; color: var(--g500); text-transform: uppercase; letter-spacing: 0.6px; font-weight: 600; margin-bottom: 2px; }
.tot-val { font-size: 16px; font-weight: 700; color: var(--g900); font-variant-numeric: tabular-nums; }
.tot-val.primary { color: var(--blue); }
/* ===== FIXED COSTS ===== */
.fc-row {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 6px 0; border-bottom: 1px solid var(--g100);
}
.fc-row:last-of-type { border-bottom: none; }
.fc-row label { font-size: 13px; color: var(--g700); flex: 1; }
.fc-row.fc-total {
  border-top: 1px solid var(--g200); border-bottom: none;
  margin-top: 2px; padding-top: 8px; font-weight: 700;
}
.fc-total-val { font-size: 13px; font-weight: 700; color: var(--g900); font-variant-numeric: tabular-nums; min-width: 100px; text-align: right; }
.var-section { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--g100); }
.sub-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--g500); margin-bottom: 10px; }
/* ===== RESULTS CARD ===== */
.results-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.06);
}
/* Hero */
.hero { background: var(--navy); padding: 22px 20px 17px; text-align: center; }
.hero-eyebrow {
  font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px;
  color: #ffffff; margin-bottom: 6px; display: flex; align-items: center; justify-content: center; gap: 8px;
}
.hero-eyebrow::before, .hero-eyebrow::after { content: ''; height: 1px; width: 24px; background: #1e3a5f; }
.hero-price {
  font-size: 46px; font-weight: 800; font-variant-numeric: tabular-nums;
  letter-spacing: -2px; color: #f0f9ff; line-height: 1.05; margin-bottom: 11px;
}
.hero-price.zero { color: #4a6fa5; }
.hero-binding {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.09);
  border-radius: 20px; padding: 5px 14px; font-size: 12px; color: #ffffff;
}
.binding-val { color: var(--gold); font-weight: 700; }
.hero-warn {
  margin-top: 10px; padding: 7px 12px;
  background: rgba(220,38,38,.15); border: 1px solid rgba(220,38,38,.3);
  border-radius: 6px; font-size: 12px; color: #fca5a5; display: none;
}
.btn-share {
  margin-top: 12px; border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.06);
  color: #e2e8f0; border-radius: 6px; padding: 8px 16px; font: inherit; font-size: 12.5px;
  font-weight: 700; cursor: pointer; transition: background .15s;
}
.btn-share:hover { background: rgba(255,255,255,.14); }
.results-body { padding: 15px 17px; }
/* Target price */
.target-row {
  display: flex; align-items: center; gap: 10px;
  background: var(--g50); border: 1px solid var(--g200);
  border-radius: 6px; padding: 10px 12px; margin-bottom: 15px; flex-wrap: wrap;
}
.target-row .tgt-lbl { font-size: 12px; font-weight: 600; color: var(--g600); white-space: nowrap; }
.tgt-wrap {
  display: flex; align-items: stretch; border: 1px solid var(--g300); border-radius: 5px;
  background: #fff; overflow: hidden; flex: 1; min-width: 110px;
  transition: border-color .15s, box-shadow .15s;
}
.tgt-wrap:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,.12); }
.tgt-wrap .px {
  background: var(--g50); border-right: 1px solid var(--g200); padding: 0 8px;
  font-size: 14px; color: var(--g500); font-weight: 600; display: flex; align-items: center;
}
.tgt-wrap input {
  border: none; outline: none; background: transparent; padding: 8px 10px;
  font-size: 15px; font-weight: 700; color: var(--g900); width: 100%;
  -moz-appearance: textfield; font-family: inherit; font-variant-numeric: tabular-nums;
}
.tgt-wrap input::-webkit-inner-spin-button, .tgt-wrap input::-webkit-outer-spin-button { -webkit-appearance: none; }
.btn-reset { font-size: 11px; color: var(--blue); background: none; border: none; cursor: pointer; font-family: inherit; padding: 0; font-weight: 500; white-space: nowrap; }
.btn-reset:hover { text-decoration: underline; }
/* Snapshot blocks */
.snap-block { margin-bottom: 14px; }
.snap-title { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.9px; color: var(--g400); margin-bottom: 6px; }
.snap-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 3.5px 0; font-size: 12.5px; border-bottom: 1px solid var(--g100);
}
.snap-row:last-child { border-bottom: none; }
.sr-lbl { color: var(--g500); }
.sr-note { font-size: 10px; color: var(--g400); font-weight: 400; }
.sr-val { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--g800); }
.snap-row.indent .sr-lbl { padding-left: 12px; color: var(--g400); font-size: 12px; }
.snap-row.indent .sr-val { color: var(--g500); font-size: 12px; font-weight: 500; }
.snap-row.subtotal { border-top: 1px solid var(--g200); margin-top: 1px; padding-top: 5px; border-bottom: none; }
.snap-row.subtotal .sr-lbl, .snap-row.subtotal .sr-val { font-weight: 700; color: var(--g900); font-size: 13px; }
.snap-row.avail-row .sr-lbl { font-weight: 600; color: var(--g700); }
.snap-row.avail-row .sr-val { color: var(--blue); font-weight: 700; }
.snap-row.surplus-row .sr-lbl { font-weight: 600; color: var(--g700); }
.sr-val.neg { color: var(--red) !important; }
.sr-val.pos { color: var(--green) !important; }
.snap-row.mansion-row { background: rgba(245,158,11,.06); border-radius: 4px; padding-left: 4px; padding-right: 4px; }
.snap-row.mansion-row .sr-lbl { color: #92400e; }
.snap-row.mansion-row .sr-val { color: #92400e; font-weight: 700; }
/* PMI row highlight */
.snap-row.pmi-row { background: rgba(239,68,68,.05); border-radius: 4px; padding-left: 4px; padding-right: 4px; }
.snap-row.pmi-row .sr-lbl { color: #991b1b; }
.snap-row.pmi-row .sr-val { color: #991b1b; font-weight: 700; }
hr.snap-div { border: none; border-top: 1px dashed var(--g200); margin: 5px 0; }
/* Feasibility pills */
.feas-title { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.9px; color: var(--g400); margin-bottom: 7px; }
.pill {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 10px; border-radius: 6px; margin-bottom: 6px; font-size: 12.5px;
}
.pill:last-child { margin-bottom: 0; }
.pill.ok  { background: var(--green-bg); border: 1px solid var(--green-bd); }
.pill.fail{ background: var(--red-bg);   border: 1px solid var(--red-bd);   }
.p-icon { font-size: 13px; flex-shrink: 0; }
.pill.ok   .p-icon  { color: var(--green); }
.pill.fail .p-icon  { color: var(--red); }
.p-name { font-weight: 700; min-width: 62px; flex-shrink: 0; font-size: 12px; }
.pill.ok   .p-name  { color: var(--green); }
.pill.fail .p-name  { color: var(--red); }
.p-detail { color: var(--g600); font-size: 12px; }
/* ===== COLLAPSIBLE ===== */
.collapsible { margin-bottom: 20px; }
.coll-btn {
  display: flex; align-items: center; gap: 6px; width: 100%; text-align: left;
  background: none; border: none; cursor: pointer; font-size: 13px; color: var(--blue);
  font-family: inherit; font-weight: 500; padding: 8px 0;
}
.coll-btn:hover { color: #1d4ed8; }
.caret { transition: transform .2s; display: inline-block; font-style: normal; }
.coll-btn.open .caret { transform: rotate(180deg); }
.coll-body { display: none; background: #fff; border: 1px solid var(--border); border-radius: var(--r); padding: 16px 20px; }
.coll-body.open { display: block; }
.coll-body h3 { font-size: 13px; font-weight: 700; color: var(--g800); margin: 14px 0 5px; }
.coll-body h3:first-child { margin-top: 0; }
.coll-body p { font-size: 13px; color: var(--g600); line-height: 1.65; margin-bottom: 6px; }
.coll-body ul { padding-left: 18px; color: var(--g600); font-size: 13px; line-height: 1.7; }
.coll-body li { margin-bottom: 3px; }
/* ===== TABS ===== */
.results-tabs { display: flex; gap: 0; margin-bottom: 13px; border-bottom: 1px solid var(--border); }
.tab-btn {
  flex: 1; background: none; border: none; border-bottom: 2px solid transparent;
  padding: 10px 12px; font-size: 12px; font-weight: 600; color: var(--g500);
  cursor: pointer; font-family: inherit; transition: color .15s, border-color .15s, background .15s;
  margin-bottom: -1px;
}
.tab-btn:hover { color: var(--g800); background: var(--g50); }
.tab-btn.active { color: var(--navy); border-bottom-color: var(--gold); }
/* ===== OPTIMIZER VIEW ===== */
.opt-card { background: #fff; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
.opt-card[hidden] { display: none; }
.opt-hero { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%); padding: 18px 20px 16px; text-align: center; color: #f0f9ff; }
.opt-hero-eyebrow { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--gold); margin-bottom: 8px; }
.opt-hero-price { font-size: 36px; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -1.5px; line-height: 1.05; margin-bottom: 4px; }
.opt-hero-sub { font-size: 12px; color: #c0d8f0; margin-bottom: 8px; }
.opt-hero-sub strong { color: #fff; }
.opt-hero-gain { display: inline-flex; align-items: center; gap: 6px; background: rgba(245,158,11,.15); border: 1px solid rgba(245,158,11,.35); border-radius: 20px; padding: 4px 12px; font-size: 12px; color: var(--gold); font-weight: 600; }
.opt-hero-gain.zero { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.12); color: #c0d8f0; }
.opt-body { padding: 14px 17px 18px; }
.opt-section { margin-bottom: 18px; }
.opt-section:last-child { margin-bottom: 0; }
.opt-section-title { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.9px; color: var(--g400); margin-bottom: 8px; }
/* Chart */
.opt-chart-wrap { position: relative; width: 100%; margin-bottom: 4px; }
.opt-chart-wrap canvas { width: 100%; height: 280px; display: block; cursor: crosshair; touch-action: none; }
.opt-chart-tip {
  position: absolute; background: rgba(10,22,40,.95); color: #fff; border-radius: 5px;
  padding: 6px 9px; font-size: 11px; line-height: 1.5; pointer-events: none;
  white-space: nowrap; font-variant-numeric: tabular-nums; box-shadow: 0 4px 12px rgba(0,0,0,.18);
  display: none; z-index: 5;
}
/* .opt-chart-tip's innerHTML is set at runtime — the <b> inside it stays :global(). */
:global(.opt-chart-tip b) { color: var(--gold); font-weight: 700; }
.opt-legend { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; font-size: 11px; color: var(--g600); }
.opt-legend span { display: inline-flex; align-items: center; gap: 5px; }
.opt-legend i { display: inline-block; width: 14px; height: 2px; border-radius: 1px; vertical-align: middle; font-style: normal; }
.opt-legend i.dot { width: 8px; height: 8px; border-radius: 50%; }
/* Slider */
.opt-slider-row { display: flex; align-items: center; gap: 12px; background: var(--g50); border: 1px solid var(--g200); border-radius: 6px; padding: 10px 12px; margin-top: 12px; }
.opt-slider-row .slbl { font-size: 11px; font-weight: 600; color: var(--g600); white-space: nowrap; min-width: 90px; }
.opt-slider-row input[type="range"] { flex: 1; accent-color: var(--blue); min-width: 0; }
.opt-slider-val { font-size: 12px; font-weight: 700; color: var(--navy); font-variant-numeric: tabular-nums; min-width: 48px; text-align: right; }
.opt-mini { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px 16px; margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--g200); font-size: 11.5px; }
.opt-mini > div { display: flex; justify-content: space-between; gap: 8px; }
.opt-mini .mlbl { color: var(--g500); }
.opt-mini .mval { font-weight: 600; color: var(--g800); font-variant-numeric: tabular-nums; }
.opt-mini .mval.bind-dti { color: var(--blue); }
.opt-mini .mval.bind-cash { color: var(--gold); }
/* Explainer */
.opt-explainer { background: var(--blue-xlt); border: 1px solid var(--blue-lt); border-radius: 6px; padding: 10px 12px; font-size: 12.5px; line-height: 1.55; color: var(--g700); }
.opt-explainer.warn { background: var(--red-bg); border-color: var(--red-bd); color: #7f1d1d; }
.opt-explainer.ok { background: var(--green-bg); border-color: var(--green-bd); color: #14532d; }
/* .opt-explainer's contents are set via innerHTML at runtime — the <strong> inside stays :global(). */
:global(.opt-explainer strong) { color: inherit; }
/* Comparison table — fully static markup (only textContent is updated), no :global() needed. */
.opt-comp { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.opt-comp th, .opt-comp td { padding: 6px 8px; text-align: right; font-variant-numeric: tabular-nums; border-bottom: 1px solid var(--g100); }
.opt-comp th:first-child, .opt-comp td:first-child { text-align: left; color: var(--g600); font-weight: 500; }
.opt-comp thead th { font-size: 10px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: 0.6px; border-bottom: 1px solid var(--g300); padding-bottom: 7px; }
.opt-comp .col-opt { background: rgba(245,158,11,.07); font-weight: 600; color: var(--g900); }
.opt-comp thead .col-opt { color: var(--gold); }
/* Sensitivity — thead is static; tbody rows are built via createElement at runtime. */
.opt-sens { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.opt-sens th { font-size: 10px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: 0.6px; text-align: left; border-bottom: 1px solid var(--g300); padding: 5px 8px; }
.opt-sens th.r { text-align: right; font-variant-numeric: tabular-nums; }
:global(.opt-sens td) { padding: 5px 8px; border-bottom: 1px solid var(--g100); }
:global(.opt-sens td.r) { text-align: right; font-variant-numeric: tabular-nums; }
:global(.opt-sens td.delta-pos) { color: var(--green); font-weight: 600; }
:global(.opt-sens td.delta-neg) { color: var(--red); font-weight: 600; }
:global(.opt-sens td.delta-zero) { color: var(--g400); }
.opt-notice { padding: 22px 20px; text-align: center; font-size: 13px; color: var(--g600); line-height: 1.55; }
.opt-notice strong { display: block; color: var(--red); font-size: 14px; margin-bottom: 5px; }
/* ===== AFFORD-TARGET VIEW ===== */
.aft-card { background: #fff; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
.aft-card[hidden] { display: none; }
.aft-target-row { background: var(--navy); padding: 14px 17px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.aft-target-row .lbl { font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; color: var(--gold); white-space: nowrap; }
.aft-target-row .tgt-wrap { flex: 1; min-width: 130px; border: 1px solid #2a4a6e; background: #142240; }
.aft-target-row .tgt-wrap .px { background: #1e3554; border-right-color: #2a4a6e; color: #c0d8f0; }
.aft-target-row .tgt-wrap input { color: #fff; font-weight: 700; }
.aft-target-row .tgt-wrap:focus-within { border-color: var(--gold); box-shadow: 0 0 0 2px rgba(245,158,11,.3); }
.aft-prompt { padding: 28px 22px; text-align: center; font-size: 13px; color: var(--g600); line-height: 1.6; }
.aft-prompt strong { display: block; color: var(--g800); font-size: 15px; margin-bottom: 6px; }
.aft-success { padding: 22px 20px; text-align: center; background: var(--green-bg); border-bottom: 1px solid var(--green-bd); }
.aft-success .ok-icon { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: var(--green); color: #fff; font-size: 20px; font-weight: 700; margin-bottom: 10px; }
.aft-success-title { font-size: 16px; font-weight: 700; color: #14532d; margin-bottom: 4px; }
.aft-success-sub { font-size: 12.5px; color: #166534; }
.aft-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; padding: 13px 17px; background: var(--g50); border-bottom: 1px solid var(--border); }
.aft-summary > div { padding: 0 8px; border-right: 1px solid var(--g200); }
.aft-summary > div:last-child { border-right: none; }
.aft-sum-lbl { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--g500); margin-bottom: 3px; }
.aft-sum-val { font-size: 16px; font-weight: 700; color: var(--g900); font-variant-numeric: tabular-nums; }
.aft-sum-val.neg { color: var(--red); }
.aft-body { padding: 14px 17px 18px; }
.aft-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 11px; margin-bottom: 18px; }
.aft-lever { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px; display: flex; flex-direction: column; }
.aft-lever-title { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.9px; color: var(--g500); margin-bottom: 6px; display: flex; align-items: center; gap: 6px; }
.aft-lever-title .badge { font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 10px; background: var(--g200); color: var(--g600); letter-spacing: 0.4px; }
.aft-lever-title .badge.ok   { background: var(--green-bg); color: #14532d; }
.aft-lever-title .badge.warn { background: var(--red-bg);   color: #7f1d1d; }
.aft-lever-title .badge.info { background: var(--blue-xlt); color: #1d4ed8; }
.aft-lever-big { font-size: 20px; font-weight: 800; font-variant-numeric: tabular-nums; color: var(--g900); letter-spacing: -0.5px; line-height: 1.1; margin-bottom: 4px; }
.aft-lever-big.ok  { color: var(--green); }
.aft-lever-big.neg { color: var(--red); }
.aft-lever-sub { font-size: 11.5px; color: var(--g600); line-height: 1.45; }
/* .aft-lever-sub's contents are set via innerHTML at runtime — the <strong> inside stays :global(). */
:global(.aft-lever-sub strong) { color: var(--g800); }
.aft-lever-extra { margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--g200); font-size: 11.5px; color: var(--g600); display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.aft-lever-extra .iw { flex: 0 0 auto; border-color: var(--g200); }
.aft-lever-extra .iw input { padding: 4px 7px; font-size: 12px; width: 70px; }
/* DP feasibility range bar */
.aft-range { margin-top: 6px; position: relative; height: 22px; background: var(--g100); border-radius: 4px; overflow: hidden; }
.aft-range-zone { position: absolute; top: 0; bottom: 0; background: linear-gradient(180deg, rgba(22,163,74,.22), rgba(22,163,74,.32)); border-left: 2px solid var(--green); border-right: 2px solid var(--green); }
.aft-range-zone.fail { background: linear-gradient(180deg, rgba(220,38,38,.18), rgba(220,38,38,.28)); border-color: var(--red); }
.aft-range-marker { position: absolute; top: -2px; bottom: -2px; width: 2px; background: var(--g600); }
.aft-range-marker.boardmin { background: var(--red); }
.aft-range-marker.dti   { background: var(--blue); }
.aft-range-marker.cash  { background: var(--gold); }
.aft-range-axis { display: flex; justify-content: space-between; margin-top: 3px; font-size: 10px; color: var(--g400); font-variant-numeric: tabular-nums; }
.aft-range-legend { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 6px; font-size: 11px; color: var(--g600); }
.aft-range-legend span { display: inline-flex; align-items: center; gap: 4px; }
.aft-range-legend i { display: inline-block; width: 10px; height: 2px; vertical-align: middle; font-style: normal; }
/* Combined gap grid */
.aft-section-title { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.9px; color: var(--g400); margin-bottom: 8px; }
.aft-grid-wrap { overflow-x: auto; margin: 0 -2px; }
/* <table id="aft-gap-grid"> itself is a static element, but its thead/tbody rows are all
   built via createElement at runtime each render — every descendant selector stays :global(). */
.aft-gap-table { width: 100%; border-collapse: separate; border-spacing: 3px; font-size: 12px; font-variant-numeric: tabular-nums; }
:global(.aft-gap-table th) { font-size: 10px; font-weight: 700; color: var(--g500); text-transform: uppercase; letter-spacing: 0.4px; padding: 4px 6px; text-align: center; white-space: nowrap; }
