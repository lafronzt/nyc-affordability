---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ChangeEntry from '../../../components/ChangeEntry.astro';
import Byline from '../../../components/Byline.astro';
import type { FooterColumn } from '../../../lib/footerLinks';
import { ALL_CALCULATORS, ALL_GUIDES, EXPLORE_LINKS, STANDARD_ABOUT_COLUMN } from '../../../lib/footerLinks';
import { buildBreadcrumbJsonLd } from '../../../lib/breadcrumbs';
import { SITE_CHANGES } from '../../../data/siteChanges';

/* Reader-facing record of changes that could move a number someone relied
   on. Data: src/data/siteChanges.ts (rules in its header comment). */

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: ALL_CALCULATORS },
  { heading: 'Guides', links: ALL_GUIDES },
  { heading: 'Explore', links: EXPLORE_LINKS },
  STANDARD_ABOUT_COLUMN,
];

const latest = SITE_CHANGES[0].date;
const COUNT_LABEL = { correction: ['correction', 'corrections'], data: ['data update', 'data updates'], method: ['method change', 'method changes'], feature: ['new feature', 'new features'] } as const;
const counts = (['correction', 'data', 'method', 'feature'] as const)
  .map((k) => ({ k, n: SITE_CHANGES.filter((c) => c.kind === k).length }))
  .filter((x) => x.n > 0)
  .map((x) => `${x.n} ${COUNT_LABEL[x.k][x.n === 1 ? 0 : 1]}`);

const SITE_ORIGIN = 'https://www.nyc-affordability.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Changelog | NYC Affordability',
  url: `${SITE_ORIGIN}/methodology/changelog/`,
  description: 'Every change to NYC Affordability that could move a number: corrections, data updates, and method changes, with dates and links to the code.',
  dateModified: latest,
  isPartOf: { '@type': 'WebSite', name: 'NYC Affordability', url: `${SITE_ORIGIN}/` },
};
const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Methodology', path: '/methodology/' },
  { name: 'Changelog', path: '/methodology/changelog/' },
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---
<BaseLayout
  variant="site"
  pageTitle="Changelog: Corrections, Data Updates & Method Changes | NYC Affordability"
  metaDescription="Every change to NYC Affordability that could move a number you relied on: corrections, data updates like the default mortgage rate, and changes to the method, each dated and linked to the code."
  canonicalPath="/methodology/changelog/"
  ogTitle="NYC Affordability Changelog"
  ogDescription="Corrections, data updates, and method changes, each dated and linked to the code."
  ogImage="/images/general-og.png"
  ogImageAlt="NYC Affordability calculators for rent, co-op, and condo housing."
  twitterTitle="NYC Affordability Changelog"
  twitterDescription="Corrections, data updates, and method changes, each dated and linked to the code."
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
<SiteHeader />

<main>
<div class="hero">
  <div class="hero-eyebrow">Methodology</div>
  <h2>Changelog</h2>
  <p>If a number on this site changed, it's here: what moved, when, and why. Newest first.</p>
</div>

<div class="page">
  <Breadcrumbs items={breadcrumbItems} />

  <div class="card">
    <p class="lede">This covers changes that could move a figure you used: <strong>corrections</strong> (we had something wrong), <strong>data updates</strong> (a source published new numbers), and <strong>method</strong> changes (how something is calculated). New pages and design changes aren't listed. Mistakes also get their own page, <a href="/methodology/corrections/">Corrections</a>, with what was wrong and what's right.</p>
    <p class="filters">{counts.map((c) => <span>{c}</span>)}</p>
    <p class="filters">The full engineering history, every commit, is on <a href="https://github.com/lafronzt/nyc-affordability/commits/main" target="_blank" rel="noopener noreferrer">GitHub ↗</a>.</p>
  </div>

  <section class="card" aria-label="Changes, newest first">
    {SITE_CHANGES.map((c) => <ChangeEntry change={c} />)}
    <Byline path="/methodology/changelog/" updated={latest} />
  </section>
</div>
</main>

<Footer
  variant="site"
  disclaimer="NYC Affordability is for informational purposes only and does not constitute financial, legal, tax, or mortgage advice. Always verify figures with a licensed mortgage professional and a real estate attorney before making a housing decision."
  columns={footerColumns}
/>
</BaseLayout>

<style>
.hero {
  background: linear-gradient(160deg, var(--navy) 0%, #0d1f3c 55%, #142240 100%);
  padding: 52px 24px 44px; text-align: center; color: #e2e8f0;
}
.hero-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
.hero h2 { font-size: clamp(26px, 4.5vw, 40px); font-weight: 800; letter-spacing: -1px; line-height: 1.15; margin-bottom: 14px; color: #f0f9ff; }
.hero p { font-size: 15px; color: #93b4d0; max-width: 640px; margin: 0 auto; line-height: 1.7; }

.page { max-width: 820px; margin: 0 auto; padding: 44px 24px 64px; flex: 1; }

.card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 28px 28px 30px; margin-bottom: 20px;
}
.card h3 { font-size: 17px; font-weight: 800; color: var(--g900); margin-bottom: 10px; letter-spacing: -.2px; }
.card p { font-size: 14.5px; color: var(--g600); line-height: 1.75; margin-bottom: 10px; }
.card ul { padding-left: 20px; margin: 0 0 10px; }
.card li { font-size: 14.5px; color: var(--g700); line-height: 1.7; margin-bottom: 6px; }
.card a { color: var(--blue); text-decoration: none; }
.card a:hover { text-decoration: underline; }

.lede { font-size: 14.5px; }
.filters { display: flex; flex-wrap: wrap; gap: 8px 14px; font-size: 13px; color: var(--g500); margin: 0 0 6px; }

@media (max-width: 560px) {
  .page { padding: 28px 16px 48px; }
  .card { padding: 22px 18px 24px; }
}
</style>
