---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import type { FooterColumn } from '../../lib/footerLinks';
import { ALL_CALCULATORS, ALL_GUIDES, STANDARD_ABOUT_COLUMN, EXPLORE_LINKS } from '../../lib/footerLinks';
import { AD_IN_ARTICLE } from '../../lib/adSlots';
import { buildBreadcrumbJsonLd } from '../../lib/breadcrumbs';
import { fmtMoney } from '../../lib/format';
import { requiredIncomeForRent, requiredIncomeForPrice } from '../../lib/afford';
import { firstOf, firstRent, isRent, type MarketFigure } from '../../lib/marketFigures';
import { BOROUGH_HUBS, type BoroughHub } from '../../data/boroughs';

export function getStaticPaths() {
  return BOROUGH_HUBS.map((hub) => ({ params: { borough: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props as { hub: BoroughHub };

const footerColumns: FooterColumn[] = [
  { heading: 'Calculators', links: ALL_CALCULATORS },
  { heading: 'Guides', links: ALL_GUIDES },
  { heading: 'Explore', links: EXPLORE_LINKS },
  STANDARD_ABOUT_COLUMN,
];

const rent = firstRent(hub.figures);
const sales = hub.figures.filter((f) => f.metric === 'median-sale-price');
const sale = sales[0];
// Use a property-type median when the source publishes one; otherwise the blended median.
const coopSale = sales.find((f) => f.propertyScope === 'coop') ?? sale;
const condoSale = sales.find((f) => f.propertyScope === 'condo') ?? sale;
const rentIncome = rent ? requiredIncomeForRent({ targetRent: rent.value }).annualIncomeNeeded : null;
const coopIncome = coopSale ? requiredIncomeForPrice({ targetPrice: coopSale.value, propertyType: 'coop' }).annualIncomeNeeded : null;
const condoIncome = condoSale ? requiredIncomeForPrice({ targetPrice: condoSale.value, propertyType: 'condo' }).annualIncomeNeeded : null;
const atLabel = (f: MarketFigure | undefined, type: 'co-op' | 'condo') =>
  f && f.propertyScope !== 'coop+condo' && f.propertyScope !== 'all' ? `at the ${type} median (${fmtMoney(f.value)})` : `at the median (${fmtMoney(f!.value)})`;

const hoods = (await getCollection('neighborhoods', ({ data }) => !data.draft && data.borough === hub.slug))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const hoodRent = (figures: MarketFigure[]) => firstRent(figures);

const canonicalPath = `/${hub.slug}/`;
const title = `Can I Afford ${hub.name}? Rent, Prices & Income Needed | NYC Affordability`;
const updatedLabel = new Date(`${hub.updated}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const SITE_ORIGIN = 'https://www.nyc-affordability.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Can I afford ${hub.name}?`,
  description: hub.metaDescription,
  url: `${SITE_ORIGIN}${canonicalPath}`,
  dateModified: hub.updated,
  isPartOf: { '@type': 'WebSite', name: 'NYC Affordability', url: `${SITE_ORIGIN}/` },
};
const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Neighborhoods', path: '/neighborhoods/' },
  { name: hub.name, path: canonicalPath },
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
const cards: { kind: 'rent' | 'sale'; figure: MarketFigure | undefined }[] = [
  { kind: 'rent', figure: rent },
  ...(sales.length ? sales.map((figure) => ({ kind: 'sale' as const, figure })) : [{ kind: 'sale' as const, figure: undefined }]),
];
---
<BaseLayout
  variant="site"
  ads
  pageTitle={title}
  metaDescription={hub.metaDescription}
  canonicalPath={canonicalPath}
  ogTitle={`Can I afford ${hub.name}?`}
  ogDescription={hub.metaDescription}
  ogImage="/images/neighborhoods-og.png"
  ogImageAlt="Where can you afford to live? Explore NYC neighborhood housing costs."
  twitterTitle={`Can I afford ${hub.name}?`}
  twitterDescription={hub.metaDescription}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
<SiteHeader />

<main>
<div class="hero">
  <div class="hero-eyebrow">Borough guide</div>
  <h2>Can I afford {hub.name}?</h2>
  <p>{hub.intro}</p>
  <span class="updated">Page last checked: {updatedLabel}</span>
</div>

<div class="page">
  <Breadcrumbs items={breadcrumbItems} />

  <div class="stat-grid">
    {cards.map(({ kind, figure }) => figure ? (
      <div class="stat-card">
        <div class="stat-label">{figure.label}</div>
        <div class="stat-value">{fmtMoney(figure.value)}{isRent(figure) && <span class="stat-unit">/mo</span>}</div>
        <div class="stat-scope">All of {hub.name}</div>
        <div class="stat-asof">As of {figure.period} · <a href={figure.sourceUrl} target="_blank" rel="noopener noreferrer">{figure.source.split(':')[0]}</a></div>
      </div>
    ) : (
      <div class="stat-card">
        <div class="stat-label">{kind === 'rent' ? `${hub.name} rent` : `${hub.name} sale price`}</div>
        <div class="stat-value stat-value--none">Not yet tracked</div>
        <div class="stat-asof">No borough-wide figure from a stable, dated source yet</div>
      </div>
    ))}
  </div>
  <p class="data-note">Cited figures; see Sources below. These are market data points, not calculated by this site.</p>

  <div class="card guide-body">
    <h2>What these numbers cover</h2>
    {hub.notes.map((n) => <p>{n}</p>)}
  </div>

  <div class="card calc-card">
    <h3>What it takes to live here</h3>
    <p class="calc-disclaimer">These are <strong>calculated</strong>, not cited: the figures above run through this site's calculator assumptions (40× rent rule, co-op and condo DTI limits), with no other monthly debts and no check against your savings.</p>
    <table>
      <tbody>
        {rentIncome !== null && (
          <tr><td>Rent at the {rent!.metric === 'average-rent' ? 'average' : 'median'} (<a href="/rent/">Rent Calculator</a>)</td><td>{fmtMoney(rentIncome)}/yr income needed</td></tr>
        )}
        {coopIncome !== null && (
          <tr><td>Buy a co-op {atLabel(coopSale, 'co-op')} (<a href="/coop/">Co-op Calculator</a>)</td><td>{fmtMoney(coopIncome)}/yr income needed</td></tr>
        )}
        {condoIncome !== null && (
          <tr><td>Buy a condo {atLabel(condoSale, 'condo')} (<a href="/condo/">Condo Calculator</a>)</td><td>{fmtMoney(condoIncome)}/yr income needed</td></tr>
        )}
      </tbody>
    </table>
  </div>

  {hoods.length > 0 && (
    <div class="card">
      <h3>{hub.name} neighborhoods</h3>
      <ul class="hood-list">
        {hoods.map((h) => {
          const r = hoodRent(h.data.figures);
          return (
            <li><a href={`/neighborhoods/${h.id}/`}>{h.data.name}{r && <span>{r.metric === 'average-rent' ? 'Avg' : 'Median'} rent {fmtMoney(r.value)}/mo · {r.period}</span>}</a></li>
          );
        })}
      </ul>
    </div>
  )}

  <div style="margin-bottom:20px;">
    <AdSlot slot={AD_IN_ARTICLE} format="in-article" maxWidth="100%" sidePadding="0" />
  </div>

  <div class="card">
    <h3>Run your own numbers</h3>
    <p><a href="/reality-check/">Start with the Reality Check</a> to see what's in reach on your income and savings, or go straight to <a href="/rent/">renting</a>, <a href="/coop/">a co-op</a>, or <a href="/condo/">a condo</a>. Moving soon? <a href="/cost-to-move/">Add up the move-in cash</a>.</p>
  </div>

  <div class="card">
    <h3>Sources</h3>
    <ul>
      {hub.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
    </ul>
    <p class="sources-note">Market data changes constantly. Check the source before relying on a figure for a real decision.</p>
  </div>
</div>
</main>

<Footer
  variant="site"
  disclaimer="Rent and sale figures are sourced market data, cited above, not calculated by this site. Affordability figures are calculated using default assumptions and don't reflect your accounts, debts, or a specific building's finances. For informational purposes only; not financial, legal, or mortgage advice."
  columns={footerColumns}
/>
</BaseLayout>

<style>
.hero {
  background: linear-gradient(160deg, var(--navy) 0%, #0d1f3c 55%, #142240 100%);
  padding: 52px 24px 44px; text-align: center; color: #e2e8f0;
}
.hero-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
.hero h2 { font-size: clamp(26px, 4.5vw, 40px); font-weight: 800; letter-spacing: -1px; line-height: 1.15; margin-bottom: 14px; color: #f0f9ff; }
.hero p { font-size: 15px; color: #93b4d0; max-width: 640px; margin: 0 auto; line-height: 1.7; }
.hero .updated { display: inline-block; margin-top: 16px; font-size: 11px; color: #6b8ab8; letter-spacing: .4px; }

.page { max-width: 820px; margin: 0 auto; padding: 44px 24px 64px; flex: 1; }

.stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 8px; }
.stat-card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 18px 20px; text-align: center;
}
.stat-label { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--g500); margin-bottom: 8px; }
.stat-value { font-size: 26px; font-weight: 800; color: var(--g900); letter-spacing: -.5px; }
.stat-asof { font-size: 11px; color: var(--g500); margin-top: 8px; }
.stat-asof a { color: inherit; }
.stat-scope { display: inline-block; font-size: 11px; font-weight: 700; color: #0f6b4a; background: #e6f6ef; border-radius: 10px; padding: 2px 9px; margin-top: 8px; }
.stat-scope--wide { color: #7a5200; background: #fdf3dc; }
.stat-unit { font-size: 14px; font-weight: 600; color: var(--g500); }
.stat-value--none { font-size: 18px; color: var(--g500); }
.hood-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; list-style: none; padding: 0 !important; }
.hood-list li { margin: 0; }
.hood-list a { display: block; border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; font-weight: 700; color: var(--g900) !important; }
.hood-list a:hover { border-color: var(--blue-lt); background: var(--blue-xlt); text-decoration: none !important; }
.hood-list span { display: block; font-size: 12.5px; font-weight: 500; color: var(--g500); margin-top: 2px; }
.data-note { font-size: 12px; color: var(--g500); text-align: center; margin-bottom: 20px; }

.card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 28px 28px 30px; margin-bottom: 20px;
}
.card h3 { font-size: 17px; font-weight: 800; color: var(--g900); margin-bottom: 10px; letter-spacing: -.2px; }
.card p { font-size: 14px; color: var(--g600); line-height: 1.75; margin-bottom: 10px; }
.card p:last-child { margin-bottom: 0; }
.card ul, .card ol { padding-left: 20px; color: var(--g600); font-size: 14px; line-height: 1.75; margin-bottom: 10px; }
.card li { margin-bottom: 4px; }
.card a { color: var(--blue); text-decoration: none; }
.card a:hover { text-decoration: underline; }

.guide-body { background: var(--blue-xlt); border-color: var(--blue-lt); }
.calc-card { background: var(--blue-xlt); border-color: var(--blue-lt); }
.calc-disclaimer { font-size: 12.5px; color: var(--g700); }
.calc-card table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-top: 8px; }
.calc-card td { padding: 9px 0; border-bottom: 1px solid rgba(37,99,235,.15); color: var(--g800); }
.calc-card tr:last-child td { border-bottom: none; }
.calc-card td:last-child { text-align: right; font-weight: 700; }

.sources-note { font-size: 12px; color: var(--g500); margin-top: 10px; }

.guide-body :global(h2) {
  font-size: 17px; font-weight: 800; color: var(--g900);
  letter-spacing: -.2px; margin-bottom: 10px; margin-top: 24px;
}
.guide-body :global(h2:first-child) { margin-top: 0; }
.guide-body :global(p) { font-size: 14px; color: var(--g600); line-height: 1.75; margin-bottom: 10px; }
.guide-body :global(ul), .guide-body :global(ol) { padding-left: 20px; color: var(--g600); font-size: 14px; line-height: 1.75; margin-bottom: 10px; }
.guide-body :global(li) { margin-bottom: 4px; }
.guide-body :global(a) { color: var(--blue); text-decoration: none; }
.guide-body :global(a:hover) { text-decoration: underline; }

@media (max-width: 560px) {
  .stat-grid { grid-template-columns: 1fr; }
  .hood-list { grid-template-columns: 1fr; }
  .card { padding: 22px 18px 24px; }
}
</style>
