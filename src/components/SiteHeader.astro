---
interface Props {
  backLink?: boolean;
}
const { backLink = false } = Astro.props;
---
<header class={`site-header${backLink ? ' site-header--with-back' : ''}`}>
  <h1>NYC <em>Affordability</em></h1>
  {backLink && <a class="back-link" href="/">&larr; Back to Hub</a>}
</header>

<style>
.site-header {
  background: var(--navy);
  padding: 0 24px;
  border-bottom: 2px solid #1e3a5f;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56px;
}
.site-header--with-back {
  justify-content: space-between;
}
.site-header h1 {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.3px;
  color: #e2e8f0;
}
.site-header h1 em { font-style: normal; color: var(--gold); }
.site-header a.back-link { color: #8aabcf; text-decoration: none; font-size: 12px; font-weight: 600; }
.site-header a.back-link:hover { color: #e2e8f0; text-decoration: underline; }
</style>
