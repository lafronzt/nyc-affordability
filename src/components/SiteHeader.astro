---
import NavLinks from './NavLinks.astro';
---
<header class="site-header">
  <h1>NYC <em>Affordability</em></h1>
  <NavLinks />
</header>

<style>
.site-header {
  background: var(--navy);
  padding: 0 24px;
  border-bottom: 2px solid #1e3a5f;
  display: flex;
  align-items: center;
  gap: 14px;
  position: sticky;
  top: 0;
  z-index: 200;
  min-height: var(--header-h);
}
.site-header h1 {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.3px;
  color: #e2e8f0;
  white-space: nowrap;
  flex-shrink: 0;
}
.site-header h1 em { font-style: normal; color: var(--gold); }
</style>
