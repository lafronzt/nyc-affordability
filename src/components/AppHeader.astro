---
import NavLinks from './NavLinks.astro';

interface Props {
  titleHtml: string;
  tagline?: string;
  showSaveToggle?: boolean;
}
const { titleHtml, tagline, showSaveToggle = true } = Astro.props;
---
<header class="app-header">
  <h1 set:html={titleHtml} />
  <NavLinks showSaveToggle={showSaveToggle} />
</header>
{tagline && <p class="page-tagline">{tagline}</p>}

<style>
.app-header {
  background: var(--navy);
  padding: 0 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  border-bottom: 2px solid #1e3a5f;
  position: sticky;
  top: 0;
  z-index: 200;
  min-height: var(--header-h);
}
.app-header h1 {
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.2px;
  color: #e2e8f0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
  flex-shrink: 1;
}
.app-header h1 :global(em) { font-style: normal; color: var(--gold); }

.page-tagline {
  background: #fff;
  border-bottom: 1px solid var(--border);
  padding: 10px 24px;
  font-size: 13px;
  color: var(--g600);
  line-height: 1.4;
}
</style>
