---
interface Props {
  titleHtml: string;
  tagline: string;
  showSaveToggle?: boolean;
}
const { titleHtml, tagline, showSaveToggle = true } = Astro.props;
---
<header class="app-header">
  <h1 set:html={titleHtml} />
  <span class="tagline">{tagline}</span>
  {showSaveToggle && (
    <label class="save-toggle" title="Save your inputs to this browser so they persist on your next visit">
      <input type="checkbox" id="save-toggle-cb">
      <span class="toggle-track"><span class="toggle-thumb"></span></span>
      <span class="toggle-label">Save inputs</span>
    </label>
  )}
</header>

<style>
.app-header {
  background: var(--navy);
  padding: 13px 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  border-bottom: 2px solid #1e3a5f;
  position: sticky;
  top: 0;
  z-index: 100;
}
.app-header h1 {
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.2px;
  color: #e2e8f0;
  white-space: nowrap;
}
.app-header h1 :global(em) { font-style: normal; color: var(--gold); }
.app-header .tagline {
  font-size: 12px;
  color: #ffffff;
  line-height: 1.3;
}
.save-toggle {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-left: auto;
  cursor: pointer;
  user-select: none;
  flex-shrink: 0;
}
.save-toggle input[type="checkbox"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}
.toggle-track {
  width: 30px;
  height: 16px;
  background: #2a4a6e;
  border-radius: 8px;
  position: relative;
  transition: background .2s;
  flex-shrink: 0;
}
.toggle-thumb {
  position: absolute;
  left: 2px;
  top: 2px;
  width: 12px;
  height: 12px;
  background: #4a6fa5;
  border-radius: 50%;
  transition: left .2s, background .2s;
}
.save-toggle input:checked + .toggle-track { background: var(--blue); }
.save-toggle input:checked + .toggle-track .toggle-thumb { left: 16px; background: #fff; }
.toggle-label {
  font-size: 11px;
  color: #8aabcf;
  font-weight: 500;
  white-space: nowrap;
}
.save-toggle input:checked ~ .toggle-label { color: #c0d8f0; }
.save-toggle input:focus-visible + .toggle-track {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}
</style>
