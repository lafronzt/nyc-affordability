---
import { AD_CLIENT, AD_DISPLAY_HORIZONTAL } from '../lib/adSlots';
import { ADS_ENABLED } from '../lib/adsConfig';

interface Props {
  slot?: string;
  format?: 'display' | 'in-article' | 'multiplex';
  maxWidth?: string;
  sidePadding?: string;
}
const {
  slot = AD_DISPLAY_HORIZONTAL,
  format = 'display',
  maxWidth = '1120px',
  sidePadding = '24px',
} = Astro.props;

const formatAttrs =
  format === 'in-article'
    ? { 'data-ad-format': 'fluid', 'data-ad-layout': 'in-article' }
    : format === 'multiplex'
      ? { 'data-ad-format': 'autorelaxed' }
      : { 'data-ad-format': 'auto', 'data-full-width-responsive': 'true' };
---
{ADS_ENABLED && (
  <div style={`max-width:${maxWidth};margin:0 auto;padding:8px ${sidePadding} 0;text-align:center;`}>
    <div style="font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#9ca3af;margin-bottom:6px;">Advertisement</div>
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client={AD_CLIENT}
         data-ad-slot={slot}
         {...formatAttrs}></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
