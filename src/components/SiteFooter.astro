---
interface Props {
  disclaimer: string;
}
const { disclaimer } = Astro.props;
---
<footer class="site-footer">
  <div class="footer-inner">
    <slot />
    <p class="footer-disclaimer">{disclaimer}</p>
  </div>
</footer>

<style>
.site-footer {
  background: var(--navy);
  color: #4a6fa5;
  font-size: 12px;
  padding: 28px 24px;
  line-height: 1.7;
  border-top: 2px solid #1e3a5f;
}
.site-footer .footer-inner { max-width: 1120px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 20px 48px; align-items: flex-start; }
.site-footer :global(.footer-col) { flex: 1; min-width: 160px; }
.site-footer :global(.footer-heading) { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #6b8ab8; margin-bottom: 8px; }
.site-footer :global(a) { color: #4a6fa5; text-decoration: none; }
.site-footer :global(a:hover) { color: #e2e8f0; text-decoration: underline; }
.site-footer :global(ul) { list-style: none; padding: 0; margin: 0; }
.footer-disclaimer { width: 100%; border-top: 1px solid #1e3a5f; margin-top: 16px; padding-top: 14px; font-size: 11px; color: rgba(255, 255, 255, .6); }
</style>
