---
/* One entry from src/data/siteChanges.ts, for /methodology/changelog/
   and /methodology/corrections/. */
import { KIND_LABEL, changeId, prUrl, type SiteChange } from '../data/siteChanges';

interface Props { change: SiteChange }
const { change: c } = Astro.props;
const date = new Date(`${c.date}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<article class="entry" id={changeId(c)}>
  <p class="meta"><time datetime={c.date}>{date}</time> <span class={`kind kind--${c.kind}`}>{KIND_LABEL[c.kind]}</span></p>
  <h4>{c.title}</h4>
  <p>{c.summary}</p>
  {c.wrong && <p class="was"><strong>What was wrong:</strong> {c.wrong}</p>}
  {c.right && <p class="now"><strong>What's right now:</strong> {c.right}</p>}
  <p class="foot">
    {c.affects.length > 0 && <>Affected: {c.affects.map((a, i) => <>{i > 0 && ', '}<a href={a}><code>{a}</code></a></>)}</>}
    {c.pr !== null && <>{c.affects.length > 0 && ' · '}<a href={prUrl(c.pr)} target="_blank" rel="noopener noreferrer">The change on GitHub ↗</a></>}
  </p>
</article>

<style>
.entry { padding: 18px 0; border-top: 1px solid var(--border); scroll-margin-top: 80px; }
.entry:first-of-type { border-top: 0; padding-top: 4px; }
.entry:target { background: #fffbeb; box-shadow: 0 0 0 8px #fffbeb; border-radius: 4px; }
.meta { font-size: 12.5px; color: var(--g500); margin: 0 0 4px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
h4 { font-size: 15.5px; font-weight: 800; color: var(--g900); margin: 0 0 6px; line-height: 1.4; }
p { font-size: 14px; color: var(--g600); line-height: 1.7; margin: 0 0 8px; }
.was, .now { padding-left: 10px; border-left: 3px solid var(--border); }
.was { border-left-color: #fca5a5; }
.now { border-left-color: #86efac; }
.foot { font-size: 12.5px; color: var(--g500); margin: 0; overflow-wrap: anywhere; }
a { color: var(--blue); text-decoration: none; }
a:hover { text-decoration: underline; }
code { font-size: 12px; }
.kind { font-size: 10.5px; font-weight: 800; letter-spacing: .3px; border-radius: 999px; padding: 1px 8px; border: 1px solid transparent; }
.kind--correction { background: #fff7ed; color: #9a3412; border-color: #fed7aa; }
.kind--data { background: #ecfeff; color: #155e75; border-color: #a5f3fc; }
.kind--method { background: #f5f3ff; color: #5b21b6; border-color: #ddd6fe; }
.kind--feature { background: #f0fdf4; color: #166534; border-color: #bbf7d0; }
</style>
